local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")

-- 创建悬浮窗
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TestTeamChangeGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = player:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 200, 0, 100)
Frame.Position = UDim2.new(0.5, -100, 0.5, -50)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true -- 允许拖动
Frame.Parent = ScreenGui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 8)
Corner.Parent = Frame

local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(0, 150, 255)
Stroke.Thickness = 2
Stroke.Parent = Frame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 24)
Title.Position = UDim2.new(0, 0, 0, 5)
Title.BackgroundTransparency = 1
Title.Text = "远程更换队伍测试"
Title.TextColor3 = Color3.fromRGB(0, 150, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 12
Title.Parent = Frame

local Button = Instance.new("TextButton")
Button.Size = UDim2.new(0, 180, 0, 45)
Button.Position = UDim2.new(0, 10, 0, 40)
Button.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.Font = Enum.Font.GothamBold
Button.TextSize = 12
Button.Text = "更换警察队伍"
Button.Parent = Frame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 6)
BtnCorner.Parent = Button

-- 防止重复点击
local isRunning = false

Button.MouseButton1Click:Connect(function()
    if isRunning then return end
    isRunning = true
    
    -- 锁定UI防止连点
    Button.Text = "正在执行..."
    Button.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    
    -- 获取最新的角色
    local currentChar = player.Character
    if not currentChar then 
        Button.Text = "角色未加载"
        task.wait(2)
        Button.Text = "更换警察队伍"
        Button.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
        isRunning = false
        return 
    end
    
    local currentRoot = currentChar:FindFirstChild("HumanoidRootPart")
    if not currentRoot then 
        Button.Text = "找不到角色根部"
        task.wait(2)
        Button.Text = "更换警察队伍"
        Button.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
        isRunning = false
        return 
    end

    -- 1. 记录原来的坐标与视角 (使用 CFrame 保存)
    local originalCFrame = currentRoot.CFrame
    print("[测试] 已记录原坐标:", tostring(originalCFrame.Position))

    -- 2. 传送至目标坐标
    currentRoot.CFrame = CFrame.new(3376.82, -337.46, -485.25)
    print("[测试] 已传送至警察局目标点，等待 0.5 秒...")
    task.wait(0.5)

    -- 3. 执行抓包代码
    local success, err = pcall(function()
        local args = {
            [1] = "selectTeam",
            [2] = workspace.Gameplay:FindFirstChild("Police Department")._TeamChangeWithEntrance._Interaction.TeamChange
        }
        game:GetService("ReplicatedStorage").Remote.PlayerFunc:InvokeServer(unpack(args))
    end)
    
    if success then
        print("[测试] 抓包执行成功！")
    else
        warn("[测试] 抓包执行失败: " .. tostring(err))
    end

    -- 4. 等待 5 秒 (由于已经执行了更换队伍，这里等待5秒让你确认是否成功)
    print("[测试] 等待 5 秒后传送回原地...")
    task.wait(2)

    -- 5. 传送回原来的地方
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = originalCFrame
        print("[测试] 已传送回原坐标。")
    end

    -- 恢复按钮状态
    Button.Text = "执行完毕"
    Button.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    task.wait(2)
    Button.Text = "更换警察队伍"
    Button.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
    isRunning = false
end)