local function httpGet(url)
    if type(syn) == "table" and type(syn.request) == "function" then
        local ok, res = pcall(function()
            return syn.request({ Url = url, Method = "GET" })
        end)
        if ok and res and (res.Body or res.body) then return res.Body or res.body end
    end
    if type(http_request) == "function" then
        local ok, res = pcall(function()
            return http_request({ Url = url, Method = "GET" })
        end)
        if ok and res and (res.Body or res.body) then return res.Body or res.body end
    end
    if type(request) == "function" then
        local ok, res = pcall(function()
            return request({ Url = url, Method = "GET" })
        end)
        if ok and res and (res.Body or res.body) then return res.Body or res.body end
    end
    if type(http) == "table" and type(http.request) == "function" then
        local ok, res = pcall(function()
            return http.request({ Url = url, Method = "GET" })
        end)
        if ok and res and (res.Body or res.body) then return res.Body or res.body end
    end
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 0 then return res end
    return nil
end

local function httpGetWithTimeout(url, timeout)
    local result = nil
    local done = false
    task.spawn(function()
        result = httpGet(url)
        done = true
    end)
    local startTime = tick()
    while not done and tick() - startTime < timeout do
        task.wait(0.1)
    end
    if done then return result end
    return nil
end

