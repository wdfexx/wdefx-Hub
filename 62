local minimized = false
local destroyed = false
local function minimize()
    if minimized or destroyed then return end
    minimized = true
    orb.Position = UDim2.new(
        main.Position.X.Scale,
        main.Position.X.Offset + main.AbsoluteSize.X - 75,
        main.Position.Y.Scale,
        main.Position.Y.Offset + main.AbsoluteSize.Y - 75
    )
    orb.Visible = true
    orb.Size = UDim2.fromOffset(0, 0)
    main.Visible = false
    tw(orb, 0.24, {Size = UDim2.fromOffset(58, 58)}, Enum.EasingStyle.Back)
end

local function restore()
    if not minimized or destroyed then return end
    minimized = false
    orb.Visible = false
    main.Visible = true
    main.Size = UDim2.fromOffset(0, 0)
    tw(main, 0.28, {Size = UDim2.fromOffset(width, height)}, Enum.EasingStyle.Back)
end

