    --==================================================
    -- Window state
    --==================================================

    local function minimize()
        if minimized or destroyed then
            return
        end

        minimized = true

        ball.Position = UDim2.new(
            main.Position.X.Scale,
            main.Position.X.Offset + 18,
            main.Position.Y.Scale,
            main.Position.Y.Offset + 18
        )

        ball.Visible = true
        ball.Size = UDim2.fromOffset(0, 0)

        tween(
            ball,
            0.25,
            { Size = UDim2.fromOffset(ballSize, ballSize) },
            Enum.EasingStyle.Back
        )

        tween(
            main,
            0.22,
            { Size = UDim2.fromOffset(0, 0) },
            Enum.EasingStyle.Quart
        )

        task.delay(0.23, function()
            if main.Parent and minimized then
                main.Visible = false
            end
        end)
    end

    local function restore()
        if not minimized or destroyed then
            return
        end

        minimized = false
        ball.Visible = false
        main.Visible = true
        main.Size = UDim2.fromOffset(0, 0)

        tween(
            main,
            0.28,
            { Size = UDim2.fromOffset(width, height) },
            Enum.EasingStyle.Back
        )
    end

    attachDrag(header, main)

    attachDrag(ball, ball, function(moved)
        if not moved then
            restore()
        end
    end)

    minimizeButton.MouseButton1Click:Connect(minimize)
    ball.MouseButton1Click:Connect(restore)

