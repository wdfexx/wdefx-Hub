    local function switchCategory(cat)
        if activeCategory == cat then return end

        for _, c in ipairs(categories) do
            if c == cat then
                c.page.Visible = true
                c.indicator.Visible = true
                tween(c.btn, 0.15, { BackgroundColor3 = Theme.itemBg })
                tween(c.label, 0.15, { TextColor3 = Theme.text })
            else
                c.page.Visible = false
                c.indicator.Visible = false
                tween(c.btn, 0.15, { BackgroundColor3 = Theme.sidebar })
                tween(c.label, 0.15, { TextColor3 = Theme.textDim })
            end
        end
        activeCategory = cat
    end

