--=====================================================
-- 工具
--=====================================================
local U = {}
function U.corner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or T.R); c.Parent = p; return c
end
function U.stroke(p, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color = col or T.Line; s.Thickness = th or 1
    s.Transparency = tr or 0.6; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p; return s
end
function U.grad(p, c1, c2, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(1, c2)})
    g.Rotation = rot or 90; g.Parent = p; return g
end
function U.pad(p, t, r, b, l)
    local pa = Instance.new("UIPadding")
    pa.PaddingTop = UDim.new(0, t or 0); pa.PaddingRight = UDim.new(0, r or 0)
    pa.PaddingBottom = UDim.new(0, b or 0); pa.PaddingLeft = UDim.new(0, l or 0)
    pa.Parent = p; return pa
end
function U.tw(o, t, props, st, d)
    local tw = TweenService:Create(o, TweenInfo.new(t, st or Enum.EasingStyle.Quint, d or Enum.EasingDirection.Out), props)
    tw:Play(); return tw
end
function U.txt(parent, text, size, col, bold, align)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1; l.Text = text
    l.TextColor3 = col or T.Tx; l.TextSize = size or 12
    l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.Parent = parent; return l
end

