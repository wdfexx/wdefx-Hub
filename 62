function Window:AddSlider(tab, config)
    local name = config.Name or "Slider"
    local min = config.Min or 0
    local max = config.Max or 100
    local default = config.Default or min
    local suffix = config.Suffix or ""
    local callback = config.Callback

    local item = Instance.new("Frame")
    item.Size = UDim2.new(1, 0, 0, 58)
    item.BackgroundColor3 = Theme.Glass
    item.BackgroundTransparency = 0.6
    item.BorderSizePixel = 0
    item.ZIndex = 17
    item.Parent = tab.container
    Util.corner(item, 12)
    Util.stroke(item, Color3.fromRGB(255, 255, 255), 1, 0.88)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -90, 0, 20)
    label.Position = UDim2.new(0, 16, 0, 8)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Theme.Text
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 18
    label.Parent = item

    local valueLbl = Instance.new("TextLabel")
    valueLbl.Size = UDim2.new(0, 70, 0, 20)
    valueLbl.Position = UDim2.new(1, -86, 0, 8)
    valueLbl.BackgroundTransparency = 1
    valueLbl.Text = tostring(default) .. suffix
    valueLbl.TextColor3 = Theme.Accent
    valueLbl.TextSize = 12
    valueLbl.Font = Enum.Font.GothamBold
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.ZIndex = 18
    valueLbl.Parent = item

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -32, 0, 5)
    track.Position = UDim2.new(0, 16, 0, 38)
    track.BackgroundColor3 = Color3.fromRGB(40, 44, 60)
    track.BorderSizePixel = 0
    track.ZIndex = 18
    track.Parent = item
    Util.corner(track, 3)

    local fill = Instance.new("Frame")
    local ratio = (default - min) / (max - min)
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 19
    fill.Parent = track
    Util.corner(fill, 3)
    Util.gradient(fill, Theme.Accent, Theme.Accent2, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(ratio, -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 20
    knob.Parent = track
    Util.corner(knob, 7)
    Util.stroke(knob, Theme.Accent, 2, 0)

    local current = default
    local dragging = false

    local function update(input)
        local x = input.Position.X
        local tx = track.AbsolutePosition.X
        local tw = track.AbsoluteSize.X
        local r = math.clamp((x - tx) / tw, 0, 1)
        local v = math.floor(min + (max - min) * r)
        current = v
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, -7, 0.5, -7)
        valueLbl.Text = tostring(v) .. suffix
        if callback then callback(v) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local orig = item.Size
            item.Size = UDim2.new(1, 4, 0, 62)
            Util.tween(item, 0.12, { Size = orig }, Enum.EasingStyle.Back)
            update(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        Set = function(v)
            v = math.clamp(v, min, max)
            current = v
            local r = (v - min) / (max - min)
            fill.Size = UDim2.new(r, 0, 1, 0)
            knob.Position = UDim2.new(r, -7, 0.5, -7)
            valueLbl.Text = tostring(v) .. suffix
        end,
        Get = function() return current end,
    }
end

