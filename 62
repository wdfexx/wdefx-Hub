    if self.customBgImage then
        self.bgImage.ImageTransparency = t
    end
end

--=====================================================
-- 【新增】拖拽缩放逻辑
--=====================================================
function Window:_setupResizeHandles()
    local handleSize = 14
    local handles = {}

    local function makeHandle(pos, cursor, isCorner)
        local h = Instance.new("TextButton")
        h.Size = UDim2.new(0, handleSize, 0, handleSize)
        h.Position = pos
        h.BackgroundColor3 = Theme.Accent
        h.BackgroundTransparency = 0.85
        h.Text = ""
        h.BorderSizePixel = 0
        h.ZIndex = 20
        h.Parent = self.root
        Util.corner(h, isCorner and 4 or 2)

        -- 悬停高亮
        h.MouseEnter:Connect(function()
            Util.tween(h, Theme.AnimFast, { BackgroundTransparency = 0.3 })
        end)
        h.MouseLeave:Connect(function()
            Util.tween(h, Theme.AnimFast, { BackgroundTransparency = 0.85 })
        end)

        table.insert(handles, {btn = h, pos = pos, corner = isCorner})
        return h
    end

    -- 四角手柄
    local brHandle = makeHandle(UDim2.new(1, -handleSize, 1, -handleSize), nil, true)
    local blHandle = makeHandle(UDim2.new(0, 0, 1, -handleSize), nil, true)
    local trHandle = makeHandle(UDim2.new(1, -handleSize, 0, 0), nil, true)

    -- 右边缘
    local rightHandle = Instance.new("TextButton")
    rightHandle.Size = UDim2.new(0, 6, 1, -handleSize * 2)
    rightHandle.Position = UDim2.new(1, -3, 0, handleSize)
    rightHandle.BackgroundColor3 = Theme.Accent
    rightHandle.BackgroundTransparency = 0.9
    rightHandle.Text = ""
    rightHandle.BorderSizePixel = 0
    rightHandle.ZIndex = 20
    rightHandle.Parent = self.root
    Util.corner(rightHandle, 3)

    -- 底边缘
    local bottomHandle = Instance.new("TextButton")
    bottomHandle.Size = UDim2.new(1, -handleSize * 2, 0, 6)
    bottomHandle.Position = UDim2.new(0, handleSize, 1, -3)
    bottomHandle.BackgroundColor3 = Theme.Accent
    bottomHandle.BackgroundTransparency = 0.9
    bottomHandle.Text = ""
    bottomHandle.BorderSizePixel = 0
    bottomHandle.ZIndex = 20
    bottomHandle.Parent = self.root
    Util.corner(bottomHandle, 3)

    -- 缩放状态
    local resizing = false
    local resizeStart = nil
    local startSize = nil
    local startPos = nil
    local resizeMode = "br"

    local function startResize(mode, input)
        resizing = true
        resizeMode = mode
        resizeStart = input.Position
        startSize = Vector2.new(self.root.AbsoluteSize.X, self.root.AbsoluteSize.Y)
        startPos = Vector2.new(self.root.AbsolutePosition.X, self.root.AbsolutePosition.Y)
    end

    -- 绑定各个手柄
    brHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startResize("br", input)
        end
    end)
    blHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startResize("bl", input)
        end
    end)
    trHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startResize("tr", input)
        end
    end)
    rightHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startResize("r", input)
        end
    end)
    bottomHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startResize("b", input)
        end
    end)

    -- 统一处理缩放
    table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
        if not resizing then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local delta = input.Position - resizeStart
        local newW, newH = startSize.X, startSize.Y

        if resizeMode == "br" or resizeMode == "r" then
            newW = math.clamp(startSize.X + delta.X, Theme.MinWidth, Theme.MaxWidth)
        end
        if resizeMode == "br" or resizeMode == "b" then
            newH = math.clamp(startSize.Y + delta.Y, Theme.MinHeight, Theme.MaxHeight)
        end
        if resizeMode == "bl" then
            newW = math.clamp(startSize.X - delta.X, Theme.MinWidth, Theme.MaxWidth)
            newH = math.clamp(startSize.Y + delta.Y, Theme.MinHeight, Theme.MaxHeight)
            self.root.Position = UDim2.new(
                self.root.Position.X.Scale,
                self.root.Position.X.Offset + (startSize.X - newW),
                self.root.Position.Y.Scale,
                self.root.Position.Y.Offset
            )
        end
        if resizeMode == "tr" then
            newW = math.clamp(startSize.X + delta.X, Theme.MinWidth, Theme.MaxWidth)
            newH = math.clamp(startSize.Y - delta.Y, Theme.MinHeight, Theme.MaxHeight)
            self.root.Position = UDim2.new(
                self.root.Position.X.Scale,
                self.root.Position.X.Offset,
                self.root.Position.Y.Scale,
                self.root.Position.Y.Offset + (startSize.Y - newH)
            )
        end

        self.root.Size = UDim2.new(0, newW, 0, newH)
    end))

    table.insert(self.connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end))

    self.resizeHandles = handles
end

--=====================================================
-- 【升级】最小化动画 — 模仿 WindUI 但有差异
-- WindUI: 窗口收缩为点后隐藏
-- 本版: 窗口收缩为标题栏高度，内容淡出，按钮图标变化
--=====================================================
function Window:ToggleMinimize()
    self.minimized = not self.minimized

    if self.minimized then
        -- 收缩到标题栏高度
        Util.tween(self.root, Theme.AnimNormal, {
            Size = UDim2.new(0, self.width, 0, Theme.TitleHeight),
        }, Enum.EasingStyle.Quart)

        -- 内容淡出并隐藏
        self.body.Visible = false

        -- 最小化按钮图标变化
        Util.tween(self.minBtn, Theme.AnimFast, {
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 0.2,
        })

        -- 标题栏居中
        Util.tween(self.titleBar, Theme.AnimNormal, {
            Position = UDim2.new(0, 0, 0, 0),
        })
    else
        -- 恢复
        self.body.Visible = true

        Util.tween(self.root, Theme.AnimNormal, {
            Size = UDim2.new(0, self.width, 0, self.height),
        }, Enum.EasingStyle.Back)

        Util.tween(self.minBtn, Theme.AnimFast, {
            BackgroundColor3 = Color3.fromRGB(50, 52, 65),
            BackgroundTransparency = 0.4,
        })
    end
end

