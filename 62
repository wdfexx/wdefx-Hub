function Window:AddToggle(tab, config)
    local name = config.Name or "Toggle"
    local default = config.Default or false
    local callback = config.Callback

    local item = Instance.new("Frame")
    item.Size = UDim2.new(1, 0, 0, Theme.ItemH)
    item.BackgroundColor3 = Theme.Glass
    item.BackgroundTransparency = 0.6
    item.BorderSizePixel = 0
    item.ZIndex = 17
    item.Parent = tab.container
    Util.corner(item, 12)
    Util.stroke(item, Color3.fromRGB(255, 255, 255), 1, 0.88)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -80, 1, 0)
    label.Position = UDim2.new(0, 16, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Theme.Text
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 18
    label.Parent = item

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 40, 0, 22)
    track.Position = UDim2.new(1, -56, 0.5, -11)
    track.BackgroundColor3 = default and Theme.Accent or Color3.fromRGB(50, 55, 72)
    track.BorderSizePixel = 0
    track.ZIndex = 18
    track.Parent = item
    Util.corner(track, 11)

    if default then
        Util.gradient(track, Theme.Accent, Theme.Accent2, 0)
    end

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = default and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 19
    knob.Parent = track
    Util.corner(knob, 9)

    local clickBtn = Instance.new("TextButton")
    clickBtn.Size = UDim2.new(1, 0, 1, 0)
    clickBtn.BackgroundTransparency = 1
    clickBtn.Text = ""
    clickBtn.ZIndex = 20
    clickBtn.Parent = item

    local state = default
    local trackGrad = nil

    local function refresh()
        Util.tween(track, Theme.Normal, {
            BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(50, 55, 72),
        }, Enum.EasingStyle.Quint)
        Util.tween(knob, Theme.Normal, {
            Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
        }, Enum.EasingStyle.Back)
    end

    clickBtn.MouseButton1Click:Connect(function()
        state = not state

        -- 放大弹动
        local origSize = item.Size
        item.Size = UDim2.new(1, 6, 0, Theme.ItemH + 3)
        Util.tween(item, 0.14, { Size = origSize }, Enum.EasingStyle.Back)

        refresh()
        if callback then callback(state) end
    end)

    item.MouseEnter:Connect(function()
        Util.tween(item, Theme.Fast, { BackgroundTransparency = 0.4 })
    end)
    item.MouseLeave:Connect(function()
        Util.tween(item, Theme.Fast, { BackgroundTransparency = 0.6 })
    end)

    return {
        Set = function(v) state = v; refresh() end,
        Get = function() return state end,
    }
end

