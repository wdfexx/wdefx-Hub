local function makePage(name)
    local page = create("ScrollingFrame", {
        Name = name:gsub("%W", "") .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.purple,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, content)
    create("UIPadding", {
        PaddingLeft = UDim.new(0, 23),
        PaddingRight = UDim.new(0, 23),
        PaddingTop = UDim.new(0, 20),
        PaddingBottom = UDim.new(0, 20),
    }, page)
    create("UIListLayout", {
        Padding = UDim.new(0, 12),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)
    pages[name] = page
    return page
end

local function selectPage(name)
    currentPage = name
    for pageName, page in pairs(pages) do page.Visible = pageName == name end
    for pageName, item in pairs(navButtons) do
        local selected = pageName == name
        tw(item.bg, 0.16, {
            BackgroundColor3 = selected and C.purple2 or C.panel,
            BackgroundTransparency = selected and 0 or 1,
        })
        item.label.TextColor3 = selected and C.text or C.muted
        item.icon.TextColor3 = selected and C.text or C.muted
        item.indicator.Visible = selected
    end
end

