function Window:CreateTab(name)
    local tab = {}

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(30, 32, 42)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.BorderSizePixel = 0
    btn.ZIndex = 7
    btn.Parent = self.sidebar
    Util.corner(btn, 8)

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0.6, 0)
    indicator.Position = UDim2.new(0, 0, 0.5, -indicator.Size.Y.Scale / 2)
    indicator.BackgroundColor3 = Theme.Accent
    indicator.BackgroundTransparency = 1
    indicator.BorderSizePixel = 0
    indicator.ZIndex = 8
    indicator.Parent = btn
    Util.corner(indicator, 2)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Theme.TextDim
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 8
    label.Parent = btn

    local container = Instance.new("ScrollingFrame")
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ScrollBarThickness = 3
    container.ScrollBarImageColor3 = Theme.Accent
    container.CanvasSize = UDim2.new(0, 0, 0, 0)
    container.AutomaticCanvasSize = Enum.AutomaticSize.Y
    container.Visible = false
    container.ZIndex = 7
    container.Parent = self.content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = container

    tab.button = btn
    tab.indicator = indicator
    tab.label = label
    tab.container = container
    tab.window = self
    tab.items = {}

    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.tabs, tab)
    if #self.tabs == 1 then self:SelectTab(tab) end

    return tab
end

function Window:SelectTab(tab)
    for _, t in ipairs(self.tabs) do
        t.container.Visible = false
        Util.tween(t.button, Theme.AnimFast, { BackgroundTransparency = 1 })
        Util.tween(t.indicator, Theme.AnimFast, { BackgroundTransparency = 1 })
        Util.tween(t.label, Theme.AnimFast, { TextColor3 = Theme.TextDim })
    end

    tab.container.Visible = true
    Util.tween(tab.button, Theme.AnimFast, { BackgroundTransparency = 0.6 })
    Util.tween(tab.indicator, Theme.AnimFast, { BackgroundTransparency = 0 })
    Util.tween(tab.label, Theme.AnimFast, { TextColor3 = Theme.Text })

    tab.container.Position = UDim2.new(0, 10, 0, 0)
    Util.tween(tab.container, Theme.AnimNormal, { Position = UDim2.new(0, 0, 0, 0) })

    self.currentTab = tab
end

