    islandText.TextColor3 = Theme.TextColor
    islandText.TextSize = 13
    islandText.Font = Enum.Font.GothamBold
    islandText.TextXAlignment = Enum.TextXAlignment.Center
    islandText.ZIndex = 22
    islandText.Parent = self.island
