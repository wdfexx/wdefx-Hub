local Window = {}
Window.__index = Window

function Window.new(config)
    config = config or {}
    local self = setmetatable({}, Window)

    self.title = config.Title or "LierUI"
    self.subtitle = config.Subtitle or "v2.0"
    self.width = config.Width or Theme.Width
    self.height = config.Height or Theme.Height
    self.tabs = {}
    self.currentTab = nil
    self.minimized = false
    self.connections = {}
    self.customBgImage = config.BackgroundImage or nil
    self.bgImageTransparency = config.BackgroundImageTransparency or 0.3

    self.gui = Instance.new("ScreenGui")
    self.gui.Name = "LierUI_" .. tostring(math.random(1000, 9999))
    self.gui.ResetOnSpawn = false
    self.gui.IgnoreGuiInset = true
    self.gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    self.gui.Parent = PlayerGui

    -- 主容器
    self.root = Instance.new("Frame")
    self.root.Size = UDim2.new(0, self.width, 0, self.height)
    self.root.Position = UDim2.new(0.5, -self.width / 2, 0.5, -self.height / 2)
    self.root.BackgroundColor3 = Theme.Bg
    self.root.BackgroundTransparency = 0.05
    self.root.BorderSizePixel = 0
    self.root.Active = true
    self.root.ClipsDescendants = true
    self.root.Parent = self.gui
    Util.corner(self.root, Theme.Radius)
    Util.stroke(self.root, Theme.Border, 1, 0.4)

    --=====================================================
    -- 【新增】自定义背景图片层
