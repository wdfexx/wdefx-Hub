function Window:AddDropdown(tab, config)
    local name = config.Name or "Dropdown"
    local options = config.Options or {}
    local default = config.Default or options[1]
    local callback = config.Callback

    local item = Instance.new("Frame")
    item.Size = UDim2.new(1, 0, 0, Theme.ItemH)
    item.BackgroundColor3 = Theme.Glass
    item.BackgroundTransparency = 0.6
    item.BorderSizePixel = 0
    item.ZIndex = 17
    item.ClipsDescendants = true
    item.Parent = tab.container
    Util.corner(item, 12)
    Util.stroke(item, Color3.fromRGB(255, 255, 255), 1, 0.88)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -110, 1, 0)
    label.Position = UDim2.new(0, 16, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Theme.Text
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 18
    label.Parent = item

    local currentLbl = Instance.new("TextLabel")
    currentLbl.Size = UDim2.new(0, 80, 1, 0)
    currentLbl.Position = UDim2.new(1, -96, 0, 0)
    currentLbl.BackgroundTransparency = 1
    currentLbl.Text = tostring(default) .. "  ▾"
    currentLbl.TextColor3 = Theme.Accent
    currentLbl.TextSize = 11
    currentLbl.Font = Enum.Font.GothamBold
    currentLbl.TextXAlignment = Enum.TextXAlignment.Right
    currentLbl.ZIndex = 18
    currentLbl.Parent = item

    -- 选项容器
    local optionsContainer = Instance.new("Frame")
    optionsContainer.Size = UDim2.new(1, 0, 0, 0)
    optionsContainer.Position = UDim2.new(0, 0, 1, 0)
    optionsContainer.BackgroundTransparency = 1
    optionsContainer.ZIndex = 18
    optionsContainer.Parent = item

    local optLayout = Instance.new("UIListLayout")
    optLayout.Padding = UDim.new(0, 2)
    optLayout.SortOrder = Enum.SortOrder.LayoutOrder
    optLayout.Parent = optionsContainer

    local expanded = false
    local current = default

    local function buildOptions()
        for _, child in ipairs(optionsContainer:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for i, opt in ipairs(options) do
            local ob = Instance.new("TextButton")
            ob.Size = UDim2.new(1, 0, 0, 28)
            ob.BackgroundColor3 = Theme.GlassLight
            ob.BackgroundTransparency = 0.5
            ob.Text = "    " .. tostring(opt)
            ob.TextColor3 = Theme.Text
            ob.TextSize = 11
            ob.Font = Enum.Font.Gotham
            ob.TextXAlignment = Enum.TextXAlignment.Left
            ob.BorderSizePixel = 0
            ob.ZIndex = 19
            ob.Parent = optionsContainer
            Util.corner(ob, 6)
            ob.MouseButton1Click:Connect(function()
                current = opt
                currentLbl.Text = tostring(opt) .. "  ▾"
                if callback then callback(opt) end
                -- 收起
                expanded = false
                Util.tween(item, Theme.Normal, { Size = UDim2.new(1, 0, 0, Theme.ItemH) })
            end)
        end
    end

    buildOptions()

    local clickBtn = Instance.new("TextButton")
    clickBtn.Size = UDim2.new(1, 0, 0, Theme.ItemH)
    clickBtn.BackgroundTransparency = 1
    clickBtn.Text = ""
    clickBtn.ZIndex = 20
    clickBtn.Parent = item

    clickBtn.MouseButton1Click:Connect(function()
        expanded = not expanded
        if expanded then
            local h = Theme.ItemH + #options * 30 + 6
            Util.tween(item, Theme.Normal, { Size = UDim2.new(1, 0, 0, h) }, Enum.EasingStyle.Quart)
            optionsContainer.Position = UDim2.new(0, 8, 0, Theme.ItemH)
            optionsContainer.Size = UDim2.new(1, -16, 0, #options * 30)
        else
            Util.tween(item, Theme.Normal, { Size = UDim2.new(1, 0, 0, Theme.ItemH) }, Enum.EasingStyle.Quart)
        end
    end)

    return {
        Get = function() return current end,
        Set = function(v)
            current = v
            currentLbl.Text = tostring(v) .. "  ▾"
        end,
    }
end

