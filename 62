    -- Slider: 行透明, 轨道保留
    local function addSlider(cat, cfg)
        cfg = cfg or {}
        local minV = cfg.Min or 0
        local maxV = cfg.Max or 100
        local val = cfg.Default or minV
        local step = cfg.Step or 1
        local row = new("Frame", {
            Size = UDim2.new(1, 0, 0, 50),
            BackgroundTransparency = CONTROL_BG_TRANSPARENCY,
            BorderSizePixel = 0,
            LayoutOrder = nextOrderIn(cat), ZIndex = 4,
        }, cat.page)
        corner(6, row)
        new("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 1, Transparency = 0.2 }, row)

        local label = new("TextLabel", {
            Size = UDim2.new(1, -20, 0, 16), Position = UDim2.new(0, 14, 0, 6),
            BackgroundTransparency = 1,
            Text = (cfg.Text or "Slider") .. ": " .. val,
            TextColor3 = Theme.text, TextXAlignment = Enum.TextXAlignment.Left,
            Font = Theme.fontMed, TextSize = 11, ZIndex = 5,
        }, row)
        outline(label)

        local track = new("Frame", {
            Size = UDim2.new(1, -28, 0, 6), Position = UDim2.new(0, 14, 0, 32),
            BackgroundColor3 = Theme.inputBg,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0, ZIndex = 5,
        }, row)
        corner(3, track)

        local fill = new("Frame", {
            Size = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = Theme.accent, BorderSizePixel = 0, ZIndex = 6,
        }, track)
        corner(3, fill)

        local knob = new("Frame", {
            Size = UDim2.new(0, 14, 0, 14),
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            BackgroundColor3 = Theme.accentBright, BorderSizePixel = 0, ZIndex = 7,
        }, track)
        corner(7, knob)

        local function refresh()
            local t = math.clamp((val - minV) / (maxV - minV), 0, 1)
            fill.Size = UDim2.new(t, 0, 1, 0)
            knob.Position = UDim2.new(t, 0, 0.5, 0)
            label.Text = (cfg.Text or "Slider") .. ": " .. math.floor(val)
        end
        local function setFromX(absX)
            local rel = math.clamp((absX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = minV + rel * (maxV - minV)
            val = math.floor(val / step + 0.5) * step
            refresh()
            if cfg.Callback then pcall(cfg.Callback, val) end
        end
        local ds = false
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                ds = true; setFromX(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not ds then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                ds = false
            end
        end)
        refresh(); refreshPage(cat)
        return {
            Set = function(v) val = math.clamp(v, minV, maxV); refresh()
                if cfg.Callback then pcall(cfg.Callback, val) end end,
            Get = function() return val end, Instance = row,
        }
    end

    -- Input: 全透明背景, 只留边框
    local function addInput(cat, cfg)
        cfg = cfg or {}
        local row = new("Frame", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = CONTROL_BG_TRANSPARENCY,
            BorderSizePixel = 0,
            LayoutOrder = nextOrderIn(cat), ZIndex = 4,
        }, cat.page)
        corner(6, row)
        new("UIStroke", { Color = Theme.textDim, Thickness = 1, Transparency = 0.5 }, row)

        local box = new("TextBox", {
            Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            Text = cfg.Default or "",
            PlaceholderText = cfg.Placeholder or "输入...",
            PlaceholderColor3 = Theme.textMute, TextColor3 = Theme.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Theme.fontMed, TextSize = 12,
            ClearTextOnFocus = false, ZIndex = 5,
        }, row)
        if cfg.Callback then
            box.FocusLost:Connect(function(enter)
                if enter then pcall(cfg.Callback, box.Text) end
            end)
        end
        refreshPage(cat)
        return {
            Set = function(t) box.Text = t end,
            Get = function() return box.Text end, Box = box,
        }
    end

    -- Dropdown: header 透明, 列表保留
    local function addDropdown(cat, cfg)
        cfg = cfg or {}
        local options = cfg.Options or {}
        local current = cfg.Default or (options[1] or "")
        local open = false
        local container = new("Frame", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = 1,
            LayoutOrder = nextOrderIn(cat),
            ClipsDescendants = false, ZIndex = 4,
        }, cat.page)

        local header2 = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = CONTROL_BG_TRANSPARENCY,
            BorderSizePixel = 0,
            Text = "", AutoButtonColor = false, ZIndex = 5,
        }, container)
        corner(6, header2)
        new("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 1, Transparency = 0.2 }, header2)

        local dlabel = new("TextLabel", {
            Size = UDim2.new(1, -90, 1, 0), Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1, Text = cfg.Text or "Dropdown",
            TextColor3 = Theme.textDim, TextXAlignment = Enum.TextXAlignment.Left,
            Font = Theme.fontMed, TextSize = 11, ZIndex = 6,
        }, header2)
        outline(dlabel)

        local curLabel = new("TextLabel", {
            Size = UDim2.new(1, -90, 1, 0), Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1, Text = current,
            TextColor3 = Theme.text, TextXAlignment = Enum.TextXAlignment.Right,
            Font = Theme.fontMed, TextSize = 11, ZIndex = 6,
        }, header2)
        outline(curLabel)

        local arrow = new("TextLabel", {
            Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -26, 0, 0),
            BackgroundTransparency = 1, Text = "▼",
            TextColor3 = Theme.textDim, Font = Theme.fontBold, TextSize = 8, ZIndex = 6,
        }, header2)

        local list = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 0, math.min(#options * 28, 180)),
            Position = UDim2.new(0, 0, 0, 40),
            BackgroundColor3 = Theme.sidebar,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            Visible = false, ZIndex = 20, ScrollBarThickness = 3,
            CanvasSize = UDim2.new(0, 0, 0, 0),
        }, container)
        corner(6, list)
        new("UIStroke", { Color = Theme.accent, Thickness = 1, Transparency = 0.5 }, list)
        local listLayout = new("UIListLayout", {
            Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder,
        }, list)
        new("UIPadding", {
            PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4),
            PaddingRight = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
        }, list)

        local items = {}
        for i, opt in ipairs(options) do
            local it = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundColor3 = (opt == current) and Theme.accentDark or Theme.itemBg,
                BackgroundTransparency = (opt == current) and 0.2 or 0.5,
                BorderSizePixel = 0, Text = tostring(opt),
                TextColor3 = Theme.text, TextXAlignment = Enum.TextXAlignment.Left,
                Font = Theme.fontMed, TextSize = 11, AutoButtonColor = false,
                LayoutOrder = i, ZIndex = 21,
            }, list)
            corner(4, it)
            new("UIPadding", { PaddingLeft = UDim.new(0, 10) }, it)
            items[i] = it
        end
        task.defer(function()
            list.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 8)
        end)

        header2.MouseButton1Click:Connect(function()
            open = not open
            list.Visible = open
            arrow.Text = open and "▲" or "▼"
        end)

        for i, it in ipairs(items) do
            it.MouseButton1Click:Connect(function()
                current = options[i]
                curLabel.Text = current
                for j, other in ipairs(items) do
                    other.BackgroundColor3 = (options[j] == current) and Theme.accentDark or Theme.itemBg
                    other.BackgroundTransparency = (options[j] == current) and 0.2 or 0.5
                end
                open = false; list.Visible = false; arrow.Text = "▼"
                if cfg.Callback then pcall(cfg.Callback, current) end
            end)
        end
        refreshPage(cat)
        return {
            Set = function(v)
                for i, opt in ipairs(options) do
                    if opt == v then
                        current = v; curLabel.Text = v
                        for j, other in ipairs(items) do
                            other.BackgroundColor3 = (options[j] == v) and Theme.accentDark or Theme.itemBg
                            other.BackgroundTransparency = (options[j] == v) and 0.2 or 0.5
                        end
                    end
                end
            end,
            Get = function() return current end,
        }
    end

    -- Keybind: 行透明, 按键框保留
    local function addKeybind(cat, cfg)
        cfg = cfg or {}
        local currentKey = cfg.Default or Enum.KeyCode.RightShift
        local waiting = false
        local row = new("Frame", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = CONTROL_BG_TRANSPARENCY,
            BorderSizePixel = 0,
            LayoutOrder = nextOrderIn(cat), ZIndex = 4,
        }, cat.page)
        corner(6, row)
        new("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 1, Transparency = 0.2 }, row)

        local klabel = new("TextLabel", {
            Size = UDim2.new(1, -110, 1, 0), Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1, Text = cfg.Text or "Keybind",
            TextColor3 = Theme.text, TextXAlignment = Enum.TextXAlignment.Left,
            Font = Theme.fontMed, TextSize = 12, ZIndex = 5,
        }, row)
        outline(klabel)

        local keyBtn = new("TextButton", {
            Size = UDim2.new(0, 80, 0, 24),
            Position = UDim2.new(1, -94, 0.5, -12),
            BackgroundColor3 = Theme.inputBg,
            BackgroundTransparency = 0.3,
            BorderSizePixel = 0,
            Text = currentKey.Name, TextColor3 = Theme.text,
            Font = Theme.fontMed, TextSize = 11,
            AutoButtonColor = false, ZIndex = 5,
        }, row)
        corner(5, keyBtn)

        keyBtn.MouseButton1Click:Connect(function()
            waiting = true; keyBtn.Text = "..."; keyBtn.TextColor3 = Theme.accent
        end)
        UserInputService.InputBegan:Connect(function(input, gp)
            if not waiting then return end
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                keyBtn.Text = currentKey.Name
                keyBtn.TextColor3 = Theme.text
                waiting = false
                if cfg.Callback then pcall(cfg.Callback, currentKey) end
            end
        end)
        refreshPage(cat)
        return { Get = function() return currentKey end }
    end

