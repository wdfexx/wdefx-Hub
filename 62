function Win:AddKeybind(tab, cfg)
    local name = cfg.Name or "Keybind"
    local def = cfg.Default or Enum.KeyCode.F
    local cb = cfg.Callback

    local item = Instance.new("Frame")
    item.Size = UDim2.new(1, 0, 0, T.ItemH)
    item.BackgroundColor3 = T.Card
    item.BackgroundTransparency = 0.5
    item.BorderSizePixel = 0
    item.ZIndex = 56
    item.Parent = tab.container
    U.corner(item, 12)
    U.stroke(item, T.Line, 1, 0.7)

    local lbl = U.txt(item, name, 12, T.Tx)
    lbl.Size = UDim2.new(1, -130, 1, 0)
    lbl.Position = UDim2.new(0, 16, 0, 0)
    lbl.ZIndex = 57

    local keyBtn = Instance.new("TextButton")
    keyBtn.Size = UDim2.new(0, 90, 0, 26)
    keyBtn.Position = UDim2.new(1, -106, 0.5, -13)
    keyBtn.BackgroundColor3 = T.CardHover
    keyBtn.BackgroundTransparency = 0.3
    keyBtn.Text = def.Name
    keyBtn.TextColor3 = T.Acc
    keyBtn.TextSize = 11
    keyBtn.Font = Enum.Font.GothamBold
    keyBtn.BorderSizePixel = 0
    keyBtn.AutoButtonColor = false
    keyBtn.ZIndex = 57
    keyBtn.Parent = item
    U.corner(keyBtn, 8)

    local cur = def
    local listening = false

    keyBtn.MouseButton1Click:Connect(function()
        listening = true
        keyBtn.Text = "..."
        keyBtn.TextColor3 = T.Warn
    end)

    local conn = UserInputService.InputBegan:Connect(function(input)
        if not listening then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            cur = input.KeyCode
            keyBtn.Text = input.KeyCode.Name
            keyBtn.TextColor3 = T.Acc
            listening = false
            if cb then cb(input.KeyCode) end
        end
    end)
    table.insert(self.conns, conn)

    return {
        Set = function(k)
            cur = k
            keyBtn.Text = k.Name
        end,
        Get = function() return cur end,
    }
end

--=====================================================
-- 通知
--=====================================================
function Win:Notify(text, duration)
    duration = duration or 3
    local n = Instance.new("Frame")
    n.Size = UDim2.new(0, 240, 0, 50)
    n.Position = UDim2.new(1, 20, 1, -80)
    n.BackgroundColor3 = T.Card
    n.BackgroundTransparency = 0.1
    n.BorderSizePixel = 0
    n.ZIndex = 200
    n.Parent = self.gui
    U.corner(n, 12)
    U.stroke(n, T.Acc, 1, 0.6)

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 0.6, 0)
    bar.Position = UDim2.new(0, 0, 0.5, -bar.Size.Y.Scale / 2)
    bar.BackgroundColor3 = T.Acc
    bar.BorderSizePixel = 0
    bar.ZIndex = 201
    bar.Parent = n
    U.corner(bar, 2)
    U.grad(bar, T.Acc, T.Acc2, 90)

    local l = U.txt(n, text, 11, T.Tx)
    l.Size = UDim2.new(1, -24, 1, 0)
    l.Position = UDim2.new(0, 16, 0, 0)
    l.TextWrapped = true
    l.ZIndex = 201

    U.tw(n, T.T2, {Position = UDim2.new(1, -260, 1, -80)}, Enum.EasingStyle.Back)
    task.delay(duration, function()
        U.tw(n, T.T2, {Position = UDim2.new(1, 20, 1, -80)}, Enum.EasingStyle.Quart)
        task.wait(T.T2 + 0.1)
        n:Destroy()
    end)
end

--=====================================================
-- 销毁
--=====================================================
function Win:Destroy()
    for _, c in ipairs(self.conns) do
        pcall(function() c:Disconnect() end)
    end
    if self.gui then self.gui:Destroy() end
end

return Win