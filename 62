    --==================================================
    -- Category helpers
    --==================================================

    local function nextOrder(cat)
        cat.order += 1
        return cat.order
    end

    local function refreshPage(cat)
        task.defer(function()
            if cat and cat.page and cat.page.Parent then
                cat.page.CanvasSize = UDim2.new(
                    0,
                    0,
                    0,
                    cat.layout.AbsoluteContentSize.Y + 22
                )
            end
        end)
    end

    local function selectCategory(cat)
        if not cat or activeCategory == cat then
            return
        end

        activeCategory = cat

        pageHeading.Text = string.upper(cat.name)
        pageTitle.Text = cat.name
        pageSubtitle.Text = cat.description
            or ("Configure " .. cat.name:lower() .. " options.")

        for _, other in ipairs(categories) do
            local selected = other == cat

            other.page.Visible = selected
            other.indicator.Visible = selected

            tween(other.navButton, 0.15, {
                BackgroundColor3 = selected and Theme.AccentDeep or Theme.Surface,
                BackgroundTransparency = selected and 0 or 1,
            })

            tween(other.navLabel, 0.15, {
                TextColor3 = selected and Theme.Accent or Theme.Muted,
            })

            tween(other.navIcon, 0.15, {
                TextColor3 = selected and Theme.Accent or Theme.Dim,
            })
        end
    end

    --==================================================
    -- Category API and controls
    --==================================================

    local function createCategory(name, options)
        options = options or {}

        assert(type(name) == "string", "Category name must be a string")

        if categoryByName[name] then
            warn("FrostUI: duplicate category: " .. name)
            return categoryByName[name].api
        end

        local navButton = button(
            navList,
            "",
            UDim2.new(1, 0, 0, 39)
