--------------------------------------------------
-- 主题配置
--------------------------------------------------
local Theme = {
    -- 全息配色
    Holo1 = Color3.fromRGB(0, 220, 255),      -- 青色
    Holo2 = Color3.fromRGB(140, 80, 255),     -- 紫色
    Holo3 = Color3.fromRGB(255, 100, 200),    -- 粉紫
    BgDark = Color3.fromRGB(8, 10, 20),       -- 深空底色
    PanelBg = Color3.fromRGB(16, 22, 40),
    TextColor = Color3.fromRGB(220, 240, 255),
    SubText = Color3.fromRGB(130, 160, 200),
    BorderGlow = Color3.fromRGB(0, 220, 255),

    -- 尺寸
    PanelWidth = 340,
    PanelHeight = 460,
    IslandWidth = 220,
    IslandHeight = 34,
    DepthOffset = 5,      -- 厚度错位像素
    TiltAngle = -6,       -- 面板倾斜角度（3D 侧视角感）
}

--------------------------------------------------
-- 工具函数
--------------------------------------------------
local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.BorderGlow
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.3
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function gradient(parent, color1, color2, rotation)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, color1),
        ColorSequenceKeypoint.new(1, color2),
    }
    g.Rotation = rotation or 90
    g.Parent = parent
    return g
end

--------------------------------------------------
-- 3D 立体容器构建（核心：多层错位叠加做厚度）
--------------------------------------------------
local function build3DPanel(parent, width, height, radius)
    -- 底层阴影（最外圈）
    local shadow = Instance.new("Frame")
    shadow.Name = "Shadow"
    shadow.Size = UDim2.new(0, width + 10, 0, height + 10)
    shadow.Position = UDim2.new(0, -5 + 4, 0, -5 + 6)
    shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    shadow.BackgroundTransparency = 0.5
    shadow.BorderSizePixel = 0
    shadow.ZIndex = 0
    shadow.Parent = parent
    corner(shadow, radius + 2)

    -- 厚度层（错位多层，模拟面板侧面）
    for i = Theme.DepthOffset, 1, -1 do
        local layer = Instance.new("Frame")
        layer.Name = "Depth_" .. i
        layer.Size = UDim2.new(0, width, 0, height)
        layer.Position = UDim2.new(0, i, 0, i)
        layer.BackgroundColor3 = Color3.fromRGB(20, 30, 55)
        layer.BackgroundTransparency = 0.3 + i * 0.06
        layer.BorderSizePixel = 0
        layer.ZIndex = i
        layer.Parent = parent
        corner(layer, radius)
        stroke(layer, Theme.Holo2, 1, 0.7)
    end

    -- 面板主体
    local panel = Instance.new("Frame")
    panel.Name = "PanelBody"
    panel.Size = UDim2.new(0, width, 0, height)
    panel.Position = UDim2.new(0, 0, 0, 0)
    panel.BackgroundColor3 = Theme.PanelBg
    panel.BackgroundTransparency = 0.15
    panel.BorderSizePixel = 0
    panel.ClipsDescendants = true
    panel.ZIndex = 10
    panel.Parent = parent
    corner(panel, radius)

    -- 全息渐变（青紫对角）
    local bgGrad = gradient(panel, Color3.fromRGB(18, 26, 50), Color3.fromRGB(35, 20, 60), 135)
    bgGrad.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(0.5, 0.05),
        NumberSequenceKeypoint.new(1, 0.25),
    }

    -- 内层柔光
    local innerGlow = Instance.new("Frame")
    innerGlow.Size = UDim2.new(1, -8, 1, -8)
    innerGlow.Position = UDim2.new(0, 4, 0, 4)
    innerGlow.BackgroundTransparency = 1
    innerGlow.BorderSizePixel = 0
    innerGlow.ZIndex = 11
    innerGlow.Parent = panel
    corner(innerGlow, radius - 2)
    stroke(innerGlow, Theme.Holo1, 1, 0.85)

    -- 边缘发光
    stroke(panel, Theme.BorderGlow, 1.5, 0.2)

    -- 顶部高光条
    local topLight = Instance.new("Frame")
    topLight.Size = UDim2.new(1, -30, 0, 2)
    topLight.Position = UDim2.new(0, 15, 0, 3)
    topLight.BackgroundColor3 = Theme.Holo1
    topLight.BackgroundTransparency = 0.2
    topLight.BorderSizePixel = 0
    topLight.ZIndex = 12
    topLight.Parent = panel
    corner(topLight, 1)
    gradient(topLight, Theme.Holo1, Theme.Holo3, 0)

    -- 扫描线（装饰科技感）
    local scanLines = Instance.new("Frame")
    scanLines.Size = UDim2.new(1, 0, 1, 0)
    scanLines.BackgroundTransparency = 1
    scanLines.ZIndex = 11
    scanLines.Parent = panel
    for i = 0, 18 do
        local line = Instance.new("Frame")
        line.Size = UDim2.new(1, 0, 0, 1)
        line.Position = UDim2.new(0, 0, i / 18, 0)
        line.BackgroundColor3 = Theme.Holo1
        line.BackgroundTransparency = 0.94
        line.BorderSizePixel = 0
        line.ZIndex = 11
        line.Parent = scanLines
    end

    return panel, shadow
end

