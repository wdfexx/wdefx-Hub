    -- 分类存储
    self.tabs = {}
    self.currentTab = nil

    -- 绑定交互
    self:_bind()
    self:_startFloatingAnimation()

    return self
end

--------------------------------------------------
-- 悬浮动画（持续缓慢上下浮动，加强 3D 空间感）
--------------------------------------------------
function HoloWindow:_startFloatingAnimation()
    local baseY = self.panelContainer.Position.Y.Offset
    local tween = TweenService:Create(
        self.panelContainer,
        TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        { Position = UDim2.new(0.5, -(Theme.PanelWidth + 20) / 2, 0, baseY + 6) }
    )
    tween:Play()
    table.insert(self.connections, tween)
end

--------------------------------------------------
-- 展开 / 收起
--------------------------------------------------
function HoloWindow:_expand()
    if self.expanded then return end
    self.expanded = true
    self.panelContainer.Visible = true
    self.panelContainer.Size = UDim2.new(0, Theme.PanelWidth + 20, 0, 10)

    -- 椭圆条淡出
    TweenService:Create(self.island, TweenInfo.new(0.2), {
        BackgroundTransparency = 1,
    }):Play()
    TweenService:Create(self.islandText, TweenInfo.new(0.2), {
        TextTransparency = 1,
    }):Play()

    -- 面板弹出（弹性）
    TweenService:Create(self.panelContainer, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, Theme.PanelWidth + 20, 0, Theme.PanelHeight + 20),
    }):Play()
end

function HoloWindow:_collapse()
    if not self.expanded then return end
    self.expanded = false

    TweenService:Create(self.panelContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, Theme.PanelWidth + 20, 0, 10),
    }):Play()

    task.delay(0.25, function()
        if not self.expanded then
            self.panelContainer.Visible = false
        end
    end)

    TweenService:Create(self.island, TweenInfo.new(0.3), {
        BackgroundTransparency = 0.1,
    }):Play()
    TweenService:Create(self.islandText, TweenInfo.new(0.3), {
        TextTransparency = 0,
    }):Play()
end

--------------------------------------------------
-- 交互绑定
--------------------------------------------------
function HoloWindow:_bind()
    -- 点击椭圆条展开
    table.insert(self.connections, self.island.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self:_expand()
        end
    end))

    -- 拖拽
    local dragStart, startPos
    table.insert(self.connections, self.titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.dragging = true
            dragStart = input.Position
            startPos = self.panelContainer.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    self.dragging = false
                end
            end)
        end
    end))

    table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
        if self.dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            self.panelContainer.Position = newPos
            self.island.Position = UDim2.new(newPos.X.Scale, newPos.X.Offset + (Theme.PanelWidth + 20) / 2 - Theme.IslandWidth / 2, 0, 12)
        end
    end))

    -- 最小化按钮
    table.insert(self.connections, self.minBtn.MouseButton1Click:Connect(function()
        self:_collapse()
    end))

    -- 关闭按钮
    table.insert(self.connections, self.closeBtn.MouseButton1Click:Connect(function()
        self.gui.Enabled = false
    end))
end

--------------------------------------------------
-- 创建分类（Tab）
--------------------------------------------------
function HoloWindow:CreateTab(name)
    local tab = {}
    tab.name = name
    tab.items = {}

    -- 分类按钮
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 0, 1, -8)
    btn.AutomaticSize = Enum.AutomaticSize.X
    btn.BackgroundColor3 = Color3.fromRGB(40, 50, 80)
    btn.BackgroundTransparency = 0.4
    btn.Text = name
    btn.TextColor3 = Theme.SubText
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.ZIndex = 16
    btn.Parent = self.tabBar
    corner(btn, 6)
    -- 内边距
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
    pad.Parent = btn

    -- 分类内容容器
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 0)
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.BackgroundTransparency = 1
    container.Visible = false
    container.ZIndex = 15
    container.Parent = self.content

    local cLayout = Instance.new("UIListLayout")
    cLayout.Padding = UDim.new(0, 8)
    cLayout.SortOrder = Enum.SortOrder.LayoutOrder
    cLayout.Parent = container

    tab.button = btn
    tab.container = container

    -- 切换逻辑
    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(self.tabs) do
            t.container.Visible = false
            t.button.BackgroundTransparency = 0.4
            t.button.TextColor3 = Theme.SubText
        end
        container.Visible = true
        btn.BackgroundTransparency = 0.2
        btn.TextColor3 = Theme.Holo1
        self.currentTab = tab
    end)

    table.insert(self.tabs, tab)

    -- 第一个分类默认选中
    if #self.tabs == 1 then
        container.Visible = true
        btn.BackgroundTransparency = 0.2
        btn.TextColor3 = Theme.Holo1
        self.currentTab = tab
    end

    -- 返回挂载方法
    tab.window = self
    return tab
end

