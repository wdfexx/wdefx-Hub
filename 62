    subtitle.Position = UDim2.new(0, 20 + titleLabel.TextBounds.X + 10, 0, 0)
    subtitle.BackgroundTransparency = 1
    subtitle.Text = self.subtitle
    subtitle.TextColor3 = Theme.TextDim
    subtitle.TextSize = 11
    subtitle.Font = Enum.Font.Gotham
    subtitle.TextXAlignment = Enum.TextXAlignment.Left
    subtitle.ZIndex = 11
    subtitle.Parent = self.titleBar

    --=====================================================
    -- 【升级】最小化按钮 — 模仿 WindUI 但不同
    -- WindUI：点击后窗口收缩为极小点并隐藏
    -- 本版：窗口收缩为标题栏高度并保留标题文字，图标旋转 90°
    --=====================================================
    self.minBtn = Instance.new("TextButton")
    self.minBtn.Size = UDim2.new(0, 30, 0, 30)
    self.minBtn.Position = UDim2.new(1, -76, 0, 7)
    self.minBtn.BackgroundColor3 = Color3.fromRGB(50, 52, 65)
    self.minBtn.BackgroundTransparency = 0.4
    self.minBtn.Text = "—"
    self.minBtn.TextColor3 = Theme.Text
    self.minBtn.TextSize = 16
    self.minBtn.Font = Enum.Font.GothamBold
    self.minBtn.BorderSizePixel = 0
    self.minBtn.ZIndex = 11
    self.minBtn.Parent = self.titleBar
    Util.corner(self.minBtn, 8)

    -- 关闭按钮
    self.closeBtn = Instance.new("TextButton")
    self.closeBtn.Size = UDim2.new(0, 30, 0, 30)
    self.closeBtn.Position = UDim2.new(1, -40, 0, 7)
    self.closeBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 50)
    self.closeBtn.BackgroundTransparency = 0.4
    self.closeBtn.Text = "×"
    self.closeBtn.TextColor3 = Theme.Danger
    self.closeBtn.TextSize = 16
    self.closeBtn.Font = Enum.Font.GothamBold
    self.closeBtn.BorderSizePixel = 0
    self.closeBtn.ZIndex = 11
    self.closeBtn.Parent = self.titleBar
    Util.corner(self.closeBtn, 8)

    --=====================================================
    -- 主体
    --=====================================================
    self.body = Instance.new("Frame")
    self.body.Size = UDim2.new(1, -20, 1, -Theme.TitleHeight - 14)
    self.body.Position = UDim2.new(0, 10, 0, Theme.TitleHeight + 4)
    self.body.BackgroundTransparency = 1
    self.body.ZIndex = 5
    self.body.Parent = self.root

    -- 侧边栏
    self.sidebar = Instance.new("Frame")
    self.sidebar.Size = UDim2.new(0, Theme.SidebarWidth, 1, 0)
    self.sidebar.BackgroundColor3 = Theme.BgLight
    self.sidebar.BackgroundTransparency = 0.3
    self.sidebar.BorderSizePixel = 0
    self.sidebar.ZIndex = 6
    self.sidebar.Parent = self.body
    Util.corner(self.sidebar, 10)

    local sidebarLayout = Instance.new("UIListLayout")
    sidebarLayout.Padding = UDim.new(0, 4)
    sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sidebarLayout.Parent = self.sidebar

    -- 内容区
    self.content = Instance.new("Frame")
    self.content.Size = UDim2.new(1, -Theme.SidebarWidth - 10, 1, 0)
    self.content.Position = UDim2.new(0, Theme.SidebarWidth + 10, 0, 0)
    self.content.BackgroundTransparency = 1
    self.content.ZIndex = 6
    self.content.ClipsDescendants = true
    self.content.Parent = self.body

    --=====================================================
    -- 【新增】拖拽缩放：四角手柄
    --=====================================================
    self:_setupResizeHandles()

    --=====================================================
    -- 交互：拖动
    --=====================================================
    local dragging, dragStart, startPos
    table.insert(self.connections, self.titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.root.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end))

    table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            self.root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))

    -- 最小化
    table.insert(self.connections, self.minBtn.MouseButton1Click:Connect(function()
        self:ToggleMinimize()
    end))

    -- 关闭
    table.insert(self.connections, self.closeBtn.MouseButton1Click:Connect(function()
        self:Destroy()
    end))

    -- 快捷键
    table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            self.root.Visible = not self.root.Visible
        end
    end))

    -- 入场动画
    self.root.Size = UDim2.new(0, 0, 0, 0)
    Util.tween(self.root, Theme.AnimSlow, {
        Size = UDim2.new(0, self.width, 0, self.height),
    }, Enum.EasingStyle.Back)

    return self
end

