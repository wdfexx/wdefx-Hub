    subtitle.Position = UDim2.new(0, 20 + titleLabel.TextBounds.X + 10, 0, 0)
    subtitle.BackgroundTransparency = 1
    subtitle.Text = self.subtitle
    subtitle.TextColor3 = Theme.TextDim
    subtitle.TextSize = 11
    subtitle.Font = Enum.Font.Gotham
    subtitle.TextXAlignment = Enum.TextXAlignment.Left
    subtitle.ZIndex = 11
    subtitle.Parent = self.titleBar

    -- 最小化按钮
    self.minBtn = Instance.new("TextButton")
    self.minBtn.Size = UDim2.new(0, 30, 0, 30)
    self.minBtn.Position = UDim2.new(1, -76, 0, 7)
    self.minBtn.BackgroundColor3 = Color3.fromRGB(50, 52, 65)
    self.minBtn.BackgroundTransparency = 0.4
    self.minBtn.Text = "−"
    self.minBtn.TextColor3 = Theme.Text
    self.minBtn.TextSize = 16
    self.minBtn.Font = Enum.Font.GothamBold
    self.minBtn.BorderSizePixel = 0
    self.minBtn.ZIndex = 11
    self.minBtn.Parent = self.titleBar
    Util.corner(self.minBtn, 8)
    Util.applyHover(self.minBtn, Color3.fromRGB(50, 52, 65), Color3.fromRGB(70, 72, 90))

    -- 关闭按钮
    self.closeBtn = Instance.new("TextButton")
    self.closeBtn.Size = UDim2.new(0, 30, 0, 30)
    self.closeBtn.Position = UDim2.new(1, -40, 0, 7)
    self.closeBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 50)
    self.closeBtn.BackgroundTransparency = 0.4
    self.closeBtn.Text = "×"
    self.closeBtn.TextColor3 = Theme.Danger
    self.closeBtn.TextSize = 16
    self.closeBtn.Font = Enum.Font.GothamBold
    self.closeBtn.BorderSizePixel = 0
    self.closeBtn.ZIndex = 11
    self.closeBtn.Parent = self.titleBar
    Util.corner(self.closeBtn, 8)
    Util.applyHover(self.closeBtn, Color3.fromRGB(60, 40, 50), Color3.fromRGB(120, 50, 70))

    --=====================================================================
    -- 主体区域
    --=====================================================================
    self.body = Instance.new("Frame")
    self.body.Name = "Body"
    self.body.Size = UDim2.new(1, -20, 1, -Theme.TitleHeight - 14)
    self.body.Position = UDim2.new(0, 10, 0, Theme.TitleHeight + 4)
    self.body.BackgroundTransparency = 1
    self.body.ZIndex = 5
    self.body.Parent = self.root

    --=====================================================================
    -- 侧边栏（分类）
    --=====================================================================
    self.sidebar = Instance.new("Frame")
    self.sidebar.Name = "Sidebar"
    self.sidebar.Size = UDim2.new(0, Theme.SidebarWidth, 1, 0)
    self.sidebar.BackgroundColor3 = Theme.BgLight
    self.sidebar.BackgroundTransparency = 0.3
    self.sidebar.BorderSizePixel = 0
    self.sidebar.ZIndex = 6
    self.sidebar.Parent = self.body
    Util.corner(self.sidebar, 10)

    local sidebarLayout = Instance.new("UIListLayout")
    sidebarLayout.Padding = UDim.new(0, 4)
    sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sidebarLayout.Parent = self.sidebar
    Util.padding(self.sidebar, 8, 6, 8, 6)

    --=====================================================================
    -- 内容区
    --=====================================================================
    self.content = Instance.new("Frame")
    self.content.Name = "Content"
    self.content.Size = UDim2.new(1, -Theme.SidebarWidth - 10, 1, 0)
    self.content.Position = UDim2.new(0, Theme.SidebarWidth + 10, 0, 0)
    self.content.BackgroundTransparency = 1
    self.content.ZIndex = 6
    self.content.ClipsDescendants = true
    self.content.Parent = self.body

    --=====================================================================
    -- 交互：拖动
    --=====================================================================
    local dragging, dragStart, startPos
    table.insert(self.connections, self.titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.root.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end))

    table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            self.root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))

    -- 最小化
    table.insert(self.connections, self.minBtn.MouseButton1Click:Connect(function()
        self:ToggleMinimize()
    end))

    -- 关闭
    table.insert(self.connections, self.closeBtn.MouseButton1Click:Connect(function()
        self:Destroy()
    end))

    -- 开关快捷键
    table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            self.root.Visible = not self.root.Visible
        end
    end))

    -- 入场动画
    self.root.Size = UDim2.new(0, 0, 0, 0)
    Util.tween(self.root, Theme.AnimSlow, {
        Size = UDim2.new(0, self.width, 0, self.height),
    }, Enum.EasingStyle.Back)

    return self
end

--=====================================================================
-- 最小化/恢复
--=====================================================================
function Window:ToggleMinimize()
    self.minimized = not self.minimized
    local targetHeight = self.minimized and Theme.TitleHeight or self.height
    Util.tween(self.root, Theme.AnimNormal, {
        Size = UDim2.new(0, self.width, 0, targetHeight),
    }, Enum.EasingStyle.Quart)

    if self.minimized then
        self.body.Visible = false
    else
        task.delay(Theme.AnimNormal * 0.5, function()
            self.body.Visible = true
        end)
    end
end

--=====================================================================
-- 创建分类
--=====================================================================
function Window:CreateTab(name, icon)
    local tab = {}

    -- 分类按钮
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(30, 32, 42)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.BorderSizePixel = 0
    btn.ZIndex = 7
    btn.Parent = self.sidebar
    Util.corner(btn, 8)

    -- 左侧高亮条
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0.6, 0)
    indicator.Position = UDim2.new(0, 0, 0.5, -indicator.Size.Y.Scale / 2)
    indicator.BackgroundColor3 = Theme.Accent
    indicator.BackgroundTransparency = 1
    indicator.BorderSizePixel = 0
    indicator.ZIndex = 8
    indicator.Parent = btn
    Util.corner(indicator, 2)

    -- 文字
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Theme.TextDim
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 8
    label.Parent = btn

    -- 内容容器
    local container = Instance.new("ScrollingFrame")
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ScrollBarThickness = 3
    container.ScrollBarImageColor3 = Theme.Accent
    container.CanvasSize = UDim2.new(0, 0, 0, 0)
    container.AutomaticCanvasSize = Enum.AutomaticSize.Y
    container.Visible = false
    container.ZIndex = 7
    container.Parent = self.content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = container
    Util.padding(container, 4, 8, 20, 4)

    tab.button = btn
    tab.indicator = indicator
    tab.label = label
    tab.container = container
    tab.window = self
    tab.items = {}

    -- 悬停
    btn.MouseEnter:Connect(function()
        if self.currentTab ~= tab then
            Util.tween(btn, Theme.AnimFast, { BackgroundTransparency = 0.7 })
            Util.tween(label, Theme.AnimFast, { TextColor3 = Theme.Text })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.currentTab ~= tab then
            Util.tween(btn, Theme.AnimFast, { BackgroundTransparency = 1 })
            Util.tween(label, Theme.AnimFast, { TextColor3 = Theme.TextDim })
        end
    end)

    -- 点击切换
    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.tabs, tab)

    -- 第一个分类自动选中
    if #self.tabs == 1 then
        self:SelectTab(tab)
    end

    return tab
end

function Window:SelectTab(tab)
    for _, t in ipairs(self.tabs) do
        t.container.Visible = false
        Util.tween(t.btn or t.button, Theme.AnimFast, { BackgroundTransparency = 1 })
        Util.tween(t.indicator, Theme.AnimFast, { BackgroundTransparency = 1 })
        Util.tween(t.label, Theme.AnimFast, { TextColor3 = Theme.TextDim })
    end

    tab.container.Visible = true
    Util.tween(tab.button, Theme.AnimFast, { BackgroundTransparency = 0.6 })
    Util.tween(tab.indicator, Theme.AnimFast, { BackgroundTransparency = 0 })
    Util.tween(tab.label, Theme.AnimFast, { TextColor3 = Theme.Text })

    -- 内容切换动画
    tab.container.Position = UDim2.new(0, 10, 0, 0)
    Util.tween(tab.container, Theme.AnimNormal, { Position = UDim2.new(0, 0, 0, 0) })

    self.currentTab = tab
end

