        Size = UDim2.new(1, -24, 0, 15),
        Position = UDim2.new(0, 12, 1, -20),
        BackgroundTransparency = 1,
    }, item)
    local vals = {0.68, 0.55, 0.72, 0.48, 0.59, 0.32, 0.43, 0.18, 0.35, 0.12}
    for i = 1, #vals - 1 do
        local x1, y1 = (i-1)/(#vals-1), vals[i]
