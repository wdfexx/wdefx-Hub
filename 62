    function self:Category(name)
        return createCategory(name)
    end

    function self:SelectCategory(name)
        for _, cat in ipairs(categories) do
            if cat.Name == name then
                selectCategory(cat)
                return true
            end
        end
        if name == "Dashboard" or name == "Overview" then
            activeCategory = nil
            overview.Visible = true
            for _, cat in ipairs(categories) do
                cat.Page.Visible = false
                cat.Indicator.Visible = false
                cat.NavButton.BackgroundTransparency = 1
                cat.Icon.TextColor3 = Palette.Muted
                cat.NameLabel.TextColor3 = Palette.Muted
            end
            welcomeTitle.Text = "Welcome back"
            welcomeSub.Text = "Your workspace is ready. Here's your activity at a glance."
            return true
        end
        return false
    end

    function self:Minimize() minimize() end
    function self:Restore() restore() end
    function self:Destroy()
        if destroyed then return end
        destroyed = true
        for _, connection in ipairs(connections) do
            pcall(function() connection:Disconnect() end)
        end
        if screen and screen.Parent then screen:Destroy() end
    end

    -- Start on overview. Navigation categories are added by the caller.
    return self
end

Synaptix.Theme = Palette
Synaptix.Config = {}

return Synaptix