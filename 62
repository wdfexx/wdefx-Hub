local function addSegment(p1, p2)
    local x1, y1 = p1.X * plot.AbsoluteSize.X, p1.Y * plot.AbsoluteSize.Y
    local x2, y2 = p2.X * plot.AbsoluteSize.X, p2.Y * plot.AbsoluteSize.Y
    local delta = Vector2.new(x2 - x1, y2 - y1)
    local line = create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.fromOffset(x1, y1),
        Size = UDim2.fromOffset(delta.Magnitude, 2),
        Rotation = math.deg(math.atan2(delta.Y, delta.X)),
        BackgroundColor3 = C.purple,
        BorderSizePixel = 0,
    }, plot)
    return line
end

local function drawChart()
    for _, child in ipairs(plot:GetChildren()) do
        if child.Name == "ChartSegment" or child.Name == "ChartPoint" then child:Destroy() end
    end
    for i = 1, #points - 1 do
        local p1, p2 = points[i], points[i + 1]
        local x1, y1 = p1.X * plot.AbsoluteSize.X, p1.Y * plot.AbsoluteSize.Y
        local x2, y2 = p2.X * plot.AbsoluteSize.X, p2.Y * plot.AbsoluteSize.Y
        local delta = Vector2.new(x2 - x1, y2 - y1)
        local line = create("Frame", {
            Name = "ChartSegment",
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.fromOffset(x1, y1),
            Size = UDim2.fromOffset(delta.Magnitude, 2),
            Rotation = math.deg(math.atan2(delta.Y, delta.X)),
            BackgroundColor3 = C.purple,
            BorderSizePixel = 0,
        }, plot)
    end
    for _, p in ipairs(points) do
        local dot = create("Frame", {
            Name = "ChartPoint",
            Size = UDim2.fromOffset(8, 8),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(p.X, 0, p.Y, 0),
            BackgroundColor3 = C.text,
            BorderSizePixel = 0,
        }, plot)
        corner(dot, 8)
        outline(dot, C.purple, 0, 1)
    end
end

