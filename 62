    self.gui.ResetOnSpawn = false
    self.gui.IgnoreGuiInset = true
    self.gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    self.gui.Parent = playerGui

    --------------------------------------------------
    -- 顶部椭圆条（形状像灵动岛，只是一个展开按钮）
    --------------------------------------------------
    self.island = Instance.new("Frame")
    self.island.Name = "TopBar"
    self.island.Size = UDim2.new(0, Theme.IslandWidth, 0, Theme.IslandHeight)
    self.island.Position = UDim2.new(0.5, -Theme.IslandWidth / 2, 0, 12)
    self.island.BackgroundColor3 = Color3.fromRGB(12, 16, 28)
    self.island.BackgroundTransparency = 0.1
    self.island.BorderSizePixel = 0
    self.island.ZIndex = 20
    self.island.Parent = self.gui
    corner(self.island, Theme.IslandHeight / 2)  -- 100% 圆角 = 椭圆条

    -- 椭圆条的厚度层
    for i = 3, 1, -1 do
        local layer = Instance.new("Frame")
        layer.Size = UDim2.new(1, 0, 1, 0)
        layer.Position = UDim2.new(0, i, 0, i)
        layer.BackgroundColor3 = Theme.Holo2
        layer.BackgroundTransparency = 0.7
        layer.BorderSizePixel = 0
        layer.ZIndex = 20 - i
        layer.Parent = self.island
        corner(layer, Theme.IslandHeight / 2)
    end

    -- 椭圆条渐变
    gradient(self.island, Color3.fromRGB(20, 30, 60), Color3.fromRGB(40, 20, 70), 0)
    stroke(self.island, Theme.Holo1, 1.5, 0.25)

    -- 椭圆条文字
    local islandText = Instance.new("TextLabel")
    islandText.Size = UDim2.new(1, -30, 1, 0)
    islandText.Position = UDim2.new(0, 15, 0, 0)
