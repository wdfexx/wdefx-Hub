local function create(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    create("UICorner", {CornerRadius = UDim.new(0, radius or 10)}, obj)
end

local function outline(obj, color, transparency, thickness)
    return create("UIStroke", {
        Color = color or C.border,
        Transparency = transparency or 0,
        Thickness = thickness or 1,
    }, obj)
end

local function gradient(obj, color1, color2, rotation)
    create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, color1),
            ColorSequenceKeypoint.new(1, color2),
        }),
        Rotation = rotation or 0,
    }, obj)
end

local function tw(obj, time, props, style)
    if not obj or not obj.Parent then return end
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.16, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function text(parent, value, size, color, font, align)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = value or "",
        TextSize = size or 12,
        TextColor3 = color or C.text,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = align or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = false,
        BorderSizePixel = 0,
    }, parent)
end

local function btn(parent, value, size, pos, bg)
    return create("TextButton", {
        Text = value or "",
        Size = size,
        Position = pos or UDim2.new(),
        BackgroundColor3 = bg or C.panel2,
        TextColor3 = C.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Active = true,
    }, parent)
end

