function Window:AddButton(tab, config)
    local name = config.Name or "Button"
    local callback = config.Callback
    local color = config.Color or Theme.Accent

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, Theme.ItemHeight)
    btn.BackgroundColor3 = color
    btn.BackgroundTransparency = 0.7
    btn.Text = name
    btn.TextColor3 = Theme.Text
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamMedium
    btn.BorderSizePixel = 0
    btn.ZIndex = 8
    btn.Parent = tab.container
    Util.corner(btn, 10)
    Util.stroke(btn, color, 1, 0.5)

    btn.MouseEnter:Connect(function()
        Util.tween(btn, Theme.AnimFast, { BackgroundTransparency = 0.4 })
    end)
    btn.MouseLeave:Connect(function()
        Util.tween(btn, Theme.AnimFast, { BackgroundTransparency = 0.7 })
    end)
    btn.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)

    return btn
end

