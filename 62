    self.content.BackgroundTransparency = 1
    self.content.ZIndex = 15
    self.content.ClipsDescendants = true
    self.content.Parent = self.root

    --=====================================================
    -- 拖动
    --=====================================================
    local dragging, dragStart, startPos
    table.insert(self.connections, self.titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.root.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end))

    table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            self.root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))

    --=====================================================
    -- 最小化
    --=====================================================
    table.insert(self.connections, self.minBtn.MouseButton1Click:Connect(function()
        self:ToggleMinimize()
    end))

    -- 关闭
    table.insert(self.connections, self.closeBtn.MouseButton1Click:Connect(function()
        self:Destroy()
    end))

    -- 快捷键
    table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            self.root.Visible = not self.root.Visible
        end
    end))

    -- 入场动画
    self.root.Size = UDim2.new(0, 0, 0, 0)
    self.root.BackgroundTransparency = 1
    Util.tween(self.root, Theme.Slow, {
        Size = UDim2.new(0, self.width, 0, self.height),
        BackgroundTransparency = 0.08,
    }, Enum.EasingStyle.Back)

    return self
end

--=====================================================
-- 最小化
--=====================================================
function Window:ToggleMinimize()
    self.minimized = not self.minimized
    if self.minimized then
        Util.tween(self.root, Theme.Normal, {
            Size = UDim2.new(0, self.width, 0, Theme.TitleH),
        }, Enum.EasingStyle.Quart)
        self.content.Visible = false
        self.tabBar.Visible = false
        Util.tween(self.minBtn, Theme.Fast, {
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 0.2,
        })
    else
        self.content.Visible = true
        self.tabBar.Visible = true
        Util.tween(self.root, Theme.Normal, {
            Size = UDim2.new(0, self.width, 0, self.height),
        }, Enum.EasingStyle.Back)
        Util.tween(self.minBtn, Theme.Fast, {
            BackgroundColor3 = Theme.Glass,
            BackgroundTransparency = 0.5,
        })
    end
end

