local chartPoints = {0.78,0.66,0.47,0.51,0.61,0.40,0.44,0.27,0.32,0.18,0.21,0.08}
local function drawPerformance()
    for _, child in ipairs(plot:GetChildren()) do
        if child.Name == "LineSeg" or child.Name == "PointDot" then child:Destroy() end
    end
    local abs = plot.AbsoluteSize
    local left = 28
    local usableW = math.max(abs.X - left - 4, 1)
    local usableH = math.max(abs.Y - 26, 1)
    for i = 1, #chartPoints - 1 do
        local x1 = left + (i-1)/(#chartPoints-1)*usableW
        local x2 = left + i/(#chartPoints-1)*usableW
        local y1 = 12 + chartPoints[i]*usableH
        local y2 = 12 + chartPoints[i+1]*usableH
        local dx, dy = x2-x1, y2-y1
        local seg = make("Frame", {
            Name = "LineSeg",
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.fromOffset(x1, y1),
            Size = UDim2.fromOffset(math.sqrt(dx*dx+dy*dy), 2),
            Rotation = math.deg(math.atan2(dy, dx)),
            BackgroundColor3 = Theme.Purple,
            BorderSizePixel = 0,
            ZIndex = 2,
        }, plot)
    end
    for i, val in ipairs(chartPoints) do
        if i == #chartPoints then
            local dot = make("Frame", {
                Name = "PointDot",
                Size = UDim2.fromOffset(7, 7),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new((i-1)/(#chartPoints-1), left, 0, 12 + val*usableH),
                BackgroundColor3 = Theme.Text,
                BorderSizePixel = 0,
                ZIndex = 3,
            }, plot)
            round(dot, 5)
            outline(dot, Theme.Purple, 0, 1)
        end
    end
end
