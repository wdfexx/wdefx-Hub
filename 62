function Window:CreateTab(name)
    local tab = {}
    tab.name = name
    tab.items = {}
    tab.window = self

    -- 标签按钮
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 0, 0, 30)
    btn.AutomaticSize = Enum.AutomaticSize.X
    btn.BackgroundColor3 = Theme.Glass
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.BorderSizePixel = 0
    btn.ZIndex = 21
    btn.Parent = self.tabBar
    Util.corner(btn, 10)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Theme.TextDim
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.ZIndex = 22
    label.Parent = btn

    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 14)
    pad.PaddingRight = UDim.new(0, 14)
    pad.Parent = btn

    -- 内容容器
    local container = Instance.new("ScrollingFrame")
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ScrollBarThickness = 3
    container.ScrollBarImageColor3 = Theme.Accent
    container.ScrollBarImageTransparency = 0.5
    container.CanvasSize = UDim2.new(0, 0, 0, 0)
    container.AutomaticCanvasSize = Enum.AutomaticSize.Y
    container.Visible = false
    container.ZIndex = 16
    container.Parent = self.content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = container

    tab.button = btn
    tab.label = label
    tab.container = container

    -- 点击切换
    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    -- 悬停
    btn.MouseEnter:Connect(function()
        if self.currentTab ~= tab then
            Util.tween(btn, Theme.Fast, { BackgroundTransparency = 0.7 })
            Util.tween(label, Theme.Fast, { TextColor3 = Theme.Text })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.currentTab ~= tab then
            Util.tween(btn, Theme.Fast, { BackgroundTransparency = 1 })
            Util.tween(label, Theme.Fast, { TextColor3 = Theme.TextDim })
        end
    end)

    table.insert(self.tabs, tab)
    if #self.tabs == 1 then
        self:SelectTab(tab)
    end

    return tab
end

function Window:SelectTab(tab)
    for _, t in ipairs(self.tabs) do
        t.container.Visible = false
        Util.tween(t.button, Theme.Fast, { BackgroundTransparency = 1 })
        Util.tween(t.label, Theme.Fast, { TextColor3 = Theme.TextDim })
    end

    tab.container.Visible = true
    Util.tween(tab.button, Theme.Fast, { BackgroundTransparency = 0.6 })
    Util.tween(tab.label, Theme.Fast, { TextColor3 = Theme.Text })

    -- 指示条滑动
    local btn = tab.button
    local targetX = btn.AbsolutePosition.X - self.tabBar.AbsolutePosition.X
    local targetW = btn.AbsoluteSize.X
    Util.tween(self.tabIndicator, Theme.Normal, {
        Position = UDim2.new(0, targetX, 1, -3),
        Size = UDim2.new(0, targetW, 0, 3),
    }, Enum.EasingStyle.Quint)

    -- 内容切换淡入
    tab.container.Position = UDim2.new(0, 12, 0, 0)
    Util.tween(tab.container, Theme.Normal, { Position = UDim2.new(0, 0, 0, 0) })

    self.currentTab = tab
end

