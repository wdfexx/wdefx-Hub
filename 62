function Win:AddButton(tab, cfg)
    local name = cfg.Name or "Button"
    local cb = cfg.Callback
    local col = cfg.Color or T.Acc

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, T.ItemH)
    btn.BackgroundColor3 = col
    btn.BackgroundTransparency = 0.75
    btn.Text = name
    btn.TextColor3 = T.Tx
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.ZIndex = 56
    btn.Parent = tab.container
    U.corner(btn, 12)
    U.stroke(btn, col, 1, 0.4)

    btn.MouseEnter:Connect(function()
        U.tw(btn, T.T1, {BackgroundTransparency = 0.45})
    end)
    btn.MouseLeave:Connect(function()
        U.tw(btn, T.T1, {BackgroundTransparency = 0.75})
    end)
    btn.MouseButton1Click:Connect(function()
        local orig = btn.Size
        btn.Size = UDim2.new(1, 4, 0, T.ItemH + 2)
        U.tw(btn, 0.1, {Size = orig}, Enum.EasingStyle.Back)
        if cb then cb() end
    end)

    return btn
end

