function Win:AddToggle(tab, cfg)
    local name = cfg.Name or "Toggle"
    local def = cfg.Default or false
    local cb = cfg.Callback

    local item = Instance.new("Frame")
    item.Size = UDim2.new(1, 0, 0, T.ItemH)
    item.BackgroundColor3 = T.Card
    item.BackgroundTransparency = 0.5
    item.BorderSizePixel = 0
    item.ZIndex = 56
    item.Parent = tab.container
    U.corner(item, 12)
    U.stroke(item, T.Line, 1, 0.7)

    local lbl = U.txt(item, name, 12, T.Tx)
    lbl.Size = UDim2.new(1, -90, 1, 0)
    lbl.Position = UDim2.new(0, 16, 0, 0)
    lbl.ZIndex = 57

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 42, 0, 24)
    track.Position = UDim2.new(1, -58, 0.5, -12)
    track.BackgroundColor3 = def and T.Acc or Color3.fromRGB(48, 52, 68)
    track.BorderSizePixel = 0
    track.ZIndex = 57
    track.Parent = item
    U.corner(track, 12)

    if def then
        U.grad(track, T.Acc, T.Acc2, 0)
    end

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = def and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 58
    knob.Parent = track
    U.corner(knob, 9)

    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.ZIndex = 59
    click.Parent = item

    local state = def

    click.MouseButton1Click:Connect(function()
        state = not state
        U.tw(track, T.T2, {BackgroundColor3 = state and T.Acc or Color3.fromRGB(48, 52, 68)})
        U.tw(knob, T.T2, {
            Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
        }, Enum.EasingStyle.Back)
        -- 弹动效果
        local orig = item.Size
        item.Size = UDim2.new(1, 4, 0, T.ItemH + 2)
        U.tw(item, 0.13, {Size = orig}, Enum.EasingStyle.Back)
        if cb then cb(state) end
    end)

    item.MouseEnter:Connect(function()
        U.tw(item, T.T1, {BackgroundTransparency = 0.3})
    end)
    item.MouseLeave:Connect(function()
        U.tw(item, T.T1, {BackgroundTransparency = 0.5})
    end)

    return {
        Set = function(v)
            state = v
            U.tw(track, T.T1, {BackgroundColor3 = state and T.Acc or Color3.fromRGB(48, 52, 68)})
            U.tw(knob, T.T2, {
                Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
            })
        end,
        Get = function() return state end,
    }
end

--=====================================================
-- 滑块
--=====================================================
function Win:AddSlider(tab, cfg)
    local name = cfg.Name or "Slider"
    local mn = cfg.Min or 0
    local mx = cfg.Max or 100
    local def = cfg.Default or mn
    local sfx = cfg.Suffix or ""
    local cb = cfg.Callback

    local item = Instance.new("Frame")
    item.Size = UDim2.new(1, 0, 0, 60)
    item.BackgroundColor3 = T.Card
    item.BackgroundTransparency = 0.5
    item.BorderSizePixel = 0
    item.ZIndex = 56
    item.Parent = tab.container
    U.corner(item, 12)
    U.stroke(item, T.Line, 1, 0.7)

    local lbl = U.txt(item, name, 12, T.Tx)
    lbl.Size = UDim2.new(1, -100, 0, 20)
    lbl.Position = UDim2.new(0, 16, 0, 8)
    lbl.ZIndex = 57

    local valLbl = U.txt(item, tostring(def) .. sfx, 12, T.Acc, true, Enum.TextXAlignment.Right)
    valLbl.Size = UDim2.new(0, 80, 0, 20)
    valLbl.Position = UDim2.new(1, -96, 0, 8)
    valLbl.ZIndex = 57

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -32, 0, 5)
    track.Position = UDim2.new(0, 16, 0, 40)
    track.BackgroundColor3 = Color3.fromRGB(44, 48, 64)
    track.BorderSizePixel = 0
    track.ZIndex = 57
    track.Parent = item
    U.corner(track, 3)

    local ratio = (def - mn) / (mx - mn)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    fill.BackgroundColor3 = T.Acc
    fill.BorderSizePixel = 0
    fill.ZIndex = 58
    fill.Parent = track
    U.corner(fill, 3)
    U.grad(fill, T.Acc, T.Acc2, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(ratio, -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 59
    knob.Parent = track
    U.corner(knob, 7)
    U.stroke(knob, T.Acc, 2, 0)

    local cur = def
    local dragging = false

    local function upd(input)
        local x = input.Position.X
        local tx = track.AbsolutePosition.X
        local tw = track.AbsoluteSize.X
        local r = math.clamp((x - tx) / tw, 0, 1)
        local v = math.floor(mn + (mx - mn) * r)
        cur = v
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, -7, 0.5, -7)
        valLbl.Text = tostring(v) .. sfx
        if cb then cb(v) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local orig = item.Size
            item.Size = UDim2.new(1, 3, 0, 63)
            U.tw(item, 0.12, {Size = orig}, Enum.EasingStyle.Back)
            upd(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            upd(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        Set = function(v)
            v = math.clamp(v, mn, mx)
            cur = v
            local r = (v - mn) / (mx - mn)
            fill.Size = UDim2.new(r, 0, 1, 0)
            knob.Position = UDim2.new(r, -7, 0.5, -7)
            valLbl.Text = tostring(v) .. sfx
        end,
        Get = function() return cur end,
    }
end

