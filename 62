            Text = "▼",
            TextColor3 = Theme.textDim,
            Font = Theme.fontBold,
            TextSize = 8,
        }, header)

        local list = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 0, math.min(#options * 28, 180)),
            Position = UDim2.new(0, 0, 0, 40),
            BackgroundColor3 = Theme.sidebar,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 10,
            ScrollBarThickness = 3,
            CanvasSize = UDim2.new(0, 0, 0, 0),
        }, container)
        corner(6, list)
        stroke(Theme.accent, 1, 0.5, list)
        local listLayout = new("UIListLayout", {
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, list)
        new("UIPadding", {
            PaddingTop = UDim.new(0, 4),
            PaddingLeft = UDim.new(0, 4),
            PaddingRight = UDim.new(0, 4),
            PaddingBottom = UDim.new(0, 4),
        }, list)

        local items = {}
        for i, opt in ipairs(options) do
            local it = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundColor3 = (opt == current) and Theme.accentDark or Theme.itemBg,
                BorderSizePixel = 0,
                Text = tostring(opt),
                TextColor3 = Theme.text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Font = Theme.fontMed,
                TextSize = 11,
                AutoButtonColor = false,
                LayoutOrder = i,
            }, list)
            corner(4, it)
            new("UIPadding", { PaddingLeft = UDim.new(0, 10) }, it)
            items[i] = it
        end
        task.defer(function()
            list.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 8)
        end)

        local function closeList() open = false; list.Visible = false; arrow.Text = "▼" end
        local function openList() open = true; list.Visible = true; arrow.Text = "▲" end

        header.MouseButton1Click:Connect(function()
            if open then closeList() else openList() end
        end)

        for i, it in ipairs(items) do
            it.MouseButton1Click:Connect(function()
                current = options[i]
                curLabel.Text = current
                for j, other in ipairs(items) do
                    other.BackgroundColor3 = (options[j] == current) and Theme.accentDark or Theme.itemBg
                end
                closeList()
                if cfg.Callback then pcall(cfg.Callback, current) end
            end)
        end

        refreshPage(cat)
        return {
            Set = function(v)
                for i, opt in ipairs(options) do
                    if opt == v then
                        current = v
                        curLabel.Text = v
                        for j, other in ipairs(items) do
                            other.BackgroundColor3 = (options[j] == v) and Theme.accentDark or Theme.itemBg
                        end
                    end
                end
            end,
            Get = function() return current end,
        }
    end

    -- ---------- Keybind ----------
    local function addKeybind(cat, cfg)
        cfg = cfg or {}
        local currentKey = cfg.Default or Enum.KeyCode.RightShift
        local waiting = false

        local row = new("Frame", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = Theme.itemBg,
            BorderSizePixel = 0,
            LayoutOrder = nextOrderIn(cat),
        }, cat.page)
        corner(6, row)

        new("TextLabel", {
            Size = UDim2.new(1, -110, 1, 0),
            Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1,
            Text = cfg.Text or "Keybind",
            TextColor3 = Theme.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Theme.fontMed,
            TextSize = 12,
        }, row)

        local keyBtn = new("TextButton", {
            Size = UDim2.new(0, 80, 0, 24),
            Position = UDim2.new(1, -94, 0.5, -12),
            BackgroundColor3 = Theme.inputBg,
            BorderSizePixel = 0,
            Text = currentKey.Name,
            TextColor3 = Theme.text,
            Font = Theme.fontMed,
            TextSize = 11,
            AutoButtonColor = false,
        }, row)
        corner(5, keyBtn)

        keyBtn.MouseButton1Click:Connect(function()
            waiting = true
            keyBtn.Text = "..."
            keyBtn.TextColor3 = Theme.accent
        end)

        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gp)
            if not waiting then return end
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                keyBtn.Text = currentKey.Name
                keyBtn.TextColor3 = Theme.text
                waiting = false
                if cfg.Callback then pcall(cfg.Callback, currentKey) end
            end
        end)

        refreshPage(cat)
        return {
            Get = function() return currentKey end,
        }
    end

    -- ==========================================
    -- Window API
    -- ==========================================
    local currentCatObj = {}

    function window:Category(name)
        local cat = createCategory(name)
        currentCatObj[name] = cat
        if not activeCategory then
            switchCategory(cat)
        end
        return {
            Section = function(_, text) return addSection(cat, text) end,
            Label = function(_, text, dim) return addLabel(cat, text, dim) end,
            Divider = function() addDivider(cat) end,
            Button = function(_, cfg) return addButton(cat, cfg) end,
            Toggle = function(_, cfg) return addToggle(cat, cfg) end,
            Slider = function(_, cfg) return addSlider(cat, cfg) end,
            Input = function(_, cfg) return addInput(cat, cfg) end,
            Dropdown = function(_, cfg) return addDropdown(cat, cfg) end,
            Keybind = function(_, cfg) return addKeybind(cat, cfg) end,
        }
    end

    function window:SelectCategory(name)
        local cat = currentCatObj[name]
        if cat then switchCategory(cat) end
    end

    -- ==========================================
    -- 最小化 / 恢复
    -- ==========================================
    local minimized = false

    local function minimize()
        if minimized then return end
        minimized = true
        local wp = main.Position
        ball.Position = UDim2.new(wp.X.Scale, wp.X.Offset, wp.Y.Scale, wp.Y.Offset)
        ball.Visible = true
        ball.Size = UDim2.new(0, 0, 0, 0)
        tween(ball, 0.2, { Size = UDim2.new(0, BALL_SIZE, 0, BALL_SIZE) }, Enum.EasingStyle.Back)

        tween(main, 0.2, { Size = UDim2.new(0, 0, 0, 0) })
        task.delay(0.2, function() main.Visible = false end)
    end

    local function restore()
        if not minimized then return end
        minimized = false
        tween(ball, 0.2, { Size = UDim2.new(0, 0, 0, 0) })
        task.delay(0.2, function() ball.Visible = false end)

        main.Visible = true
        main.Size = UDim2.new(0, 0, 0, 0)
        tween(main, 0.2, { Size = UDim2.new(0, W, 0, H) }, Enum.EasingStyle.Back)
    end

    minBtn.MouseButton1Click:Connect(minimize)
    attachDrag(ball, ball, restore)
    attachDrag(header, main)

    closeBtn.MouseButton1Click:Connect(function()
        main:Destroy()
        ball:Destroy()
    end)

    function window:Minimize() minimize() end
    function window:Restore() restore() end
    function window:Destroy() main:Destroy(); ball:Destroy() end
    function window:SetTitle(t)
        for _, c in ipairs(header:GetChildren()) do
            if c:IsA("TextLabel") and c.Text == titleText then
                c.Text = t
                titleText = t
                break
            end
        end
    end

    return window
end

