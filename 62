local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/refs/heads/main/dist/main.lua"))()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer

for _, p in ipairs({ player:FindFirstChild("PlayerGui"), game:GetService("CoreGui") }) do
    if p then pcall(function()
        local old = p:FindFirstChild("RemoteVehicleGui")
        if old then old:Destroy() end
    end) end
end

local Controller = {
    ControlledVehicle = nil,
    OriginalCameraSubject = nil,
    IsControlling = false,
    Speed = 300,
    Mode = "ground", -- 默认不飞天 (贴地跑)
    FlyThread = nil,
    HRP = nil,
    BV = nil, 
    AlignOrientation = nil, 
    OriginalReplicationFocus = player.ReplicationFocus,
}

local PlayerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
local Controls = PlayerModule:GetControls()

local function GetSortedVehicles()
    local vehiclesFolder = Workspace:FindFirstChild("Gameplay") and Workspace.Gameplay:FindFirstChild("Vehicles")
    if not vehiclesFolder then return {} end
    
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return {} end
    
    local myPos = myRoot.Position
    local list = {}
    
    for _, veh in ipairs(vehiclesFolder:GetChildren()) do
        if veh:IsA("Model") then
            local root = veh.PrimaryPart or veh:FindFirstChildWhichIsA("BasePart", true)
            if root then
                local dist = (root.Position - myPos).Magnitude
                table.insert(list, { Vehicle = veh, Name = veh.Name, Distance = dist })
            end
        end
    end
    
    table.sort(list, function(a, b) return a.Distance < b.Distance end)
    return list
end

-- ================= 核心物理与移动逻辑 =================
local function FlyMicroStepLoop()
    while Controller.IsControlling and Controller.HRP and Controller.HRP.Parent do
        local cam = workspace.CurrentCamera
        if not cam then break end
        local camCF = cam.CFrame
        
        -- 提取相机纯水平方向 (用于秒转)
        local camLook = camCF.LookVector
        local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
        if flatLook.Magnitude > 0.01 then
            flatLook = flatLook.Unit
        else
            flatLook = Vector3.new(0, 0, -1)
        end
        
        -- 读取左下角移动轮盘
        local mv = Controls:GetMoveVector()
        local driveDir = -mv.Z
        local strafeDir = mv.X
        
        -- 计算移动方向
        local moveDir = (camCF.LookVector * driveDir) + (camCF.RightVector * strafeDir)
        if moveDir.Magnitude > 1 then moveDir = moveDir.Unit end
        
        -- 🟢 应用速度逻辑 (区分飞天和地面)
        if Controller.BV then
            if Controller.Mode == "fly" then
                -- 飞天模式：朝准星方向飞（视角朝上就往上）
                Controller.BV.Velocity = moveDir * Controller.Speed
            else
                -- 不飞天模式：抹除 Y 轴，强制贴地跑
                local flatMove = Vector3.new(moveDir.X, 0, moveDir.Z)
                -- 稍微给一点向下的力，防止车子在马路上飘起来
                Controller.BV.Velocity = flatMove * Controller.Speed + Vector3.new(0, -5, 0) 
            end
        end
        
        -- 🟢 绝对秒转 & 防倾斜 (AlignOrientation)
        if Controller.AlignOrientation then
            local targetCF = CFrame.lookAt(Controller.HRP.Position, Controller.HRP.Position + flatLook)
            Controller.AlignOrientation.CFrame = targetCF
        end
        
        -- 强制保持网络所有权
        pcall(function() Controller.HRP:SetNetworkOwner(player) end)
        
        RunService.Heartbeat:Wait()
    end
end

local function StopControl()
    if not Controller.IsControlling then return end
    Controller.IsControlling = false
    
    if Controller.FlyThread then
        task.cancel(Controller.FlyThread)
        Controller.FlyThread = nil
    end
    
    if Controller.BV then Controller.BV:Destroy(); Controller.BV = nil end
    if Controller.AlignOrientation then Controller.AlignOrientation:Destroy(); Controller.AlignOrientation = nil end
    
    if Controller.OriginalReplicationFocus then
        player.ReplicationFocus = Controller.OriginalReplicationFocus
    end
    
    if Controller.OriginalCameraSubject then
        Workspace.CurrentCamera.CameraSubject = Controller.OriginalCameraSubject
    end
    
    if Controller.HRP then
        Controller.HRP.Anchored = false
    end
end

local function StartControl(vehicleModel)
    StopControl()
    
    if not vehicleModel or not vehicleModel.Parent then return false, "车辆不存在" end
    local root = vehicleModel.PrimaryPart or vehicleModel:FindFirstChildWhichIsA("BasePart", true)
    if not root then return false, "找不到车辆的主部件" end
    
    Controller.IsControlling = true
    Controller.ControlledVehicle = vehicleModel
    Controller.HRP = root
    
    -- 切换相机视角到车辆
    Controller.OriginalCameraSubject = Workspace.CurrentCamera.CameraSubject
    Workspace.CurrentCamera.CameraSubject = root
    
    -- 核心修复：把玩家的复制焦点设置为这辆车
    player.ReplicationFocus = root
    pcall(function() root:SetNetworkOwner(player) end)
    
    -- 物理运动组件
    Controller.BV = Instance.new("BodyVelocity")
    Controller.BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    Controller.BV.P = 1250
    Controller.BV.Velocity = Vector3.zero
    Controller.BV.Parent = root
    
    local att = Instance.new("Attachment")
    att.Parent = root
    
    Controller.AlignOrientation = Instance.new("AlignOrientation")
    Controller.AlignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    Controller.AlignOrientation.Attachment0 = att
    Controller.AlignOrientation.RigidityEnabled = true
    Controller.AlignOrientation.CFrame = root.CFrame
    Controller.AlignOrientation.Parent = root
    
    Controller.FlyThread = task.spawn(FlyMicroStepLoop)
    return true, "接管成功"
end

-- ================= 快捷开关 UI =================
local carFlyQuickScreenGui = nil
local carFlyQuickButton = nil
local carFlyQuickStrokeConn = nil
local lockCarFlyBtn = false
local currentSelectedVehicle = nil 

local function updateCarFlyStatus()
    if carFlyQuickButton then 
        carFlyQuickButton.Text = Controller.IsControlling and "车辆控制: 开" or "车辆控制: 关" 
    end
end

local function DestroyCarFlyQuickToggle()
    if carFlyQuickStrokeConn then carFlyQuickStrokeConn:Disconnect(); carFlyQuickStrokeConn = nil end
    if carFlyQuickScreenGui then carFlyQuickScreenGui:Destroy(); carFlyQuickScreenGui = nil; carFlyQuickButton = nil end
end

local function CreateCarFlyQuickToggle()
    if carFlyQuickButton then return end
    carFlyQuickScreenGui = Instance.new("ScreenGui")
    carFlyQuickScreenGui.Name = "CarFlyQuickToggle"
    carFlyQuickScreenGui.ResetOnSpawn = false
    carFlyQuickScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    carFlyQuickScreenGui.Parent = player:WaitForChild("PlayerGui")
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 115, 0, 46)
    button.Position = UDim2.new(0.5, -58, 0.3, 0)
    button.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
    button.BackgroundTransparency = 0.15
    button.BorderSizePixel = 0
    button.Text = Controller.IsControlling and "车辆控制: 开" or "车辆控制: 关"
    button.TextColor3 = Color3.fromHSV(0, 1, 1)
    button.TextSize = 14
    button.Font = Enum.Font.GothamBold
    button.Parent = carFlyQuickScreenGui
    carFlyQuickButton = button
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = button
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = Color3.fromHSV(0, 1, 1)
    stroke.Parent = button
    
    carFlyQuickStrokeConn = RunService.Heartbeat:Connect(function()
        if button and button.Parent then
            local hue = (tick() * 0.15) % 1
            stroke.Color = Color3.fromHSV(hue, 1, 1)
            button.TextColor3 = Color3.fromHSV((hue + 0.5) % 1, 1, 1)
        end
    end)
    
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if lockCarFlyBtn then return end
            dragging = true
            dragStart = input.Position
            startPos = button.Position
        end
    end)
    
    button.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    button.MouseButton1Click:Connect(function()
        if Controller.IsControlling then
            StopControl()
        else
            if currentSelectedVehicle and currentSelectedVehicle.Parent then
                StartControl(currentSelectedVehicle)
            else
                WindUI:Notify({ Title = "快捷控制", Content = "请在面板中先选择一辆车", Duration = 2 })
            end
        end
        updateCarFlyStatus()
    end)
    
    task.spawn(function()
        while carFlyQuickScreenGui and carFlyQuickScreenGui.Parent and button and button.Parent do
            task.wait(0.3)
            updateCarFlyStatus()
        end
    end)
end

-- ================= WindUI 界面 =================
local Window = WindUI:CreateWindow({
    Title = "远程控制车辆",
    Icon = "car",
    Author = "wdfex-Hub",
    Folder = "RemoteCar",
    Size = UDim2.fromOffset(400, 360),
    Theme = "Dark",
    Transparent = true,
})

local Tab = Window:Tab({ Title = "远程控制", Icon = "settings" })
local Section = Tab:Section({ Title = "选择车辆", Opened = true })

local vehicleNames = {}
local vehicleDataMap = {}

local function RefreshList()
    local sorted = GetSortedVehicles()
    vehicleNames = {}
    vehicleDataMap = {}
    for _, data in ipairs(sorted) do
        local displayName = data.Name .. " [" .. math.floor(data.Distance) .. "m]"
        table.insert(vehicleNames, displayName)
        vehicleDataMap[displayName] = data.Vehicle
    end
end

RefreshList()

local dropdown = Section:Dropdown({
    Title = "选择要控制的车辆",
    Values = vehicleNames,
    Value = vehicleNames[1],
    Callback = function(value)
        currentSelectedVehicle = vehicleDataMap[value]
    end
})

if vehicleNames[1] then currentSelectedVehicle = vehicleDataMap[vehicleNames[1]] end

Section:Button({
    Title = "刷新车辆列表",
    Callback = function()
        RefreshList()
        dropdown:Refresh(vehicleNames)
        WindUI:Notify({ Title = "提示", Content = "车辆列表已刷新", Duration = 2 })
    end
})

Section:Divider({ Text = "模式与速度" })

-- 🟢 按要求修改的模式选择下拉菜单
Section:Dropdown({
    Title = "模式选择",
    Values = {"不飞天", "飞天"},
    Value = "不飞天",
    Callback = function(value)
        Controller.Mode = (value == "飞天") and "fly" or "ground"
        -- 如果当前正在控制，重启控制以应用新物理
        if Controller.IsControlling and currentSelectedVehicle then
            StartControl(currentSelectedVehicle)
        end
    end
})

Section:Input({
    Title = "移动速度",
    Value = "300",
    Placeholder = "300",
    Callback = function(text)
        local n = tonumber(text)
        if n and n > 0 then
            Controller.Speed = n
        end
    end
})

Section:Divider({ Text = "开关控制" })

local controlToggle
controlToggle = Section:Toggle({
    Title = "远程控制车辆开关",
    Value = false,
    Callback = function(value)
        if value then
            if not currentSelectedVehicle or not currentSelectedVehicle.Parent then
                WindUI:Notify({ Title = "错误", Content = "请先选择一辆存在的车", Duration = 2 })
                controlToggle:SetValue(false)
                return
            end
            local ok, msg = StartControl(currentSelectedVehicle)
            if not ok then
                WindUI:Notify({ Title = "接管失败", Content = msg, Duration = 3 })
                controlToggle:SetValue(false)
            else
                WindUI:Notify({ Title = "成功", Content = "已接管车辆", Duration = 3 })
            end
        else
            StopControl()
            WindUI:Notify({ Title = "停止", Content = "已断开车辆控制", Duration = 2 })
        end
    end
})

Section:Divider({ Text = "快捷设置" })

Section:Toggle({
    Title = "车辆控制快捷开关",
    Value = false,
    Callback = function(value)
        if value then CreateCarFlyQuickToggle() else DestroyCarFlyQuickToggle() end
    end
})

Section:Toggle({
    Title = "锁定车辆控制快捷开关",
    Value = false,
    Callback = function(value)
        lockCarFlyBtn = value
    end
})