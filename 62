        -- Dropdown
        function api:Dropdown(cfg)
            cfg = cfg or {}

            local optionsList = cfg.Options or {}
            local current = cfg.Default

            if current == nil then
                current = optionsList[1] or ""
            end

            local isOpen = false
            local rowHeight = 42

            local outer = make("Frame", {
                Size = UDim2.new(1, 0, 0, rowHeight),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ClipsDescendants = false,
                LayoutOrder = nextOrder(cat),
                ZIndex = 10,
            }, page)

            local head = button(
                outer,
                "",
                UDim2.new(1, 0, 0, rowHeight)
            )

            head.BackgroundColor3 = Theme.Surface
            round(head, 9)
            stroke(head, Theme.Border, 0.2, 1)

            local titleLabel = label(
                head,
                cfg.Text or "Select option",
                10,
                Theme.Muted,
                Theme.Medium
            )

            titleLabel.Position = UDim2.new(0, 12, 0, 0)
            titleLabel.Size = UDim2.new(0.48, -12, 1, 0)

            local currentLabel = label(
                head,
                tostring(current),
                10,
                Theme.Text,
                Theme.Medium,
                Enum.TextXAlignment.Right
            )

            currentLabel.Position = UDim2.new(0.48, 0, 0, 0)
            currentLabel.Size = UDim2.new(0.45, -4, 1, 0)

            local arrow = label(
                head,
                "⌄",
                17,
                Theme.Accent,
                Theme.Medium,
                Enum.TextXAlignment.Center
            )

            arrow.Position = UDim2.new(1, -31, 0, 0)
            arrow.Size = UDim2.fromOffset(23, rowHeight)

            local list = make("ScrollingFrame", {
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.new(0, 0, 0, rowHeight + 5),
                BackgroundColor3 = Theme.Surface2,
                BorderSizePixel = 0,
                ScrollBarThickness = 3,
                ScrollBarImageColor3 = Theme.Accent,
                CanvasSize = UDim2.new(),
                Visible = false,
                ZIndex = 30,
            }, outer)

            round(list, 9)
            stroke(list, Theme.Border, 0, 1)
            padding(list, 5, 5, 5, 5)

            local listLayout = make("UIListLayout", {
                Padding = UDim.new(0, 3),
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, list)

            local function rebuildOptions()
                for _, child in ipairs(list:GetChildren()) do
                    if child:IsA("TextButton") then
                        child:Destroy()
                    end
                end

                for i, option in ipairs(optionsList) do
                    local item = button(
                        list,
                        tostring(option),
                        UDim2.new(1, 0, 0, 30)
                    )

                    item.LayoutOrder = i
                    item.TextXAlignment = Enum.TextXAlignment.Left
                    item.TextSize = 10

                    item.BackgroundColor3 = option == current
                        and Theme.AccentDeep
                        or Theme.Surface2

                    item.TextColor3 = option == current
                        and Theme.Accent
                        or Theme.Text

                    padding(item, 10, 0, 8, 0)
                    round(item, 6)

                    item.MouseEnter:Connect(function()
                        if option ~= current then
                            tween(item, 0.1, {
                                BackgroundColor3 = Theme.SurfaceHover,
                            })
                        end
                    end)

                    item.MouseLeave:Connect(function()
                        if option ~= current then
                            tween(item, 0.1, {
                                BackgroundColor3 = Theme.Surface2,
                            })
                        end
                    end)

                    item.MouseButton1Click:Connect(function()
                        current = option
                        currentLabel.Text = tostring(current)

                        isOpen = false
                        list.Visible = false

                        outer.Size = UDim2.new(1, 0, 0, rowHeight)
                        arrow.Text = "⌄"

                        rebuildOptions()

                        if cfg.Callback then
                            task.spawn(function()
                                cfg.Callback(current)
                            end)
                        end
                    end)
                end

                task.defer(function()
                    local contentHeight = listLayout.AbsoluteContentSize.Y + 10
                    list.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
                end)
            end

            rebuildOptions()

            head.MouseButton1Click:Connect(function()
                isOpen = not isOpen

                if isOpen then
                    list.Visible = true

                    local targetHeight = math.min(
                        #optionsList * 33 + 10,
                        cfg.MaxHeight or 150
                    )

                    list.Size = UDim2.new(1, 0, 0, 0)

                    tween(list, 0.17, {
                        Size = UDim2.new(1, 0, 0, targetHeight),
                    })

                    outer.Size = UDim2.new(
                        1, 0, 0,
                        rowHeight + targetHeight + 5
                    )

                    arrow.Text = "⌃"
                else
                    tween(list, 0.12, {
                        Size = UDim2.new(1, 0, 0, 0),
                    })

                    task.delay(0.13, function()
                        if list.Parent and not isOpen then
                            list.Visible = false
                        end
                    end)

                    outer.Size = UDim2.new(1, 0, 0, rowHeight)
                    arrow.Text = "⌄"
                end

                refreshPage(cat)
            end)

            refreshPage(cat)

            return {
                Set = function(_, value)
                    for _, option in ipairs(optionsList) do
                        if option == value then
                            current = value
                            currentLabel.Text = tostring(value)
                            rebuildOptions()
                            return
                        end
                    end
                end,

                Get = function()
                    return current
                end,

                Refresh = function(_, newOptions)
                    optionsList = newOptions or {}

                    if not table.find(optionsList, current) then
                        current = optionsList[1] or ""
                    end

                    currentLabel.Text = tostring(current)
                    rebuildOptions()
                end,

                Instance = outer,
            }
        end

        -- Keybind
        function api:Keybind(cfg)
            cfg = cfg or {}

            local currentKey = cfg.Default or Enum.KeyCode.RightShift
            local waiting = false

            local row = make("Frame", {
                Size = UDim2.new(1, 0, 0, 44),
                BackgroundColor3 = Theme.Surface,
                BorderSizePixel = 0,
                LayoutOrder = nextOrder(cat),
            }, page)

            round(row, 9)
            stroke(row, Theme.Border, 0.25, 1)

            local titleLabel = label(
                row,
                cfg.Text or "Keybind",
                11,
                Theme.Text,
                Theme.Medium
            )

            titleLabel.Position = UDim2.new(0, 13, 0, 0)
            titleLabel.Size = UDim2.new(1, -112, 1, 0)

            local keyButton = button(
                row,
                currentKey.Name,
                UDim2.fromOffset(82, 27),
                UDim2.new(1, -95, 0.5, -13.5)
            )

            keyButton.BackgroundColor3 = Theme.Input
            keyButton.TextSize = 10

            round(keyButton, 7)
            stroke(keyButton, Theme.Border, 0.1, 1)

            keyButton.MouseButton1Click:Connect(function()
                waiting = true
                keyButton.Text = "PRESS KEY"
                keyButton.TextColor3 = Theme.Accent
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if not waiting or processed then
                    return
                end

                if input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = input.KeyCode
                    waiting = false

                    keyButton.Text = currentKey.Name
                    keyButton.TextColor3 = Theme.Text

                    if cfg.Callback then
                        task.spawn(function()
                            cfg.Callback(currentKey)
                        end)
                    end
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                    waiting = false
                    keyButton.Text = currentKey.Name
                    keyButton.TextColor3 = Theme.Text
                end
            end)

            refreshPage(cat)

            return {
                Get = function()
                    return currentKey
                end,

                Set = function(_, keyCode)
                    if typeof(keyCode) == "EnumItem" then
                        currentKey = keyCode
                        keyButton.Text = currentKey.Name
                    end
                end,

                Instance = row,
            }
        end

        if not activeCategory then
            selectCategory(cat)
        end

        return api
    end

    --==================================================
    -- Public API
    --==================================================

    function window:Category(name, options)
        return createCategory(name, options)
    end

    function window:SelectCategory(name)
        selectCategory(categoryByName[name])
    end

    function window:Minimize()
        minimize()
    end

    function window:Restore()
        restore()
    end

    function window:Destroy()
        destroyAll()
    end

    function window:SetTitle(text)
        title.Text = tostring(text or "")
    end

    function window:SetSubtitle(text)
        sub.Text = tostring(text or "")
    end

    function window:GetGui()
        return gui
    end

    --==================================================
    -- Entrance animation
    --==================================================

    local targetPosition = main.Position

    main.Position = UDim2.new(
        targetPosition.X.Scale,
        targetPosition.X.Offset,
        targetPosition.Y.Scale,
        targetPosition.Y.Offset + 12
    )

    main.BackgroundTransparency = 1

    tween(main, 0.3, {
        Position = targetPosition,
        BackgroundTransparency = 0,
    }, Enum.EasingStyle.Quart)

    return window
end

return Library