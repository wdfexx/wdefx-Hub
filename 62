function Win:AddDropdown(tab, cfg)
    local name = cfg.Name or "Dropdown"
    local options = cfg.Options or {}
    local def = cfg.Default or options[1]
    local cb = cfg.Callback

    local item = Instance.new("Frame")
    item.Size = UDim2.new(1, 0, 0, T.ItemH)
    item.BackgroundColor3 = T.Card
    item.BackgroundTransparency = 0.5
    item.BorderSizePixel = 0
    item.ClipsDescendants = true
    item.ZIndex = 56
    item.Parent = tab.container
    U.corner(item, 12)
    U.stroke(item, T.Line, 1, 0.7)

    local lbl = U.txt(item, name, 12, T.Tx)
    lbl.Size = UDim2.new(1, -130, 0, T.ItemH)
    lbl.Position = UDim2.new(0, 16, 0, 0)
    lbl.ZIndex = 57

    local curLbl = U.txt(item, tostring(def) .. "  ⌄", 11, T.Acc, true, Enum.TextXAlignment.Right)
    curLbl.Size = UDim2.new(0, 100, 0, T.ItemH)
    curLbl.Position = UDim2.new(1, -116, 0, 0)
    curLbl.ZIndex = 57

    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, -16, 0, 0)
    list.Position = UDim2.new(0, 8, 0, T.ItemH)
    list.BackgroundTransparency = 1
    list.ZIndex = 57
    list.Parent = item

    local ll = Instance.new("UIListLayout")
    ll.Padding = UDim.new(0, 3)
    ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.Parent = list

    local expanded = false
    local cur = def

    for _, opt in ipairs(options) do
        local ob = Instance.new("TextButton")
        ob.Size = UDim2.new(1, 0, 0, 28)
        ob.BackgroundColor3 = T.CardHover
        ob.BackgroundTransparency = 0.4
        ob.Text = "   " .. tostring(opt)
        ob.TextColor3 = T.Tx
        ob.TextSize = 11
        ob.Font = Enum.Font.Gotham
        ob.TextXAlignment = Enum.TextXAlignment.Left
        ob.BorderSizePixel = 0
        ob.AutoButtonColor = false
        ob.ZIndex = 58
        ob.Parent = list
        U.corner(ob, 6)
        ob.MouseButton1Click:Connect(function()
            cur = opt
            curLbl.Text = tostring(opt) .. "  ⌄"
            if cb then cb(opt) end
            expanded = false
            U.tw(item, T.T2, {Size = UDim2.new(1, 0, 0, T.ItemH)}, Enum.EasingStyle.Quart)
        end)
    end

    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 0, T.ItemH)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.ZIndex = 59
    click.Parent = item

    click.MouseButton1Click:Connect(function()
        expanded = not expanded
        if expanded then
            U.tw(item, T.T2, {Size = UDim2.new(1, 0, 0, T.ItemH + #options * 31 + 6)}, Enum.EasingStyle.Quart)
        else
            U.tw(item, T.T2, {Size = UDim2.new(1, 0, 0, T.ItemH)}, Enum.EasingStyle.Quart)
        end
    end)

    return {
        Set = function(v)
            cur = v
            curLbl.Text = tostring(v) .. "  ⌄"
        end,
        Get = function() return cur end,
    }
end

