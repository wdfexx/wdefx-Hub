searchBox.FocusLost:Connect(function()
    local query = string.lower(searchBox.Text)
    if query == "" then return end
    for name in pairs(pages) do
        if string.find(string.lower(name), query, 1, true) then
            selectPage(name)
            return
        end
    end
end)

selectPage = function(name)
    if not pages[name] then return end
    selectedPage = name
    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
    end
    for pageName, item in pairs(navButtons) do
        local selected = pageName == name
        item.bar.Visible = selected
        item.title.TextColor3 = selected and Theme.Text or Theme.Muted
        item.icon.TextColor3 = selected and Theme.Text or Theme.Muted
        tween(item.button, 0.16, {
            BackgroundColor3 = selected and Theme.Blue2 or Theme.Surface,
            BackgroundTransparency = selected and 0 or 1,
        })
        if selected then
            local grad = item.button:FindFirstChildOfClass("UIGradient")
            if grad then grad:Destroy() end
            gradient(item.button, Theme.Purple2, Color3.fromRGB(25, 56, 130), 0)
        else
            local grad = item.button:FindFirstChildOfClass("UIGradient")
            if grad then grad:Destroy() end
        end
    end
end

