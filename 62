        navButton.LayoutOrder = #categories + 1
        navButton.BackgroundColor3 = Theme.Surface
        navButton.BackgroundTransparency = 1

        round(navButton, 9)

        local indicator = make("Frame", {
            Size = UDim2.new(0, 3, 0, 20),
            Position = UDim2.new(0, 0, 0.5, -10),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Visible = false,
        }, navButton)

        round(indicator, 3)

