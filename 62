        -- Slider
        function api:Slider(cfg)
            cfg = cfg or {}

            local minValue = cfg.Min or 0
            local maxValue = cfg.Max or 100
            local step = math.max(cfg.Step or 1, 0.000001)

            assert(
                maxValue > minValue,
                "Slider Max must be greater than Min"
            )

            local value = math.clamp(
                cfg.Default or minValue,
                minValue,
                maxValue
            )

            local dragging = false

            local row = make("Frame", {
                Size = UDim2.new(1, 0, 0, 63),
                BackgroundColor3 = Theme.Surface,
                BorderSizePixel = 0,
                LayoutOrder = nextOrder(cat),
            }, page)

            round(row, 9)
            stroke(row, Theme.Border, 0.28, 1)

            local titleLabel = label(
                row,
                cfg.Text or "Slider",
                11,
                Theme.Text,
                Theme.Medium
            )

            titleLabel.Position = UDim2.new(0, 13, 0, 7)
            titleLabel.Size = UDim2.new(1, -100, 0, 19)

            local valueLabel = label(
                row,
                tostring(value),
                11,
                Theme.Accent,
                Theme.Bold,
                Enum.TextXAlignment.Right
            )

            valueLabel.Position = UDim2.new(1, -82, 0, 7)
            valueLabel.Size = UDim2.fromOffset(68, 19)

            local track = make("Frame", {
                Size = UDim2.new(1, -28, 0, 5),
                Position = UDim2.new(0, 14, 0, 42),
                BackgroundColor3 = Theme.Input,
                BorderSizePixel = 0,
            }, row)

            round(track, 4)

            local fill = make("Frame", {
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = Theme.Accent,
                BorderSizePixel = 0,
            }, track)

            round(fill, 4)

            local knob = make("Frame", {
                Size = UDim2.fromOffset(13, 13),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, 0, 0.5, 0),
                BackgroundColor3 = Theme.Text,
                BorderSizePixel = 0,
            }, track)

            round(knob, 7)
            stroke(knob, Theme.Accent, 0, 1)

            local function render()
                local alpha = math.clamp(
                    (value - minValue) / (maxValue - minValue),
                    0,
                    1
                )

                fill.Size = UDim2.new(alpha, 0, 1, 0)
                knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                valueLabel.Text = tostring(value)
            end

            local function setFromX(x)
                local span = math.max(track.AbsoluteSize.X, 1)

                local alpha = math.clamp(
                    (x - track.AbsolutePosition.X) / span,
                    0,
                    1
                )

                local raw = minValue + alpha * (maxValue - minValue)

                value = math.clamp(
                    minValue
                        + math.floor((raw - minValue) / step + 0.5) * step,
                    minValue,
                    maxValue
                )

                render()

                if cfg.Callback then
                    task.spawn(function()
                        cfg.Callback(value)
                    end)
                end
            end

            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    setFromX(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    setFromX(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            render()
            refreshPage(cat)

            return {
                Set = function(_, v)
                    value = math.clamp(v, minValue, maxValue)
                    render()

                    if cfg.Callback then
                        task.spawn(function()
                            cfg.Callback(value)
                        end)
                    end
                end,

                Get = function()
                    return value
                end,

                Instance = row,
            }
        end

