    dot.Size = UDim2.new(0, 7, 0, 7)
    dot.Position = UDim2.new(0, 16, 0.5, -3.5)
    dot.BackgroundColor3 = Theme.Holo1
    dot.BorderSizePixel = 0
    dot.ZIndex = 22
    dot.Parent = self.island
    corner(dot, 4)
    -- 状态点呼吸
    TweenService:Create(dot, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
        BackgroundTransparency = 0.6,
    }):Play()

    --------------------------------------------------
    -- 主面板容器（带倾斜，做 3D 侧视角）
    --------------------------------------------------
    self.panelContainer = Instance.new("Frame")
    self.panelContainer.Name = "PanelContainer"
    self.panelContainer.Size = UDim2.new(0, Theme.PanelWidth + 20, 0, Theme.PanelHeight + 20)
    self.panelContainer.Position = UDim2.new(0.5, -(Theme.PanelWidth + 20) / 2, 0, 60)
    self.panelContainer.BackgroundTransparency = 1
    self.panelContainer.Rotation = 0  -- 倾斜放在内层做，避免拖动错位
    self.panelContainer.Visible = false
    self.panelContainer.ZIndex = 5
    self.panelContainer.Parent = self.gui

    -- 构建 3D 面板
    self.panel, self.shadow = build3DPanel(self.panelContainer, Theme.PanelWidth, Theme.PanelHeight, 12)

    -- 面板整体倾斜（3D 侧视角）
