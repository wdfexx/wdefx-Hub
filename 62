            Text = cfg.Text or "Toggle",
            TextColor3 = Theme.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Theme.fontMed,
            TextSize = 12,
        }, row)

        local track = new("Frame", {
            Size = UDim2.new(0, 38, 0, 20),
            Position = UDim2.new(1, -50, 0.5, -10),
            BackgroundColor3 = state and Theme.accent or Theme.inputBg,
            BorderSizePixel = 0,
        }, row)
        corner(10, track)

        local knob = new("Frame", {
            Size = UDim2.new(0, 14, 0, 14),
            Position = state and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
        }, track)
        corner(7, knob)

        local clicker = new("TextButton", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
        }, row)

        local function set(v)
            state = v
            tween(track, 0.15, { BackgroundColor3 = state and Theme.accent or Theme.inputBg })
            tween(knob, 0.15, {
                Position = state and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            })
            if cfg.Callback then pcall(cfg.Callback, state) end
        end

        clicker.MouseButton1Click:Connect(function() set(not state) end)

        refreshPage(cat)
        return {
            Set = set,
            Get = function() return state end,
            Instance = row,
        }
    end

    -- ---------- Slider ----------
    local function addSlider(cat, cfg)
        cfg = cfg or {}
        local minV = cfg.Min or 0
        local maxV = cfg.Max or 100
        local val = cfg.Default or minV
        local step = cfg.Step or 1

        local row = new("Frame", {
            Size = UDim2.new(1, 0, 0, 50),
            BackgroundColor3 = Theme.itemBg,
            BorderSizePixel = 0,
            LayoutOrder = nextOrderIn(cat),
        }, cat.page)
        corner(6, row)

        local label = new("TextLabel", {
            Size = UDim2.new(1, -20, 0, 16),
            Position = UDim2.new(0, 14, 0, 6),
            BackgroundTransparency = 1,
            Text = (cfg.Text or "Slider") .. ": " .. val,
            TextColor3 = Theme.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Theme.fontMed,
            TextSize = 11,
        }, row)

        local track = new("Frame", {
            Size = UDim2.new(1, -28, 0, 6),
            Position = UDim2.new(0, 14, 0, 32),
            BackgroundColor3 = Theme.inputBg,
            BorderSizePixel = 0,
        }, row)
        corner(3, track)

        local fill = new("Frame", {
            Size = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = Theme.accent,
            BorderSizePixel = 0,
        }, track)
        corner(3, fill)

        local knob = new("Frame", {
            Size = UDim2.new(0, 14, 0, 14),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            BackgroundColor3 = Theme.accentBright,
            BorderSizePixel = 0,
            ZIndex = 2,
        }, track)
        corner(7, knob)

        local function refresh()
            local t = (val - minV) / (maxV - minV)
            t = math.clamp(t, 0, 1)
            fill.Size = UDim2.new(t, 0, 1, 0)
            knob.Position = UDim2.new(t, 0, 0.5, 0)
            label.Text = (cfg.Text or "Slider") .. ": " .. math.floor(val)
        end

        local function setFromX(absX)
            local rel = (absX - track.AbsolutePosition.X) / track.AbsoluteSize.X
            rel = math.clamp(rel, 0, 1)
            val = minV + rel * (maxV - minV)
            val = math.floor(val / step + 0.5) * step
            refresh()
            if cfg.Callback then pcall(cfg.Callback, val) end
        end

        local dslider = false
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dslider = true
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not dslider then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dslider = false
            end
        end)

        refresh()
        refreshPage(cat)
        return {
            Set = function(v)
                val = math.clamp(v, minV, maxV)
                refresh()
                if cfg.Callback then pcall(cfg.Callback, val) end
            end,
            Get = function() return val end,
            Instance = row,
        }
    end

