            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.AccentSoft,
            CanvasSize = UDim2.new(),
            Visible = false,
            ZIndex = 3,
        }, pagesHost)

        padding(page, 22, 15, 22, 18)

        local pageLayout = make("UIListLayout", {
            Padding = UDim.new(0, 9),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)

        local cat = {
            name = name,
            description = options.Description,
            navButton = navButton,
            indicator = indicator,
            navLabel = navLabel,
            navIcon = navIcon,
            page = page,
            layout = pageLayout,
            order = 0,
        }

        table.insert(categories, cat)
        categoryByName[name] = cat

        navButton.MouseButton1Click:Connect(function()
            selectCategory(cat)
        end)

        navButton.MouseEnter:Connect(function()
            if activeCategory ~= cat then
                tween(navButton, 0.12, {
                    BackgroundTransparency = 0.45,
                    BackgroundColor3 = Theme.SurfaceHover,
                })
            end
        end)

        navButton.MouseLeave:Connect(function()
            if activeCategory ~= cat then
                tween(navButton, 0.12, {
                    BackgroundTransparency = 1,
                    BackgroundColor3 = Theme.Surface,
                })
            end
        end)

        local api = {}
        cat.api = api

        -- Section
        function api:Section(text)
            local section = label(
                page,
                string.upper(text or "SECTION"),
                10,
                Theme.Accent,
                Theme.Bold
            )

            section.Size = UDim2.new(1, 0, 0, 22)
            section.LayoutOrder = nextOrder(cat)

            refreshPage(cat)
            return section
        end

        -- Label
        function api:Label(text, dim)
            local item = label(
                page,
                text or "",
                11,
                dim and Theme.Muted or Theme.Text,
                Theme.Font
            )

            item.Size = UDim2.new(1, 0, 0, 23)
            item.LayoutOrder = nextOrder(cat)

            refreshPage(cat)
            return item
        end

        -- Divider
        function api:Divider()
            local line = make("Frame", {
                Size = UDim2.new(1, 0, 0, 1),
                BackgroundColor3 = Theme.Border,
                BorderSizePixel = 0,
                LayoutOrder = nextOrder(cat),
            }, page)

            refreshPage(cat)
            return line
        end

        -- Button
        function api:Button(cfg)
            cfg = cfg or {}

            local row = make("Frame", {
                Size = UDim2.new(1, 0, 0, 44),
                BackgroundColor3 = Theme.Surface,
                BorderSizePixel = 0,
                LayoutOrder = nextOrder(cat),
            }, page)

            round(row, 9)
            stroke(row, Theme.Border, 0.2, 1)

