        while self.gui.Parent do
            self.timeLabel.Text = os.date("%H:%M:%S")
            task.wait(1)
        end
    end)

    --=========================================
    -- 悬浮球拖拽 + 点击展开
    --=========================================
    local ballDrag = false
    local ballStart, ballPosStart
    local ballMoved = false

    table.insert(self.conns, self.ball.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            ballDrag = true
            ballMoved = false
            ballStart = input.Position
            ballPosStart = self.ball.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    ballDrag = false
                end
            end)
        end
    end))

    table.insert(self.conns, UserInputService.InputChanged:Connect(function(input)
        if ballDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - ballStart
            if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then ballMoved = true end
            self.ball.Position = UDim2.new(
                ballPosStart.X.Scale, ballPosStart.X.Offset + d.X,
                ballPosStart.Y.Scale, ballPosStart.Y.Offset + d.Y
            )
        end
    end))

    table.insert(self.conns, self.ball.MouseButton1Click:Connect(function()
        if not ballMoved then
            self:Toggle()
        end
    end))

    --=========================================
    -- 面板拖拽
    --=========================================
    local pDrag, pStart, pPos
    table.insert(self.conns, self.top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            pDrag = true
            pStart = input.Position
            pPos = self.panel.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then pDrag = false end
            end)
        end
    end))

    table.insert(self.conns, UserInputService.InputChanged:Connect(function(input)
        if pDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - pStart
            self.panel.Position = UDim2.new(
                pPos.X.Scale, pPos.X.Offset + d.X,
                pPos.Y.Scale, pPos.Y.Offset + d.Y
            )
        end
    end))

    -- 关闭按钮（折叠回球）
    table.insert(self.conns, closeBtn.MouseButton1Click:Connect(function()
        self:Toggle()
    end))

    -- 快捷键
    table.insert(self.conns, UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            self:Toggle()
        end
    end))

    -- 搜索框过滤
    table.insert(self.conns, searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        self:FilterItems(searchBox.Text)
    end))

    return self
end

--=====================================================
-- 展开 / 收起
--=====================================================
function Win:Toggle()
    self.opened = not self.opened
    if self.opened then
        self.panel.Visible = true
        self.panel.Position = UDim2.new(0, self.ball.Position.X.Offset + T.Ball, 0.5, -self.h / 2)
        U.tw(self.panel, T.T3, {
            Size = UDim2.new(0, self.w, 0, self.h),
        }, Enum.EasingStyle.Back)
        U.tw(self.ball, T.T2, {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, T.Ball - 20, 0, T.Ball - 20),
            Position = UDim2.new(0, self.ball.Position.X.Offset + 10, self.ball.Position.Y.Scale, self.ball.Position.Y.Offset + 10),
        })
    else
        U.tw(self.panel, T.T2, {
            Size = UDim2.new(0, 0, 0, 0),
        }, Enum.EasingStyle.Quart)
        U.tw(self.ball, T.T2, {
            BackgroundTransparency = 0.05,
            Size = UDim2.new(0, T.Ball, 0, T.Ball),
            Position = UDim2.new(0, self.ball.Position.X.Offset - 10, self.ball.Position.Y.Scale, self.ball.Position.Y.Offset - 10),
        }, Enum.EasingStyle.Back)
        task.delay(T.T2, function()
            if not self.opened then self.panel.Visible = false end
        end)
    end
end

--=====================================================
-- 创建分类（左侧图标）
--=====================================================
function Win:CreateTab(name, iconText)
    local tab = {}
    tab.name = name
    tab.icon = iconText or "•"
    tab.items = {}
    tab.window = self

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 40, 0, 40)
    btn.BackgroundColor3 = T.CardHover
    btn.BackgroundTransparency = 1
    btn.Text = tab.icon
    btn.TextColor3 = T.Tx2
    btn.TextSize = 18
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.ZIndex = 56
    btn.Parent = self.side
    U.corner(btn, 10)

    -- tooltip
    local tip = Instance.new("TextLabel")
    tip.Size = UDim2.new(0, 100, 0, 24)
    tip.Position = UDim2.new(1, 8, 0.5, -12)
    tip.BackgroundColor3 = T.Bg
    tip.BackgroundTransparency = 0.1
    tip.Text = name
    tip.TextColor3 = T.Tx
    tip.TextSize = 11
    tip.Font = Enum.Font.Gotham
    tip.BorderSizePixel = 0
    tip.ZIndex = 70
    tip.Visible = false
    tip.Parent = btn
    U.corner(tip, 6)
    U.stroke(tip, T.Line, 1, 0.5)

    -- 内容容器
    local container = Instance.new("ScrollingFrame")
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ScrollBarThickness = 3
    container.ScrollBarImageColor3 = T.Acc
    container.ScrollBarImageTransparency = 0.5
    container.CanvasSize = UDim2.new(0, 0, 0, 0)
    container.AutomaticCanvasSize = Enum.AutomaticSize.Y
    container.Visible = false
    container.ZIndex = 55
    container.Parent = self.content

    local lay = Instance.new("UIListLayout")
    lay.Padding = UDim.new(0, 8)
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Parent = container
    U.pad(container, 0, 8, 20, 0)

    tab.button = btn
    tab.tip = tip
    tab.container = container

    btn.MouseEnter:Connect(function()
        if self.current ~= tab then
            U.tw(btn, T.T1, {BackgroundTransparency = 0.6})
            U.tw(btn, T.T1, {TextColor3 = T.Tx})
        end
        tip.Visible = true
        tip.Position = UDim2.new(1, 8, 0.5, -12)
    end)
    btn.MouseLeave:Connect(function()
        if self.current ~= tab then
            U.tw(btn, T.T1, {BackgroundTransparency = 1})
            U.tw(btn, T.T1, {TextColor3 = T.Tx2})
        end
        tip.Visible = false
    end)
    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.tabs, tab)
    if #self.tabs == 1 then
        self:SelectTab(tab)
    end

    return tab
end

function Win:SelectTab(tab)
    for _, t in ipairs(self.tabs) do
        t.container.Visible = false
        U.tw(t.button, T.T1, {BackgroundTransparency = 1})
        U.tw(t.button, T.T1, {TextColor3 = T.Tx2})
    end
    tab.container.Visible = true
    U.tw(tab.button, T.T1, {BackgroundTransparency = 0.4, BackgroundColor3 = T.Acc})
    U.tw(tab.button, T.T1, {TextColor3 = Color3.fromRGB(255, 255, 255)})
    tab.container.Position = UDim2.new(0, 16, 0, 0)
    U.tw(tab.container, T.T2, {Position = UDim2.new(0, 0, 0, 0)})
    self.current = tab
end

--=====================================================
-- 搜索过滤
--=====================================================
function Win:FilterItems(text)
    text = text:lower()
    for _, tab in ipairs(self.tabs) do
        for _, child in ipairs(tab.container:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextButton") then
                local lbl = child:FindFirstChildWhichIsA("TextLabel", true)
                if lbl then
                    child.Visible = (text == "" or lbl.Text:lower():find(text) ~= nil)
                end
            end
        end
    end
end

--=====================================================
-- 开关
