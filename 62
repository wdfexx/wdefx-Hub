            navButton,
            options.Icon or "•",
            14,
            Theme.Dim,
            Theme.Bold,
            Enum.TextXAlignment.Center
        )

        navIcon.Position = UDim2.new(0, 9, 0, 0)
        navIcon.Size = UDim2.fromOffset(25, 39)

