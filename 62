        }, sidebar)
        corner(6, btn)

        local indicator = new("Frame", {
            Size = UDim2.new(0, 3, 0, 18),
            Position = UDim2.new(0, 0, 0.5, -9),
            BackgroundColor3 = Theme.accent,
            BorderSizePixel = 0, Visible = false, ZIndex = 4,
        }, btn)
        corner(2, indicator)

        local lbl = new("TextLabel", {
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.new(0, 16, 0, 0),
            BackgroundTransparency = 1, Text = name,
            TextColor3 = Theme.textDim, TextXAlignment = Enum.TextXAlignment.Left,
            Font = Theme.fontMed, TextSize = 12, ZIndex = 4,
        }, btn)
        new("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 1, Transparency = 0.2 }, lbl)

        local page = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 4, ScrollBarImageColor3 = Theme.accentDark,
            CanvasSize = UDim2.new(0, 0, 0, 0), Visible = false, ZIndex = 3,
        }, contentHolder)
        local pageLayout = new("UIListLayout", {
            Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)
        new("UIPadding", {
            PaddingTop = UDim.new(0, 14), PaddingLeft = UDim.new(0, 14),
            PaddingRight = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
        }, page)

        local cat = {
            name = name, btn = btn, indicator = indicator,
            label = lbl, page = page, layout = pageLayout, order = 0,
        }
        table.insert(categories, cat)

        btn.MouseButton1Click:Connect(function()
            if switchCategory then switchCategory(cat) end
        end)

        return cat
    end

    switchCategory = function(cat)
        if activeCategory == cat then return end
        for _, c in ipairs(categories) do
            if c == cat then
                c.page.Visible = true
                c.indicator.Visible = true
                tween(c.btn, 0.15, { BackgroundColor3 = Theme.accentDark, BackgroundTransparency = 0.6 })
                tween(c.label, 0.15, { TextColor3 = Theme.text })
