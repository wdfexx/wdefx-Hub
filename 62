    title.Size = UDim2.new(1, -49, 1, 0)
    navButtons[name] = {button = b, bar = bar, icon = icon, title = title}
    b.MouseButton1Click:Connect(function()
        if selectPage then selectPage(name) end
    end)
    b.MouseEnter:Connect(function()
        if selectedPage ~= name then
            tween(b, 0.12, {BackgroundTransparency = 0.42, BackgroundColor3 = Theme.Surface3})
        end
    end)
    b.MouseLeave:Connect(function()
        if selectedPage ~= name then
            tween(b, 0.12, {BackgroundTransparency = 1, BackgroundColor3 = Theme.Surface})
        end
    end)
end

