    -- ===== 最小化 / 恢复 =====
    local minimized = false
    local lastBallPosition = nil
    local function minimize()
        if minimized then return end
        minimized = true
        if lastBallPosition then
            ball.Position = lastBallPosition
        else
            local wp = main.Position
            ball.Position = UDim2.new(wp.X.Scale, wp.X.Offset, wp.Y.Scale, wp.Y.Offset)
        end
        ball.Visible = true
        ball.Size = UDim2.new(0, 0, 0, 0)
        tween(ball, 0.22, { Size = UDim2.new(0, BALL_SIZE, 0, BALL_SIZE) }, Enum.EasingStyle.Back)
        tween(main, 0.22, { Size = UDim2.new(0, 0, 0, 0) })
        task.delay(0.22, function() main.Visible = false end)
    end
    local function restore()
        if not minimized then return end
        minimized = false
        lastBallPosition = ball.Position
        tween(ball, 0.22, { Size = UDim2.new(0, 0, 0, 0) })
        task.delay(0.22, function() ball.Visible = false end)
        main.Visible = true
        main.Size = UDim2.new(0, 0, 0, 0)
        tween(main, 0.22, { Size = UDim2.new(0, W, 0, H) }, Enum.EasingStyle.Back)
    end
    minBtn.MouseButton1Click:Connect(minimize)
    attachDrag(ball, ball, restore, function(moved)
        if moved then lastBallPosition = ball.Position end
    end)
    attachDrag(header, main)
    closeBtn.MouseButton1Click:Connect(showCloseConfirm)

    function window:Minimize() minimize() end
    function window:Restore() restore() end
    function window:Destroy() main:Destroy(); ball:Destroy() end

    local catObjs = {}
    function window:Category(name)
        local cat = createCategory(name)
        catObjs[name] = cat
        if not activeCategory then switchCategory(cat) end
        return {
            Section = function(_, t) return addSection(cat, t) end,
            Label = function(_, t, d) return addLabel(cat, t, d) end,
            Divider = function() addDivider(cat) end,
            Button = function(_, c) return addButton(cat, c) end,
            Toggle = function(_, c) return addToggle(cat, c) end,
            Slider = function(_, c) return addSlider(cat, c) end,
            Input = function(_, c) return addInput(cat, c) end,
            Dropdown = function(_, c) return addDropdown(cat, c) end,
            Keybind = function(_, c) return addKeybind(cat, c) end,
        }
    end
    function window:SelectCategory(name)
        local cat = catObjs[name]
        if cat then switchCategory(cat) end
    end
    return window
end

return Library