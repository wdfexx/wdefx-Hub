    local function addSlider(cat, cfg)
        cfg = cfg or {}
        local minV, maxV = cfg.Min or 0, cfg.Max or 100
        if maxV <= minV then maxV = minV + 1 end
        local step = cfg.Step or 1
        local value = math.clamp(cfg.Default or minV, minV, maxV)
        local row = makeControlRow(cat, 66)
        local txt = label(row, cfg.Text or "Value", 11, Palette.Text, FONT_MED)
        txt.Position = UDim2.new(0, 15, 0, 7)
        txt.Size = UDim2.new(1, -90, 0, 18)
        local number = label(row, tostring(value), 11, Palette.PurpleLight, FONT_BOLD, Enum.TextXAlignment.Right)
        number.Position = UDim2.new(1, -74, 0, 7)
        number.Size = UDim2.new(0, 58, 0, 18)
        local track = make("Frame", {
            Size = UDim2.new(1, -30, 0, 5),
            Position = UDim2.new(0, 15, 0, 43),
            BackgroundColor3 = Palette.PanelSoft,
            BorderSizePixel = 0,
        }, row)
        round(track, 3)
        local fill = make("Frame", {
            Size = UDim2.new((value - minV) / (maxV - minV), 0, 1, 0),
            BackgroundColor3 = Palette.Purple,
            BorderSizePixel = 0,
        }, track)
        round(fill, 3)
        gradient(fill, Palette.PurpleLight, Palette.PurpleDeep)
        local knob = make("Frame", {
            Size = UDim2.new(0, 13, 0, 13),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new((value - minV) / (maxV - minV), 0, 0.5, 0),
            BackgroundColor3 = Palette.Text,
            BorderSizePixel = 0,
        }, track)
        round(knob, 7)
        stroke(knob, Palette.PurpleLight, 0.05, 1)
        local dragging = false
        local function setFromX(x, fire)
            local ratio = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            value = minV + ratio * (maxV - minV)
            value = math.clamp(math.floor(value / step + 0.5) * step, minV, maxV)
            ratio = (value - minV) / (maxV - minV)
            fill.Size = UDim2.new(ratio, 0, 1, 0)
            knob.Position = UDim2.new(ratio, 0, 0.5, 0)
            number.Text = tostring(value)
            if fire ~= false and cfg.Callback then pcall(cfg.Callback, value) end
        end
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                setFromX(input.Position.X)
            end
        end)
        table.insert(connections, UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                setFromX(input.Position.X)
            end
        end))
        table.insert(connections, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end))
        return {
            Set = function(v) setFromX(track.AbsolutePosition.X + math.clamp((v - minV) / (maxV - minV), 0, 1) * track.AbsoluteSize.X, false) end,
            Get = function() return value end,
            Instance = row,
        }
    end

