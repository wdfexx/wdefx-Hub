    self.tabBar.BorderSizePixel = 0
    self.tabBar.ZIndex = 15
    self.tabBar.Parent = self.panel
    corner(self.tabBar, 8)
    stroke(self.tabBar, Theme.Holo2, 1, 0.6)

    local tabLayout = Instance.new("UIListLayout")
