function Window:Notify(text, duration)
    duration = duration or 3
    local n = Instance.new("Frame")
    n.Size = UDim2.new(0, 260, 0, 50)
    n.Position = UDim2.new(1, 20, 0, 20)
    n.BackgroundColor3 = Theme.Glass
    n.BackgroundTransparency = 0.1
    n.BorderSizePixel = 0
    n.ZIndex = 100
    n.Parent = self.gui
    Util.corner(n, 12)
    Util.stroke(n, Color3.fromRGB(255, 255, 255), 1, 0.8)

    local accentBar = Instance.new("Frame")
    accentBar.Size = UDim2.new(0, 3, 0.6, 0)
    accentBar.Position = UDim2.new(0, 0, 0.5, -accentBar.Size.Y.Scale / 2)
    accentBar.BackgroundColor3 = Theme.Accent
    accentBar.BorderSizePixel = 0
    accentBar.ZIndex = 101
    accentBar.Parent = n
    Util.corner(accentBar, 2)
    Util.gradient(accentBar, Theme.Accent, Theme.Accent2, 90)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -24, 1, 0)
    lbl.Position = UDim2.new(0, 16, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Theme.Text
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    lbl.ZIndex = 101
    lbl.Parent = n

    -- 滑入
    Util.tween(n, Theme.Normal, { Position = UDim2.new(1, -280, 0, 20) }, Enum.EasingStyle.Back)
    -- 滑出
    task.delay(duration, function()
        Util.tween(n, Theme.Normal, { Position = UDim2.new(1, 20, 0, 20) }, Enum.EasingStyle.Quart)
        task.wait(Theme.Normal + 0.05)
        n:Destroy()
    end)
end

--=====================================================
-- 关闭
--=====================================================
function Window:Destroy()
    for _, c in ipairs(self.connections) do
        pcall(function() c:Disconnect() end)
    end
    if self.gui then self.gui:Destroy() end
end

return Window