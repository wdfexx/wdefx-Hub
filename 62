local FONT = Enum.Font.Gotham
local FONT_MED = Enum.Font.GothamMedium
local FONT_BOLD = Enum.Font.GothamBold

local function make(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function round(parent, radius)
    return make("UICorner", {
        CornerRadius = UDim.new(0, radius or 12),
    }, parent)
end

local function stroke(parent, color, transparency, thickness)
    return make("UIStroke", {
        Color = color or Palette.Border,
        Transparency = transparency == nil and 0.35 or transparency,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function padding(parent, left, top, right, bottom)
    return make("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
    }, parent)
end

local function gradient(parent, c1, c2, rotation)
    return make("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, c1 or Palette.Purple),
            ColorSequenceKeypoint.new(1, c2 or Palette.PurpleDeep),
        }),
        Rotation = rotation or 0,
    }, parent)
end

local function animate(obj, duration, props, style, direction)
    if not obj or not obj.Parent then return end
    local tw = TweenService:Create(obj, TweenInfo.new(
        duration or 0.18,
        style or Enum.EasingStyle.Quart,
        direction or Enum.EasingDirection.Out
    ), props)
    tw:Play()
    return tw
end

local function label(parent, text, size, color, font, xAlign)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(text or ""),
        TextColor3 = color or Palette.Text,
        Font = font or FONT,
        TextSize = size or 13,
        TextXAlignment = xAlign or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        RichText = false,
    }, parent)
end

local function button(parent, text, size, bg, fg)
    local b = make("TextButton", {
        Size = size,
        BackgroundColor3 = bg or Palette.PanelSoft,
        BorderSizePixel = 0,
        Text = text or "",
        TextColor3 = fg or Palette.Text,
        Font = FONT_MED,
        TextSize = 12,
        AutoButtonColor = false,
    }, parent)
    round(b, 9)
    return b
end

local function getGuiParent()
    local ok, hui = pcall(function()
        if typeof(gethui) == "function" then return gethui() end
        return nil
    end)
    if ok and hui then return hui end
    if not LocalPlayer then return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui") end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function attachDrag(handle, target)
    local dragging = false
    local dragStart
    local startPosition
    local activeInput

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = target.Position
            activeInput = input
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    activeInput = nil
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

local function createScroll(parent, props)
    local frame = make("ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Palette.Purple,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
    }, parent)
    for k, v in pairs(props or {}) do frame[k] = v end
    return frame
end

local function addListLayout(parent, gap)
    return make("UIListLayout", {
        Padding = UDim.new(0, gap or 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, parent)
end

local function setCanvasFromLayout(scroll, layout, extra)
    local function update()
        if scroll and scroll.Parent and layout and layout.Parent then
            scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + (extra or 20))
        end
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
    task.defer(update)
end

local function addGlow(parent, transparency)
    local glow = make("Frame", {
        Name = "AccentGlow",
        BackgroundColor3 = Palette.Purple,
        BackgroundTransparency = transparency or 0.9,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 0, 0),
    }, parent)
    gradient(glow, Palette.PurpleLight, Palette.PurpleDeep, 0)
    return glow
end

