--------------------------------------------------
-- 展开/折叠动画
--------------------------------------------------
function Window3D:_expand()
    if self.isExpanded then return end
    self.isExpanded = true

    self.islandFrame.Visible = false
    self.mainFrame.Visible = true
    self.shadow.Visible = true

    local tweenInfo = TweenInfo.new(UIConfig.AnimationSpeed, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    -- 主窗口展开
    TweenService:Create(self.mainFrame, tweenInfo, {
        Size = UDim2.new(0, self.windowWidth, 0, self.windowHeight),
    }):Play()

    -- 阴影同步
    TweenService:Create(self.shadow, tweenInfo, {
        Size = UDim2.new(0, self.windowWidth - 20, 0, 12),
        Position = UDim2.new(0, 10, 0, UIConfig.IslandTopOffset + UIConfig.IslandHeight + 6 + self.windowHeight - 4),
    }):Play()
end

function Window3D:_collapse()
    if not self.isExpanded then return end
    self.isExpanded = false

    self.islandFrame.Visible = true
    self.shadow.Visible = false

    local tweenInfo = TweenInfo.new(UIConfig.AnimationSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    TweenService:Create(self.mainFrame, tweenInfo, {
        Size = UDim2.new(0, self.windowWidth, 0, 10),
    }):Play()

    task.delay(UIConfig.AnimationSpeed, function()
        if not self.isExpanded then
            self.mainFrame.Visible = false
        end
    end)
end

--------------------------------------------------
-- 拖拽与点击交互
--------------------------------------------------
function Window3D:_bindInteractions()
    -- 灵动岛点击展开
    local islandClickConn = self.islandFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self:_expand()
        end
    end)
    table.insert(self.connections, islandClickConn)

    -- 主窗口拖拽
    local dragStart, startPos
    local dragConn = self.titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.isDragging = true
            dragStart = input.Position
            startPos = self.mainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    self.isDragging = false
                end
            end)
        end
    end)
    table.insert(self.connections, dragConn)

    local moveConn = UserInputService.InputChanged:Connect(function(input)
        if self.isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            self.mainFrame.Position = newPos

            local islandPos = UDim2.new(newPos.X.Scale, newPos.X.Offset + self.windowWidth / 2 - UIConfig.IslandWidth / 2, 0, UIConfig.IslandTopOffset)
            self.islandFrame.Position = islandPos
            self.shadow.Position = UDim2.new(newPos.X.Scale, newPos.X.Offset + 10, newPos.Y.Scale, newPos.Y.Offset + self.windowHeight - 4)
        end
    end)
    table.insert(self.connections, moveConn)

    -- 最小化按钮
    local minimizeConn = self.minimizeBtn.MouseButton1Click:Connect(function()
        self:_collapse()
    end)
    table.insert(self.connections, minimizeConn)

    -- 关闭按钮
    local closeConn = self.closeBtn.MouseButton1Click:Connect(function()
        self:destroy()
    end)
    table.insert(self.connections, closeConn)
end

--------------------------------------------------
-- 添加开关按钮
--------------------------------------------------
function Window3D:addToggle(name, defaultState, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = defaultState and UIConfig.AccentColor or Color3.fromRGB(45, 45, 60)
    btn.BackgroundTransparency = defaultState and 0.3 or 0.5
    btn.Text = name .. ": " .. (defaultState and "开" or "关")
    btn.TextColor3 = UIConfig.TextColor
    btn.TextSize = 12
    btn.Font = Enum.Font.Gotham
    btn.BorderSizePixel = 0
    btn.ZIndex = 7
    btn.Parent = self.contentFrame
    addCorner(btn, 8)

    local state = defaultState or false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = name .. ": " .. (state and "开" or "关")
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = state and UIConfig.AccentColor or Color3.fromRGB(45, 45, 60),
            BackgroundTransparency = state and 0.3 or 0.5,
        }):Play()
        if callback then callback(state) end
    end)
    return btn
end

--------------------------------------------------
-- 添加滑块
--------------------------------------------------
function Window3D:addSlider(name, min, max, default, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 52)
    container.BackgroundTransparency = 1
    container.ZIndex = 7
    container.Parent = self.contentFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 18)
    label.BackgroundTransparency = 1
    label.Text = name .. ": " .. default
    label.TextColor3 = UIConfig.SubTextColor
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 8
    label.Parent = container

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 30)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    track.BorderSizePixel = 0
    track.ZIndex = 8
    track.Parent = container
    addCorner(track, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = UIConfig.AccentColor
    fill.BorderSizePixel = 0
    fill.ZIndex = 9
    fill.Parent = track
    addCorner(fill, 3)

    -- 滑块拖动
    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local mouseX = input.Position.X
            local trackAbsX = track.AbsolutePosition.X
            local trackWidth = track.AbsoluteSize.X
            local ratio = math.clamp((mouseX - trackAbsX) / trackWidth, 0, 1)
            local value = math.floor(min + (max - min) * ratio)
            fill.Size = UDim2.new(ratio, 0, 1, 0)
            label.Text = name .. ": " .. value
            if callback then callback(value) end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

--------------------------------------------------
-- 添加文本标签
--------------------------------------------------
function Window3D:addLabel(text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 24)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = UIConfig.SubTextColor
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 7
    label.Parent = self.contentFrame
    return label
end

--------------------------------------------------
-- 销毁窗口
--------------------------------------------------
function Window3D:destroy()
    for _, conn in ipairs(self.connections) do
        conn:Disconnect()
    end
    self.screenGui:Destroy()
end

