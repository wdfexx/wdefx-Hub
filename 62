--[[
    Synaptix Dashboard UI
    A from-scratch Roblox Luau UI library inspired by the supplied dark-purple dashboard reference.
    No external UI library required.

    Example:
        local Synaptix = loadstring(...)()
        local Window = Synaptix.new({
            Title = "San Aurie",
            Subtitle = "CONTROL CENTER",
            Width = 980,
            Height = 620,
        })

        local General = Window:Category("General")
        General:Section("Quick controls")
        General:Toggle({ Text = "Example toggle", Default = true })
        General:Button({ Text = "Run action", Callback = function() print("clicked") end })
        General:Slider({ Text = "Intensity", Min = 0, Max = 100, Default = 50 })
        General:Dropdown({ Text = "Mode", Options = {"Balanced", "Fast", "Quiet"} })
        General:Input({ Text = "Player name", Placeholder = "Type here..." })
        General:Keybind({ Text = "Toggle UI", Default = Enum.KeyCode.RightShift })

    API:
        Window:Category(name)
        Window:SelectCategory(name)
        Window:Minimize()
        Window:Restore()
        Window:Destroy()

    Category controls:
        :Section(text), :Label(text, dim), :Divider(), :Button(config),
        :Toggle(config), :Slider(config), :Input(config), :Dropdown(config), :Keybind(config)
]]

