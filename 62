-- Framework API
local Aether = {}
Aether.Theme = Theme
Aether.Pages = {}
Aether.CurrentPage = nil

local pageOrder = 0
local selectedNav: TextButton? = nil

local function createPage(title: string, subtitle: string, iconText: string)
    pageOrder += 1

    local page = create("ScrollingFrame", {
        Name = title:gsub("%s+", "") .. "Page",
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, Content) :: ScrollingFrame

    padding(page, 22, 22, 20, 45)

    create("UIListLayout", {
        Padding = UDim.new(0, 13),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    local pageHeader = create("Frame", {
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundTransparency = 1,
        LayoutOrder = 1,
    }, page)

    local titleLabel = textLabel(pageHeader, title, 22, Theme.Text, true) :: TextLabel
    titleLabel.Size = UDim2.new(1, 0, 0, 30)

    local subtitleLabel = textLabel(pageHeader, subtitle, 10, Theme.Muted, false) :: TextLabel
    subtitleLabel.Position = UDim2.new(0, 1, 0, 32)
    subtitleLabel.Size = UDim2.new(1, 0, 0, 18)

    local nav = create("TextButton", {
        Name = title .. "Nav",
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        LayoutOrder = pageOrder,
    }, NavContainer) :: TextButton
    corner(nav, 10)

    local navIcon = textLabel(nav, iconText, 14, Theme.Muted, true) :: TextLabel
    navIcon.Position = UDim2.new(0, 12, 0, 0)
    navIcon.Size = UDim2.fromOffset(20, 39)
    navIcon.TextXAlignment = Enum.TextXAlignment.Center

    local navLabel = textLabel(nav, title, 11, Theme.Muted, true) :: TextLabel
    navLabel.Position = UDim2.new(0, 41, 0, 0)
    navLabel.Size = UDim2.new(1, -48, 1, 0)

    local navIndicator = create("Frame", {
        Position = UDim2.new(0, 0, 0.5, -9),
        Size = UDim2.fromOffset(3, 18),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, nav)
    corner(navIndicator, 3)

    local function selectPage()
        if Aether.CurrentPage == page then return end

        if Aether.CurrentPage then
            Aether.CurrentPage.Visible = false
        end

        if selectedNav then
            selectedNav.BackgroundTransparency = 1
            local oldIcon = selectedNav:FindFirstChild("NavIcon")
            local oldLabel = selectedNav:FindFirstChild("NavLabel")
            local oldIndicator = selectedNav:FindFirstChild("NavIndicator")
            if oldIcon and oldIcon:IsA("TextLabel") then oldIcon.TextColor3 = Theme.Muted end
            if oldLabel and oldLabel:IsA("TextLabel") then oldLabel.TextColor3 = Theme.Muted end
            if oldIndicator and oldIndicator:IsA("Frame") then
                oldIndicator.BackgroundTransparency = 1
            end
        end

        Aether.CurrentPage = page
        selectedNav = nav
        page.Visible = true
        page.CanvasPosition = Vector2.new(0, 0)
        page.Position = UDim2.new(0, 8, 0, 0)
        tween(page, {Position = UDim2.new(0, 0, 0, 0)}, 0.22)

        nav.BackgroundTransparency = 0
        nav.BackgroundColor3 = Theme.SurfaceRaised
        navIcon.TextColor3 = Theme.Accent
        navLabel.TextColor3 = Theme.Text
        navIndicator.BackgroundTransparency = 0
    end

    nav.Name = title .. "Nav"
    navIcon.Name = "NavIcon"
    navLabel.Name = "NavLabel"
    navIndicator.Name = "NavIndicator"

    nav.MouseButton1Click:Connect(selectPage)
    nav.MouseEnter:Connect(function()
        if selectedNav ~= nav then
            tween(nav, {BackgroundTransparency = 0.45}, 0.12)
        end
    end)
    nav.MouseLeave:Connect(function()
        if selectedNav ~= nav then
            tween(nav, {BackgroundTransparency = 1}, 0.12)
        end
    end)

    local pageApi = {
        Frame = page,
        Order = 0,
    }

    local function nextOrder()
        pageApi.Order += 1
        return pageApi.Order + 1
    end

    function pageApi:Section(sectionTitle: string, description: string?)
        local section = create("Frame", {
            Name = "Section",
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundTransparency = 1,
            LayoutOrder = nextOrder(),
        }, page)

        local sectionName = textLabel(section, string.upper(sectionTitle), 9, Theme.Accent, true) :: TextLabel
        sectionName.Size = UDim2.new(1, 0, 0, 16)

        local sectionDesc = textLabel(section, description or "", 9, Theme.Muted, false) :: TextLabel
        sectionDesc.Position = UDim2.new(0, 0, 0, 17)
        sectionDesc.Size = UDim2.new(1, 0, 0, 15)
        sectionDesc.Visible = description ~= nil and description ~= ""

        return section
    end

    function pageApi:Label(labelText: string, detail: string?)
        local card = create("Frame", {
            Name = "InfoLabel",
            Size = UDim2.new(1, 0, 0, detail and 62 or 42),
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,
            LayoutOrder = nextOrder(),
        }, page)
        corner(card, 11)
        stroke(card, Theme.Stroke, 0.7)
        padding(card, 14, 14, 8, 8)

        local mainText = textLabel(card, labelText, 11, Theme.Text, true) :: TextLabel
        mainText.Position = UDim2.new(0, 0, 0, detail and 5 or 0)
        mainText.Size = UDim2.new(1, 0, 0, 20)

        if detail then
            local detailText = textLabel(card, detail, 9, Theme.Muted, false) :: TextLabel
            detailText.Position = UDim2.new(0, 0, 0, 27)
            detailText.Size = UDim2.new(1, 0, 0, 18)
        end

        return card
    end

    function pageApi:Button(options)
        options = options or {}
        local buttonTitle = options.Name or "Action"
        local description = options.Description
        local callback = options.Callback or function() end

        local card = create("TextButton", {
            Name = "Button",
            Size = UDim2.new(1, 0, 0, description and 65 or 48),
            BackgroundColor3 = Theme.Surface,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = nextOrder(),
        }, page) :: TextButton
        corner(card, 11)
        stroke(card, Theme.Stroke, 0.7)

        local titleText = textLabel(card, buttonTitle, 11, Theme.Text, true) :: TextLabel
        titleText.Position = UDim2.new(0, 14, 0, description and 10 or 0)
        titleText.Size = UDim2.new(1, -62, 0, 20)

        if description then
            local descText = textLabel(card, description, 9, Theme.Muted, false) :: TextLabel
            descText.Position = UDim2.new(0, 14, 0, 32)
            descText.Size = UDim2.new(1, -65, 0, 16)
        end

        local action = create("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -13, 0.5, 0),
            Size = UDim2.fromOffset(28, 28),
            BackgroundColor3 = Color3.fromRGB(36, 58, 67),
            BorderSizePixel = 0,
        }, card)
        corner(action, 9)

        local arrow = textLabel(action, "›", 21, Theme.Accent, true) :: TextLabel
        arrow.Size = UDim2.fromScale(1, 1)
        arrow.TextXAlignment = Enum.TextXAlignment.Center

        card.MouseEnter:Connect(function()
            tween(card, {BackgroundColor3 = Theme.SurfaceHover}, 0.13)
            tween(action, {BackgroundColor3 = Color3.fromRGB(47, 79, 86)}, 0.13)
        end)
        card.MouseLeave:Connect(function()
            tween(card, {BackgroundColor3 = Theme.Surface}, 0.13)
            tween(action, {BackgroundColor3 = Color3.fromRGB(36, 58, 67)}, 0.13)
        end)
        card.MouseButton1Click:Connect(function()
            tween(action, {Size = UDim2.fromOffset(24, 24)}, 0.07)
            task.delay(0.08, function()
                if action.Parent then tween(action, {Size = UDim2.fromOffset(28, 28)}, 0.12) end
            end)
            local ok, err = pcall(callback)
            if not ok then warn("[Aether] Button callback error:", err) end
        end)

        return card
    end

    function pageApi:Toggle(options)
        options = options or {}
        local toggleName = options.Name or "Toggle"
        local description = options.Description
        local state = options.Default == true
        local callback = options.Callback or function() end

        local card = create("TextButton", {
            Name = "Toggle",
            Size = UDim2.new(1, 0, 0, description and 65 or 52),
            BackgroundColor3 = Theme.Surface,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = nextOrder(),
        }, page) :: TextButton
        corner(card, 11)
        stroke(card, Theme.Stroke, 0.7)

        local titleText = textLabel(card, toggleName, 11, Theme.Text, true) :: TextLabel
        titleText.Position = UDim2.new(0, 14, 0, description and 10 or 0)
        titleText.Size = UDim2.new(1, -80, 0, 20)

        if description then
            local descText = textLabel(card, description, 9, Theme.Muted, false) :: TextLabel
            descText.Position = UDim2.new(0, 14, 0, 32)
            descText.Size = UDim2.new(1, -80, 0, 16)
        end

        local switch = create("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -14, 0.5, 0),
            Size = UDim2.fromOffset(38, 22),
            BackgroundColor3 = state and Theme.AccentDeep or Color3.fromRGB(58, 64, 78),
            BorderSizePixel = 0,
        }, card)
        corner(switch, 12)

        local knob = create("Frame", {
            Position = state and UDim2.new(1, -19, 0.5, -7) or UDim2.new(0, 5, 0.5, -7),
            Size = UDim2.fromOffset(14, 14),
            BackgroundColor3 = Theme.Text,
            BorderSizePixel = 0,
        }, switch)
        corner(knob, 10)

        local function setState(value: boolean, fireCallback: boolean?)
            state = value
            tween(switch, {
                BackgroundColor3 = state and Theme.AccentDeep or Color3.fromRGB(58, 64, 78)
            }, 0.17)
            tween(knob, {
                Position = state and UDim2.new(1, -19, 0.5, -7) or UDim2.new(0, 5, 0.5, -7)
            }, 0.17)
            if fireCallback ~= false then
                local ok, err = pcall(callback, state)
                if not ok then warn("[Aether] Toggle callback error:", err) end
            end
        end

        card.MouseEnter:Connect(function()
            tween(card, {BackgroundColor3 = Theme.SurfaceHover}, 0.13)
        end)
        card.MouseLeave:Connect(function()
            tween(card, {BackgroundColor3 = Theme.Surface}, 0.13)
        end)
        card.MouseButton1Click:Connect(function()
            setState(not state)
        end)

        local api = {}
        function api:Set(value: boolean) setState(value) end
        function api:Get() return state end
        return api
    end

    function pageApi:Slider(options)
        options = options or {}
        local sliderName = options.Name or "Slider"
        local minValue = options.Min or 0
        local maxValue = options.Max or 100
        local increment = options.Increment or 1
        local value = math.clamp(options.Default or minValue, minValue, maxValue)
        local callback = options.Callback or function() end

        local card = create("Frame", {
            Name = "Slider",
            Size = UDim2.new(1, 0, 0, 76),
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,
            LayoutOrder = nextOrder(),
        }, page)
        corner(card, 11)
        stroke(card, Theme.Stroke, 0.7)
        padding(card, 14, 14, 10, 8)

        local titleText = textLabel(card, sliderName, 11, Theme.Text, true) :: TextLabel
        titleText.Position = UDim2.new(0, 0, 0, 0)
        titleText.Size = UDim2.new(1, -70, 0, 20)

        local valueText = textLabel(card, tostring(value), 10, Theme.Accent, true) :: TextLabel
        valueText.AnchorPoint = Vector2.new(1, 0)
        valueText.Position = UDim2.new(1, 0, 0, 0)
        valueText.Size = UDim2.fromOffset(65, 20)
        valueText.TextXAlignment = Enum.TextXAlignment.Right

        local track = create("Frame", {
            Position = UDim2.new(0, 0, 0, 42),
            Size = UDim2.new(1, 0, 0, 5),
            BackgroundColor3 = Color3.fromRGB(53, 61, 76),
            BorderSizePixel = 0,
        }, card)
        corner(track, 5)

        local fraction = (value - minValue) / math.max(maxValue - minValue, 0.0001)
        local fill = create("Frame", {
            Size = UDim2.new(fraction, 0, 1, 0),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
        }, track)
        corner(fill, 5)
        addGradient(fill, Theme.Accent, Theme.AccentAlt, 0)

        local knob = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(fraction, 0, 0.5, 0),
            Size = UDim2.fromOffset(13, 13),
            BackgroundColor3 = Theme.Text,
            BorderSizePixel = 0,
        }, track)
        corner(knob, 8)
        stroke(knob, Theme.Accent, 0.1)

        local draggingSlider = false
        local function setFromX(x: number)
            local width = track.AbsoluteSize.X
            if width <= 0 then return end
            local fractionNow = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
            local raw = minValue + (maxValue - minValue) * fractionNow
            value = math.clamp(math.floor(raw / increment + 0.5) * increment, minValue, maxValue)
            local rounded = math.floor(value * 100 + 0.5) / 100
            fractionNow = (value - minValue) / math.max(maxValue - minValue, 0.0001)
            valueText.Text = tostring(rounded)
            tween(fill, {Size = UDim2.new(fractionNow, 0, 1, 0)}, 0.07)
            tween(knob, {Position = UDim2.new(fractionNow, 0, 0.5, 0)}, 0.07)
            local ok, err = pcall(callback, rounded)
            if not ok then warn("[Aether] Slider callback error:", err) end
        end

        local hitArea = create("TextButton", {
            Position = UDim2.new(0, -4, 0, 31),
            Size = UDim2.new(1, 8, 0, 27),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
        }, card)

        hitArea.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
                setFromX(input.Position.X)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                setFromX(input.Position.X)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)

        local api = {}
        function api:Set(newValue: number)
            value = math.clamp(newValue, minValue, maxValue)
            local fractionNow = (value - minValue) / math.max(maxValue - minValue, 0.0001)
            valueText.Text = tostring(value)
            fill.Size = UDim2.new(fractionNow, 0, 1, 0)
            knob.Position = UDim2.new(fractionNow, 0, 0.5, 0)
            callback(value)
        end
        function api:Get() return value end
        return api
    end

    function pageApi:Dropdown(options)
        options = options or {}
        local dropdownName = options.Name or "Dropdown"
        local choices = options.Options or {"Option 1", "Option 2"}
        local selected = options.Default or choices[1] or "None"
        local callback = options.Callback or function() end
        local expanded = false

        local wrap = create("Frame", {
            Name = "DropdownWrap",
            Size = UDim2.new(1, 0, 0, 50),
            BackgroundTransparency = 1,
            ClipsDescendants = false,
            LayoutOrder = nextOrder(),
        }, page)

        local card = create("TextButton", {
            Name = "Dropdown",
            Size = UDim2.new(1, 0, 0, 50),
            BackgroundColor3 = Theme.Surface,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
        }, wrap) :: TextButton
        corner(card, 11)
        stroke(card, Theme.Stroke, 0.7)

        local titleText = textLabel(card, dropdownName, 11, Theme.Text, true) :: TextLabel
        titleText.Position = UDim2.new(0, 14, 0, 5)
        titleText.Size = UDim2.new(0.52, 0, 0, 18)

        local selectedText = textLabel(card, tostring(selected), 9, Theme.Accent, true) :: TextLabel
        selectedText.AnchorPoint = Vector2.new(1, 0)
        selectedText.Position = UDim2.new(1, -38, 0, 5)
        selectedText.Size = UDim2.new(0.4, 0, 0, 18)
        selectedText.TextXAlignment = Enum.TextXAlignment.Right
        selectedText.TextTruncate = Enum.TextTruncate.AtEnd

        local arrow = textLabel(card, "⌄", 16, Theme.Muted, true) :: TextLabel
        arrow.AnchorPoint = Vector2.new(1, 0)
        arrow.Position = UDim2.new(1, -12, 0, 3)
        arrow.Size = UDim2.fromOffset(18, 20)
        arrow.TextXAlignment = Enum.TextXAlignment.Center

        local optionList = create("Frame", {
            Position = UDim2.new(0, 0, 0, 54),
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = Theme.SurfaceRaised,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            ZIndex = 20,
            Visible = true,
        }, wrap)
        corner(optionList, 10)
        stroke(optionList, Theme.Stroke, 0.25)

        local optionLayout = create("UIListLayout", {
            Padding = UDim.new(0, 3),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, optionList)
        padding(optionList, 5, 5, 5, 5)

        local optionButtons = {}

        local function collapse()
            expanded = false
            tween(optionList, {Size = UDim2.new(1, 0, 0, 0)}, 0.16)
            tween(arrow, {Rotation = 0}, 0.16)
            task.delay(0.17, function()
                if not expanded and wrap.Parent then
                    wrap.Size = UDim2.new(1, 0, 0, 50)
                    optionList.Visible = true
                end
            end)
        end

        local function expand()
            expanded = true
            wrap.Size = UDim2.new(1, 0, 0, 54 + math.min(#choices, 5) * 29)
            optionList.Visible = true
            tween(optionList, {Size = UDim2.new(1, 0, 0, math.min(#choices, 5) * 29 + 10)}, 0.18)
            tween(arrow, {Rotation = 180}, 0.16)
        end

        local function choose(option)
            selected = option
            selectedText.Text = tostring(option)
            collapse()
            local ok, err = pcall(callback, option)
            if not ok then warn("[Aether] Dropdown callback error:", err) end
        end

        for index, option in ipairs(choices) do
            local optionButton = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 26),
                BackgroundColor3 = Theme.SurfaceRaised,
                BackgroundTransparency = 1,
                Text = tostring(option),
                TextColor3 = Theme.Muted,
                TextSize = 10,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                LayoutOrder = index,
                ZIndex = 21,
            }, optionList) :: TextButton
            corner(optionButton, 7)
            padding(optionButton, 9, 8, 0, 0)

            optionButton.MouseEnter:Connect(function()
                tween(optionButton, {BackgroundTransparency = 0, TextColor3 = Theme.Text}, 0.1)
            end)
            optionButton.MouseLeave:Connect(function()
                tween(optionButton, {BackgroundTransparency = 1, TextColor3 = Theme.Muted}, 0.1)
            end)
            optionButton.MouseButton1Click:Connect(function()
                choose(option)
            end)
            table.insert(optionButtons, optionButton)
        end

        card.MouseButton1Click:Connect(function()
            if expanded then collapse() else expand() end
        end)

        local api = {}
        function api:Set(option)
            if table.find(choices, option) then
                selected = option
                selectedText.Text = tostring(option)
                callback(option)
            end
        end
        function api:Get() return selected end
        function api:Refresh(newChoices)
            choices = newChoices
            for _, button in ipairs(optionButtons) do
                button:Destroy()
            end
            table.clear(optionButtons)
            for index, option in ipairs(choices) do
                local optionButton = create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 26),
                    BackgroundColor3 = Theme.SurfaceRaised,
                    BackgroundTransparency = 1,
                    Text = tostring(option),
                    TextColor3 = Theme.Muted,
                    TextSize = 10,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    LayoutOrder = index,
                    ZIndex = 21,
                }, optionList) :: TextButton
                corner(optionButton, 7)
                padding(optionButton, 9, 8, 0, 0)
                optionButton.MouseButton1Click:Connect(function() choose(option) end)
                table.insert(optionButtons, optionButton)
            end
        end
        return api
    end

    Aether.Pages[title] = pageApi
    if not Aether.CurrentPage then
        selectPage()
    end

    return pageApi
end

function Aether:CreatePage(title: string, subtitle: string?, iconText: string?)
    return createPage(title, subtitle or "Manage your preferences and controls.", iconText or "•")
end

function Aether:SetStatus(text: string, color: Color3?)
    StatusText.Text = string.upper(text)
    if color then StatusDot.BackgroundColor3 = color end
end

function Aether:Destroy()
    if ScreenGui then ScreenGui:Destroy() end
end

