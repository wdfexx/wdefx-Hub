local interactConn = nil
local function ApplyInteractDistance(value) 
    for _, obj in ipairs(Workspace:GetDescendants()) do 
        if obj:IsA("ProximityPrompt") then obj.MaxActivationDistance = value end 
    end 
end

local function applyInteractDist(state)
    Settings.interactDistanceEnabled = state
    SaveConfig()
    if state then 
        ApplyInteractDistance(30)
        if interactConn then interactConn:Disconnect() end
        interactConn = Workspace.DescendantAdded:Connect(function(obj) 
            task.wait(0.1)
            if obj:IsA("ProximityPrompt") then obj.MaxActivationDistance = 30 end 
        end)
    else 
        if interactConn then interactConn:Disconnect(); interactConn = nil end
        ApplyInteractDistance(10) 
    end 
end
