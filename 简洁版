local function BuyItem(arg, arg2, arg3, arg4)
    local stuff = ReplicatedStorage:FindFirstChild("Stuff")
    if not stuff then return false, "未找到 Stuff" end
    for _, part in ipairs(string.split(arg, "/")) do
        stuff = stuff:FindFirstChild(part)
        if not stuff then return false, "路径缺失: " .. part end
    end
    local v2 = stuff:FindFirstChild(arg2)
    if not v2 then return false, "物品不存在" end
    local playerFunc = ReplicatedStorage:FindFirstChild("Remote") and ReplicatedStorage.Remote:FindFirstChild("PlayerFunc")
    if not playerFunc then return false, "找不到 PlayerFunc" end
    local response = playerFunc:InvokeServer("purchase", { isRestaurant = arg4, item = v2, quantity = arg3, color = nil })
    return response == true, tostring(response)
end

