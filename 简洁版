local namecall
pcall(function()
    local mt = getrawmetatable(game)
    namecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if Settings.noFallDamage and method == "FireServer" and tostring(self) == "PlayerEvent" and args[1] == "takeDamage" then 
            return nil 
        end
        return namecall(self, ...)
    end)
    setreadonly(mt, true)
end)

