-- 提取核心伤害模块
local FL_DMG = {
    Enabled = true, RayMode = "near", LeadStuds = 1.5, FallbackDamage = 5, SendBullet = true, LastErr = nil, LastDist = nil
}
local FL_TRACK = {
    Enabled = false, Full360 = true, FOV = 200, MaxDist = 99999, Mode = "all", CombatOnly = true, ForceHit = true, ForceRate = 0.12, ShowCircle = true, ShowLine = true, Color = Color3.fromRGB(255, 90, 90), Target = nil, _acc = 0, _conn = nil
}

local function getPlayerEvent()
    local r = ReplicatedStorage:FindFirstChild("Remote")
    local ev = r and r:FindFirstChild("PlayerEvent")
    if ev and ev:IsA("RemoteEvent") then return ev end
    return nil
end

local function getEquippedWeapon()
    local char = player.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then return tool end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("ModuleScript") and d.Name == "Config" then return d.Parent end
    end
    return nil
end

function FL_DMG.Hit(target, opts)
    if not FL_DMG.Enabled or not target then return false end
    opts = opts or {}
    local rem = getPlayerEvent()
    if not rem then FL_DMG.LastErr = "没有 PlayerEvent" return false end

    local char = typeof(target) == "Instance" and target:IsA("Player") and target.Character or target
    if not char or not char.Parent then FL_DMG.LastErr = "目标没有角色" return false end

    local part = char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    if not part then FL_DMG.LastErr = "找不到可打部位" return false end

    local pos = opts.pos or part.Position
    local cam = workspace.CurrentCamera
    local origin = cam and cam.CFrame.Position or (player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position) or Vector3.new(0,0,0)
    local dir = (pos - origin)
    if dir.Magnitude > 0.01 then dir = dir.Unit else dir = Vector3.new(0,0,-1) end

    if FL_DMG.RayMode == "near" then
        origin = pos - dir * FL_DMG.LeadStuds
    end

    local w = getEquippedWeapon()
    if FL_DMG.SendBullet and w then
        pcall(function() rem:FireServer("bullet", { pos = pos, posDestroyX = pos.X, weaponName = w.Name }) end)
    end

    local payload = {
        bodyParts = { { "Head", 1 } },
        shotCode = { origin, dir },
        pos = pos,
        target = (typeof(target) == "Instance" and target:IsA("Player")) and target or nil,
        damageFactor = 1.5
    }
    if not payload.target then payload.target = target end

    local ok = pcall(function() rem:FireServer("damage", payload) end)
    if not ok then FL_DMG.LastErr = "FireServer 失败" return false end
    FL_DMG.LastErr = nil
    return true
end

