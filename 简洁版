local trackGui = nil
local circle, stroke, line = nil, nil, nil

local function buildTrackGui()
    if trackGui and trackGui.Parent then return end
    trackGui = Instance.new("ScreenGui")
    trackGui.Name = "FL_Track"
    trackGui.IgnoreGuiInset = true
    trackGui.ResetOnSpawn = false
    trackGui.DisplayOrder = 2
    trackGui.Parent = player:WaitForChild("PlayerGui")

    circle = Instance.new("Frame")
    circle.AnchorPoint = Vector2.new(0.5, 0.5)
    circle.Position = UDim2.fromScale(0.5, 0.5)
    circle.BackgroundTransparency = 1
    circle.Visible = false
    circle.Parent = trackGui
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)
    stroke = Instance.new("UIStroke", circle); stroke.Thickness = 1; stroke.Transparency = 0.35

    line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0, 0.5)
    line.BorderSizePixel = 0
    line.Visible = false
    line.ZIndex = 3
    line.Parent = trackGui
end

local function getFOVPx()
    local cam = workspace.CurrentCamera
    local h = cam and cam.ViewportSize.Y or 1080
    return FL_TRACK.FOV * (h / 1080)
end

local function findTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local camPos = cam.CFrame.Position
    local r = getFOVPx()
    local best, bestD = nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local c = plr.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local pass = true
                if FL_TRACK.CombatOnly and plr:GetAttribute("CombatMode") ~= true then pass = false end
                local f = plr.Team and plr.Team.Name or "?"
                if FL_TRACK.Mode == "police" and f ~= "Police" then pass = false end
                if FL_TRACK.Mode == "civilian" and f ~= "Civilian" then pass = false end

                if pass then
                    local part = c:FindFirstChild("Head") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("HumanoidRootPart")
                    if part then
                        local dist = (part.Position - camPos).Magnitude
                        if dist <= FL_TRACK.MaxDist then
                            local sp = cam:WorldToViewportPoint(part.Position)
                            local metric
                            if FL_TRACK.Full360 then
                                metric = dist
                            elseif sp.Z > 0 then
                                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                if d <= r then metric = d end
                            end
                            if metric and metric < bestD then
                                bestD = metric
                                best = { plr = plr, part = part, world = part.Position, screen = Vector2.new(sp.X, sp.Y), dist = dist }
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function drawTrack(target)
    buildTrackGui()
    if not trackGui then return end
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(0, 0)
    local center = Vector2.new(vp.X / 2, vp.Y / 2)

    if circle then
        circle.Visible = FL_TRACK.Enabled and FL_TRACK.ShowCircle and not FL_TRACK.Full360 and target ~= nil
        if circle.Visible then
            local rr = getFOVPx()
            circle.Size = UDim2.fromOffset(rr * 2, rr * 2)
            stroke.Color = FL_TRACK.Color
        end
    end
    if line then
        line.Visible = false
        if FL_TRACK.Enabled and FL_TRACK.ShowLine and target and target.screen then
            local d = target.screen - center
            local len = d.Magnitude
            if len >= 1 then
                line.Position = UDim2.fromOffset(center.X, center.Y)
                line.Size = UDim2.fromOffset(len, 1)
                line.Rotation = math.deg(math.atan2(d.Y, d.X))
                line.BackgroundColor3 = FL_TRACK.Color
                line.Visible = true
            end
        end
    end
end

local function stepTrack(dt)
    if not FL_TRACK.Enabled then
        FL_TRACK.Target = nil
        drawTrack(nil)
        return
    end
    local t = findTarget()
    FL_TRACK.Target = t
    drawTrack(t)

    if t and FL_TRACK.ForceHit and FL_DMG then
        FL_TRACK._acc = FL_TRACK._acc + dt
        local rate = tonumber(FL_TRACK.ForceRate) or 0.12
        if rate < 0.05 then rate = 0.05 end
        if FL_TRACK._acc >= rate then
            FL_TRACK._acc = 0
            pcall(FL_DMG.Hit, t.plr)
        end
    end
end

