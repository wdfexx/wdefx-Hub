local tbl27 = {}
local tbl21 = {
    ["红色"] = Color3.fromRGB(255, 0, 0), ["蓝色"] = Color3.fromRGB(0, 0, 255), ["黄色"] = Color3.fromRGB(255, 255, 0),
    ["绿色"] = Color3.fromRGB(0, 255, 0), ["青色"] = Color3.fromRGB(0, 255, 255), ["橙色"] = Color3.fromRGB(255, 165, 0),
    ["紫色"] = Color3.fromRGB(128, 0, 128), ["白色"] = Color3.fromRGB(255, 255, 255), ["黑色"] = Color3.fromRGB(0, 0, 0)
}

local function fn38(n11) n11 = n11 or 5 return Color3.fromHSV(tick() % n11 / n11, 1, 1) end
local function fn39(colorName) if colorName == "彩虹色" then return fn38(5) end return tbl21[colorName] or Color3.fromRGB(255, 0, 0) end

local function fn91(character)
    local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    if not tbl27[humanoidRootPart] then
        tbl27[humanoidRootPart] = { Size = humanoidRootPart.Size, Transparency = humanoidRootPart.Transparency, Material = humanoidRootPart.Material, CanCollide = humanoidRootPart.CanCollide, Color = humanoidRootPart.Color }
    end
    if not Settings.range_active then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if Settings.range_checkCorpses and humanoid and humanoid.Health <= 0 then return end
    local size = Settings.range_size
    if Settings.range_pulse then size *= math.sin(tick() * 2) * 0.2 + 1 end
    humanoidRootPart.Size = Vector3.new(size, size, size)
    humanoidRootPart.Transparency = Settings.range_transparency
    humanoidRootPart.Material = Enum.Material[Settings.range_material] or Enum.Material.Neon
    humanoidRootPart.CanCollide = Settings.range_collision
    humanoidRootPart.Color = Settings.range_rainbow and fn38(5) or fn39(Settings.range_color)
    if Settings.range_outline then
        local hl = humanoidRootPart:FindFirstChild("PY_HitboxHighlight") or Instance.new("Highlight")
        hl.Name = "PY_HitboxHighlight"; hl.FillTransparency = 1; hl.OutlineColor = humanoidRootPart.Color; hl.OutlineTransparency = Settings.range_transparency; hl.Parent = humanoidRootPart
    else
        local hl = humanoidRootPart:FindFirstChild("PY_HitboxHighlight"); if hl then hl:Destroy() end
    end
    if Settings.range_glow then
        local light = humanoidRootPart:FindFirstChild("PY_HitboxLight") or Instance.new("PointLight")
        light.Name = "PY_HitboxLight"; light.Brightness = 5; light.Range = 15; light.Color = humanoidRootPart.Color; light.Parent = humanoidRootPart
    else
        local light = humanoidRootPart:FindFirstChild("PY_HitboxLight"); if light then light:Destroy() end
    end
end

local function fn92(character)
    local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    local original = tbl27[humanoidRootPart]
    if original then
        humanoidRootPart.Size = original.Size; humanoidRootPart.Transparency = original.Transparency
        humanoidRootPart.Material = original.Material; humanoidRootPart.CanCollide = original.CanCollide
        humanoidRootPart.Color = original.Color; tbl27[humanoidRootPart] = nil
        local hl = humanoidRootPart:FindFirstChild("PY_HitboxHighlight"); if hl then hl:Destroy() end
        local light = humanoidRootPart:FindFirstChild("PY_HitboxLight"); if light then light:Destroy() end
    end
end

