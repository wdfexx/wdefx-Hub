local function initQuickInteract()
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then descendant.HoldDuration = 0 end
    end
end

local quickInteractConn = nil
local function applyQuickInteract(state)
    Settings.quickInteract = state
    SaveConfig()
    if state then
        initQuickInteract()
        if quickInteractConn then quickInteractConn:Disconnect() end
        quickInteractConn = Workspace.DescendantAdded:Connect(function(descendant) 
            if descendant:IsA("ProximityPrompt") then descendant.HoldDuration = 0 end 
        end)
    else 
        if quickInteractConn then quickInteractConn:Disconnect(); quickInteractConn = nil end 
