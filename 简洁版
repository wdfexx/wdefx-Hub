        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            if not lockWindowBtn then windowDragging = true; windowDragStart = input.Position; windowStartPos = button.Position end 
        end 
