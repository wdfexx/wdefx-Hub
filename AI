-- ============================================================
-- 5. 透视（ESP）实现
-- ============================================================
local espEnabled = false
local espObjects = {} -- [player] = {box, name, highlight}
local espConnection = nil

local function CreateESPForPlayer(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end

    local box = Instance.new("BoxHandleAdornment")
    box.Name = "LierESP_Box"
    box.Adornee = nil
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Size = Vector3.new(4, 5, 4)
    box.Transparency = 0.6
    box.Color3 = Color3.fromRGB(255, 60, 60)
    box.Parent = (gethui and gethui()) or CoreGui

    local name = Instance.new("BillboardGui")
    name.Name = "LierESP_Name"
    name.AlwaysOnTop = true
    name.Size = UDim2.new(0, 200, 0, 40)
    name.StudsOffset = Vector3.new(0, 3, 0)
    name.Adornee = nil
    name.Parent = (gethui and gethui()) or CoreGui

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = ""
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = name

    espObjects[player] = {
        box = box,
        name = name,
        nameLabel = nameLabel,
    }
end

local function DestroyESPForPlayer(player)
    local obj = espObjects[player]
    if obj then
        if obj.box then obj.box:Destroy() end
        if obj.name then obj.name:Destroy() end
        espObjects[player] = nil
    end
end

local function IsPlayerVisible(player)
    if not player.Character then return false end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    -- 判断是否被墙挡住（射线检测）
    local origin = Camera.CFrame.Position
    local target = hrp.Position
    local dir = target - origin

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { Camera, player.Character, LocalPlayer.Character }

    local result = workspace:Raycast(origin, dir, params)
    if not result then return true end
    if result.Instance:IsDescendantOf(player.Character) then return true end
    return false
end

local function UpdateESP()
    if not espEnabled then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not espObjects[player] then
                CreateESPForPlayer(player)
            end

            local obj = espObjects[player]
            if obj and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                local humanoid = player.Character:FindFirstChild("Humanoid")

                if hrp and humanoid and humanoid.Health > 0 then
                    local visible = IsPlayerVisible(player)
                    obj.box.Adornee = hrp
                    obj.box.Transparency = visible and 0.4 or 0.7
                    obj.box.Color3 = visible and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(255, 180, 60)

                    obj.name.Adornee = hrp
                    obj.nameLabel.Text = string.format(
                        "%s [%d]%s",
                        player.Name,
                        math.floor(humanoid.Health),
                        visible and "" or "  [WALL]"
                    )
                    obj.nameLabel.TextColor3 = visible and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 180, 60)
                else
                    obj.box.Adornee = nil
                    obj.name.Adornee = nil
                end
            end
        end
    end
end

local function StartESP()
    -- 给已有玩家建对象
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreateESPForPlayer(player)
        end
    end

    -- 玩家加入/离开
    local joinConn = Players.PlayerAdded:Connect(function(p)
        if espEnabled and p ~= LocalPlayer then
            CreateESPForPlayer(p)
        end
    end)
    local leaveConn = Players.PlayerRemoving:Connect(function(p)
        DestroyESPForPlayer(p)
    end)

    -- 每帧更新
    espConnection = RunService.RenderStepped:Connect(UpdateESP)

    -- 保存连接
    espObjects._joinConn = joinConn
    espObjects._leaveConn = leaveConn
end

local function StopESP()
    for player, _ in pairs(espObjects) do
        if typeof(player) == "Instance" then
            DestroyESPForPlayer(player)
        end
    end
    espObjects = {}

    if espConnection then
        espConnection:Disconnect()
        espConnection = nil
    end
end

