-- LiAel Script Monitor v2.0 (Delta 适配版)
local Players         = game:GetService("Players")
local CoreGui         = game:GetService("CoreGui")
local UserInputService= game:GetService("UserInputService")
local RunService      = game:GetService("RunService")
local lp              = Players.LocalPlayer

local capturing = false
local captured  = {}
local seen      = {}
local ui, listFrame, statusLabel
local scanConn

local CLASS_TAGS = {
    ModuleScript = true,
    LocalScript  = true,
    Script       = true,
}

local function keyOf(name, src)
    return (name or "?") .. "::" .. #src .. "::" .. (src:sub(1,128))
end

local function tryReadSource(obj)
    local ok, src = pcall(function() return obj.Source end)
    if ok and type(src) == "string" and #src > 0 then
        return src
    end
    return nil
end

local function addScript(obj, src)
    local name
    local ok, full = pcall(function() return obj:GetFullName() end)
    name = ok and full or obj.ClassName
    local k = keyOf(name, src)
    if seen[k] then return end
    seen[k] = true
    captured[#captured+1] = {
        name = name,
        source = src,
        class = obj.ClassName,
        time = os.date("%H:%M:%S"),
    }
    -- 列表刷新
    if listFrame then
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 26)
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        btn.TextColor3 = Color3.fromRGB(200, 220, 255)
        btn.Font = Enum.Font.Code
        btn.TextSize = 12
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Text = ("%s  [%s]  %dB"):format(name, obj.ClassName, #src)
        btn.LayoutOrder = #captured
        btn.Parent = listFrame
        btn.MouseButton1Click:Connect(function()
            if setclipboard then
                setclipboard(captured[#captured].source)
            end
        end)
    end
    if statusLabel then
        statusLabel.Text = "状态：监控中 | 已捕获 " .. #captured .. " 个脚本"
    end
end

-- 深度扫描（Delta 里不要扫 game 全树，太慢，扫常见容器）
local CONTAINERS = {
    "ReplicatedStorage",
    "ReplicatedFirst",
    "StarterGui",
    "StarterPlayer",
    "StarterPack",
    "Workspace",
    "Players",
    "CoreGui",
}

local function scanOnce()
    for _, sname in ipairs(CONTAINERS) do
        local ok, svc = pcall(function() return game:GetService(sname) end)
        if ok and svc then
            local ok2, list = pcall(function() return svc:GetDescendants() end)
            if ok2 and list then
                for _, obj in ipairs(list) do
                    if CLASS_TAGS[obj.ClassName] then
                        local src = tryReadSource(obj)
                        if src then addScript(obj, src) end
                    end
                end
            end
        end
    end
    -- 玩家自己的 PlayerGui（执行器注入的面板 guban 在这里）
    local ok, pg = pcall(function() return lp:FindFirstChild("PlayerGui") end)
    if ok and pg then
        for _, obj in ipairs(pg:GetDescendants()) do
            if CLASS_TAGS[obj.ClassName] then
                local src = tryReadSource(obj)
                if src then addScript(obj, src) end
            end
        end
    end
end

