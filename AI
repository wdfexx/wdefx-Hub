------------------------------------------------------------
local function refreshList()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    local shown = 0
    for i = #store.entries, 1, -1 do
        local e = store.entries[i]
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -8, 0, 22)
        btn.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
        btn.BorderSizePixel = 0
        btn.TextColor3 = Color3.fromRGB(220, 220, 230)
        btn.TextSize = 12
        btn.Font = Enum.Font.Code
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Text = string.format("[%s] %s", e.kind:sub(1, 4), e.name:sub(-60))
        btn.TextTruncate = Enum.TextTruncate.AtEnd
        btn.Parent = list
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)
        btn.MouseButton1Click:Connect(function()
            viewer.Text = string.format("-- %s (%s, %d chars)\n\n%s", e.name, e.kind, #e.source, e.source)
            status.Text = string.format("已载入：%s（%d 字符）", e.name, #e.source)
        end)
        shown = shown + 1
        if shown >= CONFIG.MaxEntries then break end
    end
    list.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 4)
    status.Text = string.format("条目 %d · loadstring=%s · require=%s · 扫描=%.1fs",
        #store.entries, tostring(hooked.loadstring), tostring(hooked.require), CONFIG.PollInterval)
end

