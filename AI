local function buildAllText()
    local lines = {}
    table.insert(lines, string.format("-- Liel Monitor 导出\n-- 共 %d 条\n\n", #store.entries))
    for i = #store.entries, 1, -1 do
        local e = store.entries[i]
        table.insert(lines, string.format("-- ===== [%s] %s (%d chars) =====\n%s\n\n",
            e.kind, e.name, #e.source, e.source))
    end
    return table.concat(lines)
end

local function copyText(text)
    if not text or #text == 0 then return false end
    local ok = false
    -- 优先 setclipboard（执行器环境）
    local fn = rawget(getfenv(), "setclipboard") or select(2, pcall(function() return setclipboard end))
    if type(fn) == "function" then
        local ok2 = pcall(fn, text)
        if ok2 then ok = true end
    end
    -- 退路：TextBox Focus + 系统快捷键
    if not ok then
        local tmp = Instance.new("TextBox")
        tmp.Size = UDim2.new(0, 1, 0, 1)
        tmp.Text = text
        tmp.Visible = true
        tmp.TextEditable = true
        tmp.Parent = gui
        tmp:CaptureFocus()
        tmp.SelectionStart = 0
        tmp.CursorPosition = #text
        task.wait(0.05)
        -- Roblox 客户端无原生剪贴板 API，靠平台快捷键，这里把内容塞给 viewer 兜底
        viewer.Text = text
        status.Text = "已载入到右侧，Ctrl+A / Ctrl+C 复制"
        tmp:Destroy()
        ok = true
    end
    return ok
end

copyAllBtn.MouseButton1Click:Connect(function()
    local all = buildAllText()
    if copyText(all) then
        status.Text = string.format("已复制 %d 条 · 共 %d 字符", #store.entries, #all)
    else
        status.Text = "复制失败：内容已放在右侧文本框"
    end
end)

