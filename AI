-- ===== 安装 Hook（只装一次） =====
local function installHooks()
    pcall(function()
        if hookfunction and loadstring then
            hookfunction(loadstring, hookedLS)
        end
    end)
    pcall(function()
        if hookfunction and require then
            hookfunction(require, hookedReq)
        end
    end)
end

