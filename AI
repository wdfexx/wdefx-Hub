        task.spawn(function()
            while sbns.s do
                if #player.Backpack:GetChildren() > 20 then
                    local hrp = character.HumanoidRootPart
                    local originalCF = hrp.CFrame
                    hrp.CFrame = workspace.NPCS["Sell Stands"]["Shop Stand"].CFrame * CFrame.new(0, 0, 3)
                    task.wait(0.5)
                    replicatedStorage.GameEvents.Sell_Item:FireServer()
                    replicatedStorage.GameEvents.Sell_Inventory:FireServer()
                    task.wait(1)
                    hrp.CFrame = originalCF
                end
                task.wait()
            end
        end)
    end
})

-- 自动种植
MainLeft:Toggle({
    Title = "自动种植",
    Desc = "自动种植背包中的种子",
    Default = false,
    Callback = function(state)
        sbns.p = state
        task.spawn(function()
            while sbns.p do
                pcall(function()
                    local seedType, tool
                    local containers = { character, player.Backpack }
                    for _, cont in ipairs(containers) do
                        for _, item in ipairs(cont:GetChildren()) do
                            if item:IsA("Tool") and item.Name:find("Seed") then
                                seedType = item.Name:match("^(.-) Seed")
                                tool = item
                                break
                            end
                        end
                        if tool then break end
                    end
                    if tool and seedType then
                        if tool.Parent == player.Backpack then
                            character.Humanoid:EquipTool(tool)
                        end
                        local pos = character.HumanoidRootPart.Position
                        replicatedStorage.GameEvents.Plant_RE:FireServer(
                            Vector3.new(math.floor(pos.X), 0.1, math.floor(pos.Z)),
                            seedType
                        )
                    end
                end)
                task.wait()
            end
        end)
    end
})

