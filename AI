        local function startAutoFollow(targetPlayer)
            Module.state.isAutoFollowing = true
            local localChar = getLocalCharacter()
            if not localChar then return end
            local localRoot = localChar:FindFirstChild("HumanoidRootPart")
            if not localRoot then return end

            disableCollision(localChar)

            local humanoid = localChar:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local animation = Instance.new("Animation")
                animation.AnimationId = "rbxassetid://189854234"
                Module.state.autoFollowAnim = humanoid:LoadAnimation(animation)
                Module.state.autoFollowAnim:Play()
            end

            local forwardOffset, backwardOffset = -2.5, -1.3

            Module.connections.autoFollow = _G.CreateHeartbeatConnection(function()
                pcall(function()
                    if not Module.state.isAutoFollowing or not localChar.Parent then
                        if Module.state.isAutoFollowing and localChar then
                            task.wait(1)
                            if Module.state.isAutoFollowing and Module.state.selectedPlayer then
                                local newTarget = getTargetPlayer(Module.state.selectedPlayer)
                                if newTarget then startAutoFollow(newTarget) end
                            end
                        else
                            Module.connections.autoFollow:Disconnect()
                            Module.connections.autoFollow = nil
                            enableCollision(localChar)
                            if Module.state.autoFollowAnim then
                                Module.state.autoFollowAnim:Stop()
                                Module.state.autoFollowAnim = nil
                            end
                        end
                        return
                    end

                    if not targetPlayer.Character then
                        showNotify("动画跟随停止", "目标玩家角色消失", 3)
                        Module.connections.autoFollow:Disconnect()
                        Module.connections.autoFollow = nil
                        enableCollision(localChar)
                        if Module.state.autoFollowAnim then
                            Module.state.autoFollowAnim:Stop()
                            Module.state.autoFollowAnim = nil
                        end
                        return
                    end

