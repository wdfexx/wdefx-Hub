------------------------------------------------------------
-- 1. 数据存储
------------------------------------------------------------
local store = {
    entries = {},   -- {name=string, source=string, time=number, kind=string}
    index   = {},   -- name -> entry（去重）
}

local function addEntry(name, source, kind)
    if type(source) ~= "string" or #source == 0 then return end
    if #source > CONFIG.MaxCharsPerEntry then
        source = source:sub(1, CONFIG.MaxCharsPerEntry) .. "\n-- [截断：超出 " .. CONFIG.MaxCharsPerEntry .. " 字符]"
    end
    local key = kind .. "|" .. tostring(name) .. "|" .. tostring(#source)
    if store.index[key] then return end
    store.index[key] = true
    table.insert(store.entries, {
        name = tostring(name),
        source = source,
        kind = kind,
        time = os.time(),
    })
    while #store.entries > CONFIG.MaxEntries do
        table.remove(store.entries, 1)
    end
end

------------------------------------------------------------
-- 2. Hook：loadstring / require
------------------------------------------------------------
local hooked = { loadstring = false, require = false }

if CONFIG.HookLoadstring then
    local ok, realLoadstring = pcall(function() return loadstring end)
    if ok and type(realLoadstring) == "function" then
        local wrapper
        wrapper = function(src, chunkname)
            if type(src) == "string" then
                addEntry(chunkname or "loadstring", src, "loadstring")
            end
            return realLoadstring(src, chunkname)
        end
        pcall(function() loadstring = wrapper end)
        hooked.loadstring = true
    end
end

if CONFIG.HookRequire then
    local ok, realRequire = pcall(function() return require end)
    if ok and type(realRequire) == "function" then
        local wrapper
        wrapper = function(target)
            pcall(function()
                if typeof(target) == "Instance" and target:IsA("ModuleScript") then
                    local ok2, src = pcall(function() return target.Source end)
                    if ok2 and type(src) == "string" then
                        addEntry(target:GetFullName(), src, "ModuleScript")
                    end
                end
            end)
            return realRequire(target)
        end
        pcall(function() require = wrapper end)
        hooked.require = true
    end
end

------------------------------------------------------------
-- 3. 扫描器：遍历游戏内所有 Script / LocalScript / ModuleScript
------------------------------------------------------------
local function scanScripts()
    local roots = { game }
    for _, svc in ipairs(game:GetChildren()) do
        table.insert(roots, svc)
    end
    local seen = {}
    for _, root in ipairs(roots) do
        pcall(function()
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                    if not seen[obj] then
                        seen[obj] = true
                        local ok, src = pcall(function() return obj.Source end)
                        if ok and type(src) == "string" and #src > 0 then
                            addEntry(obj:GetFullName(), src, obj.ClassName)
                        end
                    end
                end
            end
        end)
    end
end

