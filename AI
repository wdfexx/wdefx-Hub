local CONFIG = {
    MaxCharsPerEntry   = 2_000_000,  -- 单条源码最大字符数，防爆内存
    MaxEntries         = 200,        -- 最多保留多少条
    PollInterval       = 0.5,        -- 扫描间隔（秒）
    FontSize           = 13,
    Font               = Enum.Font.Code,
    PanelWidth         = 620,
    PanelHeight        = 420,
    HookLoadstring     = true,       -- 是否 hook 本进程 loadstring
    HookRequire        = true,       -- 是否 hook require 记录模块源码
