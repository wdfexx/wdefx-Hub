-- 7. 监控循环
------------------------------------------------------------
local monitoring = false
local lastScan = 0

toggleBtn.MouseButton1Click:Connect(function()
    monitoring = not monitoring
    if monitoring then
        toggleBtn.Text = "停止监控"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        status.Text = "监控中…"
        lastScan = 0
    else
        toggleBtn.Text = "开始监控"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 160, 90)
        status.Text = "已停止"
    end
end)

RunService.Heartbeat:Connect(function()
    if not monitoring then return end
    local now = tick()
    if now - lastScan < CONFIG.PollInterval then return end
    lastScan = now
    scanScripts()
    refreshList()
end)

refreshList()
status.Text = string.format("就绪 · loadstring hook=%s · require hook=%s",
    tostring(hooked.loadstring), tostring(hooked.require))