local seen = {}            -- 去重 key
local ui, listFrame, statusLabel, copyAllBtn

-- ===== 去重 =====
local function keyOf(name, src)
    return (name or "?") .. "::" .. #src .. "::" .. (src:sub(1, 64))
end

local function addScript(name, src, origin)
    if type(src) ~= "string" or #src == 0 then return end
    local k = keyOf(name, src)
    if seen[k] then return end
    seen[k] = true
    captured[#captured+1] = {
        name = name or "unknown",
        source = src,
        origin = origin or "runtime",
        time = os.date("%H:%M:%S")
    }
    if ui and listFrame then
        local txt = (name or "unknown") .. "  [" .. (origin or "runtime") .. "]  " .. #src .. "B"
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -8, 0, 28)
        btn.Position = UDim2.new(0, 4, 0, #listFrame:GetChildren() * 30)
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        btn.TextColor3 = Color3.fromRGB(200, 220, 255)
        btn.Font = Enum.Font.Code
        btn.TextSize = 13
        btn.Text = txt
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = listFrame
        btn.MouseButton1Click:Connect(function()
            if setclipboard then
                setclipboard(captured[#captured].source)
            end
        end)
    end
end

-- ===== 捕获方式 1：遍历常见容器 =====
local function scanContainer(root, depth)
    if depth > 6 or not root then return end
    for _, v in ipairs(root:GetDescendants()) do
        local ok, src = pcall(function() return v.Source end)
        if ok and type(src) == "string" and #src > 0 then
            addScript(v:GetFullName(), src, v.ClassName)
        end
    end
end

-- ===== 捕获方式 2：Hook loadstring =====
local origLS = loadstring
local function hookedLS(code, chunkname)
    addScript(chunkname or "loadstring", tostring(code), "loadstring")
    return origLS(code, chunkname)
end

-- ===== 捕获方式 3：Hook require =====
local origReq = require
local function hookedReq(target)
    if type(target) == "string" then
        addScript("require:"..target, target, "require-path")
    elseif typeof(target) == "Instance" and target:IsA("ModuleScript") then
        local ok, src = pcall(function() return target.Source end)
        if ok and src and #src > 0 then
            addScript(target:GetFullName(), src, "require-instance")
        end
    end
    return origReq(target)
end

