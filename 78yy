/* ==================== 渲染 ==================== */
function renderProjects(){
  const box = document.getElementById('projList');
  const q = (document.getElementById('projSearch').value || '').trim().toLowerCase();
  box.innerHTML = '';
  for(const p of projects){
    if(q && !p.name.toLowerCase().includes(q)) continue;
    const n = document.createElement('div');
    n.className = 'proj' + (p.id === currentId ? ' active' : '');
    n.innerHTML = `
      <div class="proj-icon" style="background:${p.color}">${p.name.slice(0,1).toUpperCase()}</div>
      <div class="proj-name">${p.name}</div>
      <div class="proj-cnt">${p.count}</div>
    `;
    n.onclick = () => { currentId = p.id; render(); };
    box.append(n);
  }
}

function renderHeader(){
  const p = projects.find(x => x.id === currentId);
  if(!p) return;
  const av = document.getElementById('projAvatar');
  av.textContent = p.name.slice(0,1).toUpperCase();
  av.style.background = p.color;
  document.getElementById('projName').textContent = p.name;
  document.getElementById('projMeta').textContent = `项目 ID ${p.id}a1b2c3d · HWID 绑定开启 · 默认 30 天`;
}

function renderTabs(){
  const box = document.getElementById('tabs');
  box.innerHTML = '';
  for(const [id, label] of TABS){
    const n = document.createElement('div');
    n.className = 'tab' + (currentTab === id ? ' active' : '');
    n.textContent = label;
    n.onclick = () => { currentTab = id; render(); };
    box.append(n);
  }
}

