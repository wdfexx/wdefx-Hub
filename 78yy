<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>wdfex-Hub · 新版控制台</title>
<style>
:root{
  --text:#e9ecf5;
  --muted:#8b93a9;
  --faint:#5d6580;
  --line:rgba(255,255,255,0.07);
  --accent:#6d8bff;
  --accent2:#a06bff;
  --ok:#34d399;
  --warn:#fbbf24;
  --bad:#f87171;
  --glass:rgba(19,22,32,0.55);
  --radius:18px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  margin:0;
  font:14px/1.55 system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;
  color:var(--text);
  background:#06080e;
  overflow-x:hidden;
}

/* ===== 背景层 ===== */
#bgImg{
  position:fixed;inset:-6%;z-index:-2;
  background-size:cover;background-position:center;background-repeat:no-repeat;
  transition:filter .35s ease, transform .35s ease, background-image .35s ease;
  will-change:filter,transform;
}
#bgMask{
  position:fixed;inset:0;z-index:-1;pointer-events:none;
  background:rgba(5,7,12,0.45);
  transition:background .3s ease;
}

/* ===== 通用玻璃 ===== */
.glass{
  background:var(--glass);
  backdrop-filter:blur(22px) saturate(150%);
  -webkit-backdrop-filter:blur(22px) saturate(150%);
  border:1px solid var(--line);
  box-shadow:0 24px 60px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.06);
}

/* ===== 布局 ===== */
#app{
  display:grid;
  grid-template-columns:272px 1fr;
  gap:16px;
  padding:16px;
  min-height:100vh;
  max-width:1640px;
  margin:0 auto;
}

/* ===== 侧边栏 ===== */
.sidebar{
  position:sticky;top:16px;
  height:calc(100vh - 32px);
  display:flex;flex-direction:column;gap:14px;
  padding:18px;border-radius:var(--radius);
}
.brand{display:flex;align-items:center;gap:11px}
.logo{
  width:38px;height:38px;border-radius:11px;flex:0 0 auto;
  display:grid;place-items:center;
  font-weight:800;font-size:17px;color:#fff;letter-spacing:-.5px;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  box-shadow:0 8px 22px rgba(109,139,255,0.45);
}
.brand-name{font-weight:800;font-size:15px;letter-spacing:.2px}
.brand-sub{font-size:11px;color:var(--faint);margin-top:1px}

.search-box{
  display:flex;align-items:center;gap:8px;
  padding:0 12px;border-radius:11px;
  background:rgba(0,0,0,0.28);border:1px solid rgba(255,255,255,0.08);
}
.search-box span{font-size:12px;opacity:.6}
.search-box input{border:0;background:transparent;padding:10px 0;box-shadow:none!important}
.search-box input:focus{background:transparent}

.proj-list{
  display:flex;flex-direction:column;gap:4px;
  overflow-y:auto;flex:1;margin:0 -4px;padding:0 4px;
  scrollbar-width:thin;
}
.proj{
  display:flex;align-items:center;gap:10px;
  padding:9px 11px;border-radius:12px;
  cursor:pointer;border:1px solid transparent;
  transition:.18s ease;color:#c4cad9;user-select:none;
}
.proj:hover{background:rgba(255,255,255,0.05)}
.proj.active{
  background:linear-gradient(90deg, rgba(109,139,255,0.2), rgba(160,107,255,0.1));
  border-color:rgba(109,139,255,0.32);
  color:#fff;
  box-shadow:0 6px 20px rgba(0,0,0,0.25);
}
.proj-icon{
  width:26px;height:26px;border-radius:8px;flex:0 0 auto;
  display:grid;place-items:center;font-size:12px;font-weight:800;color:#fff;
}
.proj-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px}
.proj-cnt{
  font-size:11px;font-weight:700;color:var(--muted);
  background:rgba(255,255,255,0.08);padding:1px 8px;border-radius:99px;
}
.side-footer{display:flex;gap:8px}

/* ===== 主区域 ===== */
.main{display:flex;flex-direction:column;gap:14px;min-width:0}

.topbar{
  display:flex;align-items:center;justify-content:space-between;gap:14px;
  padding:16px 18px;border-radius:var(--radius);flex-wrap:wrap;
}
.proj-head{display:flex;align-items:center;gap:13px;min-width:0}
.proj-avatar{
  width:46px;height:46px;border-radius:13px;flex:0 0 auto;
  display:grid;place-items:center;font-size:19px;font-weight:800;color:#fff;
  box-shadow:0 10px 24px rgba(0,0,0,0.35);
}
.proj-titles h1{margin:0 0 2px;font-size:18px;font-weight:700;letter-spacing:.2px}
.meta{color:var(--muted);font-size:12.5px}
.top-actions{display:flex;gap:8px;flex-wrap:wrap}
.dot-badge{
  background:var(--bad);color:#fff;font-size:10px;font-weight:800;
  padding:0 5px;border-radius:99px;margin-left:5px;
  box-shadow:0 0 10px rgba(248,113,113,0.6);
}

/* ===== Tabs ===== */
.tabs{
  display:flex;gap:4px;padding:5px;border-radius:14px;
  background:rgba(15,18,26,0.55);border:1px solid var(--line);
  backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  overflow-x:auto;scrollbar-width:none;
}
.tabs::-webkit-scrollbar{display:none}
.tab{
  padding:8px 16px;border-radius:10px;font-size:13px;font-weight:600;
  color:var(--muted);cursor:pointer;white-space:nowrap;transition:.18s;
  border:1px solid transparent;user-select:none;
}
.tab:hover{color:#fff;background:rgba(255,255,255,0.05)}
.tab.active{
  color:#fff;
  background:linear-gradient(135deg,rgba(109,139,255,0.28),rgba(160,107,255,0.18));
  border-color:rgba(109,139,255,0.35);
  box-shadow:0 4px 14px rgba(0,0,0,0.28);
}

/* ===== 统计卡 ===== */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat{
  position:relative;overflow:hidden;
  padding:15px 16px;border-radius:15px;
  background:var(--glass);
  backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  border:1px solid var(--line);
  transition:.2s;
}
.stat:hover{transform:translateY(-2px);border-color:rgba(255,255,255,0.14)}
.stat::after{
  content:'';position:absolute;right:-30px;top:-34px;width:96px;height:96px;border-radius:50%;
  background:radial-gradient(circle, var(--c,#6d8bff) 0%, transparent 70%);
  opacity:.32;pointer-events:none;
}
.stat b{display:block;font-size:24px;line-height:1.2;font-weight:800;letter-spacing:-.5px}
.stat span{color:var(--muted);font-size:12px}

/* ===== 工具栏 ===== */
.toolbar{
  display:flex;gap:10px;align-items:center;flex-wrap:wrap;
  padding:12px;border-radius:14px;
}
.toolbar .search{width:260px;flex:0 0 auto}

/* ===== 表格 ===== */
.panel{border-radius:var(--radius);overflow:hidden}
.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;min-width:max-content}
th{
  padding:12px 14px;text-align:left;font-weight:700;font-size:11px;
  color:var(--faint);text-transform:uppercase;letter-spacing:.6px;
  background:rgba(0,0,0,0.22);
  position:sticky;top:0;backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);white-space:nowrap;
}
td{padding:13px 14px;border-bottom:1px solid rgba(255,255,255,0.04);font-size:13px;white-space:nowrap}
tbody tr{transition:background .15s}
tbody tr:hover{background:rgba(255,255,255,0.035)}
tbody tr:last-child td{border-bottom:0}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12.5px}
.row-actions{display:flex;gap:6px;flex-wrap:wrap}

/* ===== 徽章 ===== */
.badge{
  display:inline-flex;align-items:center;gap:5px;
  padding:3px 9px;border-radius:99px;font-size:11px;font-weight:700;
  border:1px solid;
}
.badge::before{
  content:'';width:5px;height:5px;border-radius:50%;
  background:currentColor;box-shadow:0 0 8px currentColor;
}
.b-unused{color:#8fa8ff;background:rgba(60,80,160,0.18);border-color:rgba(100,130,220,0.32)}
.b-bound{color:#34d399;background:rgba(52,211,153,0.13);border-color:rgba(52,211,153,0.32)}
.b-banned{color:#f87171;background:rgba(248,113,113,0.13);border-color:rgba(248,113,113,0.32)}
.b-expired{color:#fbbf24;background:rgba(251,191,36,0.13);border-color:rgba(251,191,36,0.32)}

/* ===== 按钮 ===== */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:9px 15px;border-radius:11px;
  font:inherit;font-weight:600;font-size:13px;
  color:var(--text);cursor:pointer;
  background:rgba(255,255,255,0.06);
  border:1px solid rgba(255,255,255,0.1);
  transition:.18s cubic-bezier(.2,.8,.3,1);
  white-space:nowrap;
}
.btn:hover{background:rgba(255,255,255,0.12);transform:translateY(-1px)}
.btn:active{transform:translateY(0) scale(.98)}
.btn.primary{
  background:linear-gradient(135deg,#5b7cff,#9b5cff);
  border-color:rgba(255,255,255,0.2);
  box-shadow:0 8px 24px rgba(109,139,255,0.35);
  color:#fff;
}
.btn.primary:hover{box-shadow:0 12px 32px rgba(109,139,255,0.55)}
.btn.ghost{background:rgba(255,255,255,0.03);border-color:rgba(255,255,255,0.08)}
.btn.ghost:hover{background:rgba(255,255,255,0.1)}
.btn.danger{background:rgba(248,113,113,0.14);border-color:rgba(248,113,113,0.3);color:#ffb4b4}
.btn.danger:hover{background:rgba(248,113,113,0.26);color:#fff}
.btn.sm{padding:6px 11px;font-size:12px;border-radius:9px}

/* ===== 输入 ===== */
input,select,textarea{
  font:inherit;color:var(--text);width:100%;
  background:rgba(0,0,0,0.28);
  border:1px solid rgba(255,255,255,0.09);
  border-radius:11px;padding:10px 13px;outline:none;
  transition:.18s;
}
input:focus,select:focus,textarea:focus{
  border-color:rgba(109,139,255,0.6);
  box-shadow:0 0 0 3px rgba(109,139,255,0.15);
  background:rgba(0,0,0,0.42);
}
input[type=checkbox]{width:auto;accent-color:#6d8bff;cursor:pointer;transform:scale(1.15)}
input[type=range]{padding:0;background:transparent;border:0;accent-color:#6d8bff}

/* ===== 占位页 ===== */
.placeholder{
  padding:56px 24px;text-align:center;border-radius:var(--radius);
}
.ph-icon{font-size:38px;margin-bottom:12px;filter:drop-shadow(0 6px 18px rgba(109,139,255,0.4))}
.ph-title{font-size:16px;font-weight:700;margin-bottom:6px}
.ph-desc{color:var(--muted);font-size:13px;max-width:420px;margin:0 auto;line-height:1.7}

/* ===== 弹窗 ===== */
.modal{
  position:fixed;inset:0;z-index:100;padding:20px;
  display:none;align-items:center;justify-content:center;
  background:rgba(0,0,0,0.6);
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
}
.modal.on{display:flex}
.modal-card{
  width:100%;max-width:460px;max-height:88vh;overflow:auto;
  padding:24px;border-radius:20px;
}
.modal-card h3{margin:0 0 4px;font-size:17px}
.modal-card .sub{color:var(--muted);font-size:12.5px;margin-bottom:18px}
.modal-card label{display:block;color:var(--muted);font-size:12px;font-weight:600;margin:16px 0 7px}
.modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:22px}

/* 背景预设缩略图 */
.bg-presets{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.bg-swatch{
  aspect-ratio:16/10;border-radius:11px;cursor:pointer;
  border:2px solid transparent;background-size:cover;background-position:center;
  transition:.18s;position:relative;overflow:hidden;
}
.bg-swatch:hover{transform:scale(1.04)}
.bg-swatch.active{border-color:var(--accent);box-shadow:0 0 0 3px rgba(109,139,255,0.25)}
.bg-swatch span{
  position:absolute;left:0;right:0;bottom:0;
  padding:4px;font-size:10px;font-weight:600;text-align:center;
  background:rgba(0,0,0,0.45);color:#fff;backdrop-filter:blur(4px);
}

/* 滚动条 */
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.12);border-radius:99px}
::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,0.22)}
::-webkit-scrollbar-track{background:transparent}

/* ===== 响应式 ===== */
@media (max-width:980px){
  #app{grid-template-columns:1fr;padding:10px;gap:10px}
  .sidebar{position:static;height:auto;padding:14px;gap:10px}
  .proj-list{flex-direction:row;overflow-x:auto;overflow-y:hidden;flex:0 0 auto;padding-bottom:4px}
  .proj{flex:0 0 auto}
  .proj-name{max-width:120px}
  .side-footer{display:none}
  .topbar{padding:14px}
  .stats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .toolbar .search{width:100%}
  .proj-titles h1{font-size:16px}
}
@media (max-width:520px){
  .top-actions{width:100%}
  .top-actions .btn{flex:1}
  .stats{grid-template-columns:1fr 1fr;gap:8px}
  .stat{padding:12px}
  .stat b{font-size:20px}
}
</style>
</head>
<body>

<div id="bgImg"></div>
<div id="bgMask"></div>

<div id="app">
  <aside class="sidebar glass">
    <div class="brand">
      <div class="logo">W</div>
      <div>
        <div class="brand-name">wdfex-Hub</div>
        <div class="brand-sub">控制台 · 新 UI 演示</div>
      </div>
    </div>

    <button class="btn primary" style="width:100%" id="newProjBtn">＋ 新建项目</button>

    <div class="search-box">
      <span>🔍</span>
      <input id="projSearch" placeholder="搜索项目" autocomplete="off">
    </div>

    <div class="proj-list" id="projList"></div>

    <div class="side-footer">
      <button class="btn ghost" id="bgBtn" style="flex:1">🎨 背景设置</button>
      <button class="btn ghost">退出</button>
    </div>
  </aside>

  <main class="main">
    <header class="topbar glass">
      <div class="proj-head">
        <div class="proj-avatar" id="projAvatar">B</div>
        <div class="proj-titles">
          <h1 id="projName">Blox Fruits 脚本</h1>
          <div class="meta" id="projMeta">项目 ID a1b2c3d4 · HWID 绑定开启 · 默认 30 天</div>
        </div>
      </div>
      <div class="top-actions">
        <button class="btn ghost">📬 消息<span class="dot-badge">2</span></button>
        <button class="btn ghost">⚙️ 项目设置</button>
      </div>
    </header>

    <nav class="tabs" id="tabs"></nav>

    <section id="view"></section>
  </main>
</div>

<!-- 背景设置弹窗 -->
<div class="modal" id="bgModal">
  <div class="modal-card glass">
    <h3>🎨 背景设置</h3>
    <div class="sub">选一个预设，或上传你自己的图片作为背景</div>

    <label style="margin-top:0">预设渐变</label>
    <div class="bg-presets" id="bgPresets"></div>

    <label>上传本地图片</label>
    <input type="file" id="bgFile" accept="image/*">

    <label>或者填图片链接</label>
    <input id="bgUrl" placeholder="https://example.com/bg.jpg" autocomplete="off">

    <label>模糊度 <span id="blurVal" style="color:var(--accent)">14</span> px</label>
    <input type="range" id="bgBlur" min="0" max="40" value="14">

    <label>暗度 <span id="darkVal" style="color:var(--accent)">45</span> %</label>
    <input type="range" id="bgDark" min="0" max="90" value="45">

    <div class="modal-actions">
      <button class="btn ghost" id="bgReset">恢复默认</button>
      <button class="btn primary" id="bgClose">完成</button>
    </div>
  </div>
</div>

<script>
/* ==================== 背景系统 ==================== */
const BG_KEY = 'wdfex_bg_v1';
const PRESETS = [
  { id:'aurora', name:'极光蓝紫', css:'radial-gradient(1000px 600px at 12% -10%, #1b3a8f 0%, transparent 60%), radial-gradient(900px 500px at 90% 0%, #3b1b6b 0%, transparent 55%), linear-gradient(160deg, #0a0d16, #0e1220)' },
  { id:'sunset', name:'日落橙紫', css:'radial-gradient(900px 600px at 20% 0%, #5a1f3f 0%, transparent 60%), radial-gradient(800px 600px at 85% 10%, #7a3b12 0%, transparent 55%), linear-gradient(160deg, #0d0910, #160d16)' },
  { id:'forest', name:'深林绿', css:'radial-gradient(900px 600px at 15% 0%, #0f4a3a 0%, transparent 60%), radial-gradient(700px 500px at 90% 20%, #1a3a2a 0%, transparent 55%), linear-gradient(160deg, #060d0a, #0a1410)' },
  { id:'ocean',  name:'深海青', css:'radial-gradient(900px 600px at 20% -10%, #0c3a5a 0%, transparent 60%), radial-gradient(700px 500px at 95% 10%, #123a4a 0%, transparent 55%), linear-gradient(160deg, #050a10, #071018)' },
  { id:'mono',   name:'纯黑', css:'linear-gradient(160deg, #050608, #0b0d12)' },
  { id:'candy',  name:'粉紫霞光', css:'radial-gradient(900px 600px at 15% 0%, #4a1f5a 0%, transparent 60%), radial-gradient(800px 500px at 90% 10%, #5a1f3a 0%, transparent 55%), linear-gradient(160deg, #0b0710, #120a16)' }
];

let bgCfg = loadBg();

function loadBg(){
  try{
    const raw = localStorage.getItem(BG_KEY);
    if(raw) return Object.assign({ type:'preset', preset:'aurora', src:'', blur:14, dark:45 }, JSON.parse(raw));
  }catch(e){}
  return { type:'preset', preset:'aurora', src:'', blur:14, dark:45 };
}
function saveBg(){
  try{ localStorage.setItem(BG_KEY, JSON.stringify(bgCfg)); }
  catch(e){ alert('图片太大，浏览器存不下，建议改用图片链接或更小的图片'); }
}
function applyBg(){
  const layer = document.getElementById('bgImg');
  if(bgCfg.type === 'image' && bgCfg.src){
    layer.style.backgroundImage = `url("${bgCfg.src}")`;
  }else{
    const p = PRESETS.find(x => x.id === bgCfg.preset) || PRESETS[0];
    layer.style.backgroundImage = p.css;
  }
  layer.style.filter = `blur(${bgCfg.blur}px)`;
  layer.style.transform = `scale(${1 + bgCfg.blur / 60})`;
  document.getElementById('bgMask').style.background = `rgba(5,7,12,${bgCfg.dark / 100})`;
}

function compressImage(file, cb){
  const fr = new FileReader();
  fr.onload = () => {
    const img = new Image();
    img.onload = () => {
      const maxW = 1920;
      let w = img.width, h = img.height;
      const s = Math.min(1, maxW / Math.max(w, h));
      w = Math.round(w * s); h = Math.round(h * s);
      const cv = document.createElement('canvas');
      cv.width = w; cv.height = h;
      cv.getContext('2d').drawImage(img, 0, 0, w, h);
      cb(cv.toDataURL('image/jpeg', 0.82));
    };
    img.onerror = () => alert('图片格式不支持');
    img.src = fr.result;
  };
  fr.onerror = () => alert('读取图片失败');
  fr.readAsDataURL(file);
}

/* 背景弹窗逻辑 */
const bgModal = document.getElementById('bgModal');
const bgPresetsEl = document.getElementById('bgPresets');
const bgFile = document.getElementById('bgFile');
const bgUrl = document.getElementById('bgUrl');
const bgBlur = document.getElementById('bgBlur');
const bgDark = document.getElementById('bgDark');
const blurVal = document.getElementById('blurVal');
const darkVal = document.getElementById('darkVal');

function renderPresets(){
  bgPresetsEl.innerHTML = '';
  for(const p of PRESETS){
    const n = document.createElement('div');
    n.className = 'bg-swatch' + (bgCfg.type === 'preset' && bgCfg.preset === p.id ? ' active' : '');
    n.style.backgroundImage = p.css;
    n.innerHTML = `<span>${p.name}</span>`;
    n.onclick = () => {
      bgCfg.type = 'preset';
      bgCfg.preset = p.id;
      bgCfg.src = '';
      bgUrl.value = '';
      applyBg(); saveBg(); renderPresets();
    };
    bgPresetsEl.append(n);
  }
}

function openBgModal(){
  bgBlur.value = bgCfg.blur;
  bgDark.value = bgCfg.dark;
  blurVal.textContent = bgCfg.blur;
  darkVal.textContent = bgCfg.dark;
  bgUrl.value = bgCfg.type === 'image' && bgCfg.src && /^https?:/i.test(bgCfg.src) ? bgCfg.src : '';
  renderPresets();
  bgModal.classList.add('on');
}

document.getElementById('bgBtn').onclick = openBgModal;
document.getElementById('bgClose').onclick = () => bgModal.classList.remove('on');
bgModal.addEventListener('click', (e) => { if(e.target === bgModal) bgModal.classList.remove('on'); });

bgBlur.addEventListener('input', () => {
  bgCfg.blur = Number(bgBlur.value);
  blurVal.textContent = bgCfg.blur;
  applyBg(); saveBg();
});
bgDark.addEventListener('input', () => {
  bgCfg.dark = Number(bgDark.value);
  darkVal.textContent = bgCfg.dark;
  applyBg(); saveBg();
});
bgFile.addEventListener('change', () => {
  const f = bgFile.files && bgFile.files[0];
  if(!f) return;
  compressImage(f, (dataUrl) => {
    bgCfg.type = 'image';
    bgCfg.src = dataUrl;
    applyBg(); saveBg(); renderPresets();
    toast('背景已更新');
  });
  bgFile.value = '';
});
bgUrl.addEventListener('keydown', (e) => {
  if(e.key !== 'Enter') return;
  const v = bgUrl.value.trim();
  if(!v) return;
  bgCfg.type = 'image';
  bgCfg.src = v;
  applyBg(); saveBg(); renderPresets();
  toast('背景已更新');
});
document.getElementById('bgReset').onclick = () => {
  bgCfg = { type:'preset', preset:'aurora', src:'', blur:14, dark:45 };
  bgBlur.value = 14; bgDark.value = 45;
  blurVal.textContent = 14; darkVal.textContent = 45;
  bgUrl.value = '';
  applyBg(); saveBg(); renderPresets();
  toast('已恢复默认');
};

/* ==================== 简易 toast ==================== */
let toastTimer;
function toast(msg){
  let t = document.getElementById('toast');
  if(!t){
    t = document.createElement('div');
    t.id = 'toast';
    t.style.cssText = 'position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(10px);z-index:999;padding:11px 18px;border-radius:12px;background:rgba(24,28,40,0.9);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.12);box-shadow:0 16px 40px rgba(0,0,0,0.5);font-size:13px;font-weight:600;color:#fff;opacity:0;transition:.25s;pointer-events:none';
    document.body.append(t);
  }
  t.textContent = msg;
  requestAnimationFrame(() => { t.style.opacity = '1'; t.style.transform = 'translateX(-50%) translateY(0)'; });
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translateX(-50%) translateY(10px)'; }, 1900);
}

