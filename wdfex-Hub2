    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if method == "InvokeServer" and args[1] == "getNavigationPoint" then
            local result = oldNamecall(self, ...)
            if navAutoTeleport then
                local x, z
                if typeof(result) == "Vector3" then
                    x, z = result.X, result.Z
                elseif type(result) == "table" then
                    x = result[1] or result.X or result.x
                    z = result[2] or result.Z or result.z
                end
                if type(x) == "number" and type(z) == "number" then
                    task.spawn(function()
                        task.wait(0.15)
                        local y = getGroundY(x, z)
                        local char = player.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        if root then root.CFrame = CFrame.new(x, y, z) end
                    end)
                end
            end
            return result
        end
        if method == "FireServer" then
            if godOn and type(args[1]) == "string" and args[1] == "takeDamage" then return end
        end
        return oldNamecall(self, ...)
    end)
